@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="lh-section lh-terms-hero">
    <div class="lh-container">
        <div class="lh-terms-hero-card">
            <span class="lh-terms-kicker">Laundry Hub Davao City</span>
            <h1 class="lh-terms-title">Privacy Policy</h1>
            <p class="lh-terms-intro">How we collect, use, and protect your information when you book pickups, track orders, and use the customer portal.</p>
            <div class="lh-terms-meta" aria-label="Privacy document details">
                <span class="lh-terms-meta-item"><span>Effective date</span><strong>September 25, 2026</strong></span>
            </div>
        </div>
    </div>
</section>

<section class="lh-section lh-terms-body-section">
    <div class="lh-container lh-terms-layout">
        <aside class="lh-terms-index" aria-label="Privacy sections">
            <div class="lh-terms-index-title">On this page</div>
            <ol>
                <li><a href="#collect">Information we collect</a></li>
                <li><a href="#use">How we use it</a></li>
                <li><a href="#sharing">Sharing and disclosure</a></li>
                <li><a href="#security">Security and retention</a></li>
                <li><a href="#cookies">Cookies</a></li>
                <li><a href="#rights">Your rights and contact</a></li>
            </ol>
        </aside>

        <article class="lh-terms-content">
            <div class="lh-terms-callout">
                <strong>Summary:</strong> We collect only the account, contact, address, order, and payment-reference details needed to run the laundry service. Full card numbers go to the payment provider — never to us.
            </div>

            <section class="lh-terms-section" id="collect">
                <h2>1. Information we collect</h2>
                <p>To provide pickup, laundry, payment, and delivery services, we collect the account, contact, address, delivery, order, and payment-reference information needed to process a booking: your name, email address, mobile number, district, pickup and delivery addresses, order details and special instructions, and payment confirmations or references.</p>
                <p>Payment details are submitted directly to our payment provider. Laundry Hub does not need to receive or store your full card number. Riders may record pickup and delivery photographs as proof of service, and the portal records order notifications and status history tied to your account.</p>
            </section>

            <section class="lh-terms-section" id="use">
                <h2>2. How we use it</h2>
                <p>We use your information to schedule pickups, assign riders, verify weight, process payments, deliver orders, send order and payment notifications by SMS, email, and in-app messages, and to keep the audit and loyalty records described in our Terms &amp; Conditions.</p>
            </section>

            <section class="lh-terms-section" id="sharing">
                <h2>3. Sharing and disclosure</h2>
                <p>We share order information with the riders assigned to your pickup or delivery, with our payment provider to confirm transactions, and with authorities only when required by applicable law. We do not sell your personal information.</p>
            </section>

            <section class="lh-terms-section" id="security">
                <h2>4. Security and retention</h2>
                <p>Accounts are protected by password sign-in. Keep your credentials private and notify support if you believe your account has been accessed without permission. Order, notification, and audit records are retained as needed for operations, disputes, and legal compliance, consistent with our Terms &amp; Conditions.</p>
            </section>

            <section class="lh-terms-section" id="cookies">
                <h2>5. Cookies</h2>
                <p>We use strictly necessary cookies to keep you signed in, remember your session, and protect forms against forgery. We do not use advertising or cross-site tracking cookies. You can clear cookies in your browser settings, but signing in will require them.</p>
            </section>

            <section class="lh-terms-section" id="rights">
                <h2>6. Your rights and contact</h2>
                <p>You may review and update your account details in the portal, and you may ask us to correct inaccurate information. Questions, corrections, or requests about this policy may be sent to <a href="mailto:support@laundryhub.ph">support@laundryhub.ph</a>. Please include your account email and, where relevant, your order number.</p>
            </section>
        </article>
    </div>
</section>

<section class="lh-section lh-terms-cta-section">
    <div class="lh-container">
        <div class="lh-terms-cta-card">
            <div>
                <h2>Questions about your data?</h2>
                <p>Contact support and include your account email so we can locate your records quickly.</p>
            </div>
            <div class="lh-terms-cta-actions">
                <a href="mailto:support@laundryhub.ph" class="lh-btn lh-btn-primary">Contact Support</a>
                <a href="/" class="lh-btn lh-btn-outline">Back to Home</a>
            </div>
        </div>
    </div>
</section>
