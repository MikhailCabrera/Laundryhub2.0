@{
    ViewData["Title"] = "Davao City Pickup & Delivery Laundry Service";
}

<!-- HERO SECTION (Full-Width Background, Centered Content Container) -->
<section class="lh-section lh-hero-section" id="hero">
    <div class="lh-container lh-hero-container">
        <div class="lh-hero-content">
            <div class="lh-hero-badge">
                <span class="lh-badge-pulse"></span>
                <span class="lh-badge-text">Davao City’s #1 Doorstep Laundry Service</span>
            </div>

            <h1 class="lh-hero-title">
                Fresh, Spotless Laundry Delivered Across <span class="lh-title-highlight">Davao City</span>
            </h1>

            <p class="lh-hero-description">
                Say goodbye to laundry day chores. We pick up your clothes, wash, dry, iron, and deliver them fresh to your home or office. Transparent per-kilo pricing with no hidden charges.
            </p>

            <div class="lh-hero-price-pill">
                <div class="lh-price-tag-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                </div>
                <span>Wash & Fold starts at <strong>₱45 / kg</strong></span>
                <span class="lh-price-separator">•</span>
                <span class="lh-free-perk">FREE pickup & delivery on 5kg+</span>
            </div>

            <div class="lh-hero-actions">
                <button type="button" class="lh-btn lh-btn-primary lh-btn-lg" data-trigger-signup>
                    <span>Schedule a Pickup</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
                <a href="#pricing" class="lh-btn lh-btn-outline lh-btn-lg">
                    <span>Calculate Rates</span>
                </a>
            </div>

            <div class="lh-hero-trust-list">
                <div class="lh-trust-item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Min. order 3kg</span>
                </div>
                <div class="lh-trust-item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Mon–Sat 8AM–7PM</span>
                </div>
                <div class="lh-trust-item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Weighed at doorstep</span>
                </div>
            </div>
        </div>

        <!-- Custom Hero Visual Illustration -->
        <div class="lh-hero-visual" aria-hidden="true">
            <div class="lh-hero-card-scene">
                <!-- Floating Service Pill 1 -->
                <div class="lh-floating-card lh-float-card-1">
                    <div class="lh-float-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div>
                        <div class="lh-float-title">Davao Guaranteed</div>
                        <div class="lh-float-desc">100% Gentle Fabric Care</div>
                    </div>
                </div>

                <!-- Main Graphic Artwork: SVG Scene of Clean Laundry & Delivery -->
                <div class="lh-scene-illustration">
                    <svg viewBox="0 0 460 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="lh-hero-svg">
                        <defs>
                            <linearGradient id="blueGlow" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#EBF3FE"/>
                                <stop offset="100%" stop-color="#D4E5F9"/>
                            </linearGradient>
                            <linearGradient id="washGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#2563EB"/>
                                <stop offset="100%" stop-color="#1D4ED8"/>
                            </linearGradient>
                            <linearGradient id="basketGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#FFFFFF"/>
                                <stop offset="100%" stop-color="#F0F6FF"/>
                            </linearGradient>
                        </defs>
                        
                        <!-- Soft Backdrop Circle -->
                        <circle cx="230" cy="190" r="170" fill="url(#blueGlow)" opacity="0.8"/>
                        <circle cx="230" cy="190" r="140" stroke="#BFDBFE" stroke-width="2" stroke-dasharray="8 8" opacity="0.6"/>

                        <!-- Pedestal Base -->
                        <ellipse cx="230" cy="315" rx="160" ry="24" fill="#DBEAFE"/>
                        <ellipse cx="230" cy="310" rx="140" ry="18" fill="#EFF6FF"/>

                        <!-- Laundry Basket Container -->
