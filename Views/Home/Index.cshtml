                        <!-- Basket Weave Lines -->
                        <line x1="165" y1="240" x2="295" y2="240" stroke="#BFDBFE" stroke-width="3" stroke-linecap="round"/>
                        <line x1="172" y1="270" x2="288" y2="270" stroke="#BFDBFE" stroke-width="3" stroke-linecap="round"/>
                        <line x1="200" y1="210" x2="208" y2="305" stroke="#BFDBFE" stroke-width="3" stroke-linecap="round"/>
                        <line x1="230" y1="210" x2="230" y2="308" stroke="#BFDBFE" stroke-width="3" stroke-linecap="round"/>
                        <line x1="260" y1="210" x2="252" y2="305" stroke="#BFDBFE" stroke-width="3" stroke-linecap="round"/>

                        <!-- Folded Towels & Fresh Clean Clothes Stack -->
                        <!-- Royal Blue Towel -->
                        <rect x="150" y="180" width="160" height="34" rx="14" fill="#1E60D5"/>
                        <rect x="155" y="184" width="28" height="26" rx="10" fill="#3B82F6"/>
                        
                        <!-- Sky Blue Folded Linen -->
                        <rect x="160" y="152" width="140" height="32" rx="13" fill="#60A5FA"/>
                        <rect x="165" y="156" width="24" height="24" rx="9" fill="#93C5FD"/>

                        <!-- Pure Crisp White Folded Shirt Stack -->
                        <rect x="170" y="125" width="120" height="30" rx="12" fill="#FFFFFF" stroke="#D4E5F9" stroke-width="3"/>
                        <rect x="175" y="129" width="20" height="22" rx="8" fill="#F0F6FF"/>

                        <!-- Sparkle 1 -->
                        <path d="M125 140 Q135 140 135 130 Q135 140 145 140 Q135 140 135 150 Q135 140 125 140 Z" fill="#2563EB"/>
                        <!-- Sparkle 2 -->
                        <path d="M315 110 Q325 110 325 100 Q325 110 335 110 Q325 110 325 120 Q325 110 315 110 Z" fill="#3B82F6"/>
                        <!-- Sparkle 3 -->
                        <path d="M335 220 Q342 220 342 213 Q342 220 349 220 Q342 220 342 227 Q342 220 335 220 Z" fill="#60A5FA"/>

                        <!-- Floating Clean Soap Bubbles -->
                        <circle cx="110" cy="190" r="16" fill="#EFF6FF" stroke="#93C5FD" stroke-width="2.5" opacity="0.9"/>
                        <circle cx="106" cy="186" r="5" fill="#FFFFFF" opacity="0.8"/>
                        
                        <circle cx="340" cy="165" r="12" fill="#EFF6FF" stroke="#93C5FD" stroke-width="2" opacity="0.9"/>
                        <circle cx="337" cy="162" r="3.5" fill="#FFFFFF" opacity="0.8"/>

                        <circle cx="280" cy="85" r="9" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="2" opacity="0.8"/>
                        
                        <!-- Davao City Delivery Scooter Icon Silhouette Badge -->
                        <g transform="translate(60, 240)">
                            <rect x="0" y="0" width="105" height="52" rx="12" fill="#FFFFFF" stroke="#D4E5F9" stroke-width="2"/>
                            <!-- Mini Scooter -->
                            <circle cx="22" cy="34" r="8" stroke="#1E60D5" stroke-width="2.5" fill="#EFF6FF"/>
                            <circle cx="58" cy="34" r="8" stroke="#1E60D5" stroke-width="2.5" fill="#EFF6FF"/>
                            <path d="M22 34 H34 L44 20 H52 M34 34 L38 24 H48" stroke="#1E60D5" stroke-width="2.5" stroke-linecap="round"/>
                            <rect x="18" y="16" width="14" height="12" rx="3" fill="#1E60D5"/>
                            <text x="68" y="27" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="11" fill="#0B1E36">DVO</text>
                            <text x="68" y="38" font-family="'Inter', sans-serif" font-weight="600" font-size="9" fill="#1E60D5">EXPRESS</text>
                        </g>
                    </svg>
                </div>

                <!-- Floating Service Pill 2 -->
                <div class="lh-floating-card lh-float-card-2">
                    <div class="lh-float-icon-check">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <div>
                        <div class="lh-float-title">Pickup & Delivery</div>
                        <div class="lh-float-desc">Free for 5kg and above</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

