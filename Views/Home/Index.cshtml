<!-- HOW IT WORKS (Full-Width, Centered Inner Content) -->
<section class="lh-section lh-how-section" id="how-it-works">
    <div class="lh-container">
        <div class="lh-section-header">
            <span class="lh-section-subtitle">Effortless Laundry</span>
            <h2 class="lh-section-title">How Laundry Hub Works</h2>
            <p class="lh-section-desc">Get your clothes washed, folded, and delivered back to you in three simple steps.</p>
        </div>

        <div class="lh-steps-grid">
            <!-- Step 1 -->
            <div class="lh-step-card">
                <div class="lh-step-number-badge">01</div>
                <div class="lh-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <h3 class="lh-step-title">Schedule Pickup</h3>
                <p class="lh-step-text">
                    Book online or send us a message. Pick a convenient date and time window (Mon–Sat 8AM–7PM). Our rider arrives with an accurate digital scale at your Davao address.
                </p>
                <div class="lh-step-detail-tag">Weigh & tag at your doorstep</div>
            </div>

            <!-- Step 2 -->
            <div class="lh-step-card">
                <div class="lh-step-number-badge">02</div>
                <div class="lh-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 3"></path>
                        <path d="M7 12a5 5 0 0 1 10 0"></path>
                    </svg>
                </div>
                <h3 class="lh-step-title">We Wash & Care</h3>
                <p class="lh-step-text">
                    Your garments are sorted by fabric and color, treated for stains, and washed in state-of-the-art commercial washers using premium hypoallergenic detergents and downy softeners.
                </p>
                <div class="lh-step-detail-tag">Folded neatly or pressed on hangers</div>
            </div>

            <!-- Step 3 -->
            <div class="lh-step-card">
                <div class="lh-step-number-badge">03</div>
                <div class="lh-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </div>
                <h3 class="lh-step-title">Delivered Fresh</h3>
                <p class="lh-step-text">
                    Within 24 to 48 hours (or same-day with Express), your clothes return crisp, hygienic, and ready to put straight into your closet. Free delivery on orders 5kg and above.
                </p>
                <div class="lh-step-detail-tag">Hygienic protective packaging</div>
            </div>
        </div>
    </div>
</section>

<!-- PRICING TABLE & CALCULATOR (Full-Width, Centered Inner Content) -->
<section class="lh-section lh-pricing-section" id="pricing">
    <div class="lh-container">
        <div class="lh-section-header">
            <span class="lh-section-subtitle">Clear & Honest Rates</span>
            <h2 class="lh-section-title">Transparent Per-Kilo Pricing</h2>
            <p class="lh-section-desc">Fair rates priced per kilo in Philippine Pesos (₱). No hidden detergent fees or surprise add-ons.</p>
        </div>

        <!-- Pricing Key Rules Banner -->
        <div class="lh-pricing-policy-card">
            <div class="lh-policy-col">
                <div class="lh-policy-badge">Minimum Order</div>
                <div class="lh-policy-title">3 kg Minimum</div>
                <p class="lh-policy-desc">All pickup orders have a 3kg minimum requirement.</p>
            </div>
            <div class="lh-policy-divider"></div>
            <div class="lh-policy-col lh-policy-highlight">
                <div class="lh-policy-badge lh-badge-free">Free Delivery Deal</div>
                <div class="lh-policy-title">5 kg+ = FREE Delivery</div>
                <p class="lh-policy-desc">Free two-way pickup & delivery for 5kg and above! (₱50 flat rate under 5kg).</p>
            </div>
            <div class="lh-policy-divider"></div>
            <div class="lh-policy-col">
                <div class="lh-policy-badge">Operating Hours</div>
                <div class="lh-policy-title">Mon–Sat 8AM–7PM</div>
                <p class="lh-policy-desc">Sunday closed for deep sanitization of all laundry equipment.</p>
            </div>
        </div>

        <!-- Services Cards Grid -->
        <div class="lh-pricing-cards-grid">
            <!-- Service 1: Wash & Fold -->
            <div class="lh-price-card lh-card-featured">
                <div class="lh-card-popular-badge">Most Popular</div>
                <div class="lh-card-header">
                    <h3 class="lh-card-service-title">Wash & Fold</h3>
                    <p class="lh-card-service-sub">Everyday wear, t-shirts, casuals, towels, bedsheets</p>
                </div>
                <div class="lh-card-price-row">
                    <span class="lh-currency">₱</span>
                    <span class="lh-price-amount">45</span>
                    <span class="lh-price-freq">/ kg</span>
                </div>
                <ul class="lh-card-features">
                    <li><span class="lh-feat-icon">✓</span> Fabric & color sorting</li>
                    <li><span class="lh-feat-icon">✓</span> Premium detergent & fabric softener</li>
                    <li><span class="lh-feat-icon">✓</span> Machine tumble dried & crisp folded</li>
                    <li><span class="lh-feat-icon">✓</span> Sealed in protective bags</li>
                </ul>
                <button type="button" class="lh-btn lh-btn-primary lh-btn-full" data-select-calc="45" data-select-name="Wash & Fold">Calculate This Service</button>
            </div>

            <!-- Service 2: Wash & Iron -->
            <div class="lh-price-card">
                <div class="lh-card-header">
                    <h3 class="lh-card-service-title">Wash & Iron</h3>
                    <p class="lh-card-service-sub">Work shirts, office uniforms, slacks, polo shirts</p>
                </div>
                <div class="lh-card-price-row">
                    <span class="lh-currency">₱</span>
                    <span class="lh-price-amount">60</span>
                    <span class="lh-price-freq">/ kg</span>
                </div>
                <ul class="lh-card-features">
                    <li><span class="lh-feat-icon">✓</span> Complete wash & deep sanitize</li>
                    <li><span class="lh-feat-icon">✓</span> Professional steam iron pressing</li>
                    <li><span class="lh-feat-icon">✓</span> Wrinkle-free protective hangers</li>
                    <li><span class="lh-feat-icon">✓</span> Ready-to-wear work wardrobe</li>
                </ul>
                <button type="button" class="lh-btn lh-btn-outline lh-btn-full" data-select-calc="60" data-select-name="Wash & Iron">Calculate This Service</button>
            </div>

            <!-- Service 3: Dry Cleaning -->
            <div class="lh-price-card">
                <div class="lh-card-header">
                    <h3 class="lh-card-service-title">Dry Cleaning</h3>
                    <p class="lh-card-service-sub">Barongs, formal suits, gowns, delicate silks</p>
                </div>
                <div class="lh-card-price-row">
                    <span class="lh-currency">₱</span>
                    <span class="lh-price-amount">150</span>
                    <span class="lh-price-freq">/ kg</span>
                </div>
                <ul class="lh-card-features">
                    <li><span class="lh-feat-icon">✓</span> Non-toxic gentle solvent treatment</li>
                    <li><span class="lh-feat-icon">✓</span> Hand inspection & spot cleaning</li>
                    <li><span class="lh-feat-icon">✓</span> Custom shape-retention pressing</li>
                    <li><span class="lh-feat-icon">✓</span> Breathable garment dust covers</li>
                </ul>
                <button type="button" class="lh-btn lh-btn-outline lh-btn-full" data-select-calc="150" data-select-name="Dry Cleaning">Calculate This Service</button>
            </div>

            <!-- Service 4: Comforters & Linens -->
            <div class="lh-price-card">
                <div class="lh-card-header">
                    <h3 class="lh-card-service-title">Comforters & Linens</h3>
                    <p class="lh-card-service-sub">Bulky duvets, heavy blankets, curtains, bed covers</p>
                </div>
                <div class="lh-card-price-row">
                    <span class="lh-currency">₱</span>
                    <span class="lh-price-amount">70</span>
                    <span class="lh-price-freq">/ kg</span>
                </div>
                <ul class="lh-card-features">
                    <li><span class="lh-feat-icon">✓</span> Large commercial capacity drum wash</li>
                    <li><span class="lh-feat-icon">✓</span> Deep mite & dust removal sanitizing</li>
                    <li><span class="lh-feat-icon">✓</span> Fluffed & even heat drying</li>
                    <li><span class="lh-feat-icon">✓</span> Heavy-duty compact travel packs</li>
                </ul>
                <button type="button" class="lh-btn lh-btn-outline lh-btn-full" data-select-calc="70" data-select-name="Comforters & Linens">Calculate This Service</button>
            </div>
        </div>

        <!-- Add-on Note: Express -->
        <div class="lh-addon-row">
            <div class="lh-addon-content">
                <div class="lh-addon-badge">Optional Add-On</div>
                <div class="lh-addon-title">⚡ Express Same-Day Rush Service (+₱20/kg)</div>
                <p class="lh-addon-desc">Need your laundry in a hurry? Picked up before 11:00 AM and delivered back by 7:00 PM the exact same day.</p>
            </div>
        </div>

        <!-- Interactive Per-Kilo Cost Calculator -->
        <div class="lh-calculator-box" id="calculator">
            <div class="lh-calc-header">
                <div class="lh-calc-title-group">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E60D5" stroke-width="2.2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
                    <h3 class="lh-calc-title">Interactive Rate & Weight Calculator</h3>
