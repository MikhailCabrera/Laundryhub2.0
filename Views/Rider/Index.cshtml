<script src="~/js/order-timeline.js"></script>
<script src="~/js/simple-pager.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (window.SimplePager) SimplePager.paginate('rider-history-body', 'rider-history-pagination', 10);
});
/* ── Panel navigation ── */
function showPanel(name) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.sb-nav-item').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.rbn-item').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-current', 'false'); });
    const panel = document.getElementById('panel-' + name);
    if (panel) panel.classList.add('active');
    const nav = document.getElementById('nav-' + name);
    if (nav) nav.classList.add('active');
    const mnav = document.getElementById('rbn-' + name);
    if (mnav) { mnav.classList.add('active'); mnav.setAttribute('aria-current', 'page'); }
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ── Pickup modal ── */
function openPickupModal(orderId, orderNumber) {
    const form = document.getElementById('form-pickup');
    form.action = '/Rider/MarkPickedUp/' + orderId;
    document.getElementById('pickup-order-display').textContent = orderNumber;
    // Reset photo
    document.getElementById('pickup-photo-input').value = '';
    document.getElementById('photo-preview-wrap').style.display = 'none';
    document.getElementById('photo-preview-img').src = '';
    document.getElementById('modal-pickup').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closePickupModal() {
    document.getElementById('modal-pickup').classList.remove('open');
    document.body.style.overflow = '';
}

/* ── Delivery modal ── */
function openDeliveryModal(orderId, orderNumber) {
    const form = document.getElementById('form-delivery');
    form.action = '/Rider/MarkDelivered/' + orderId;
    document.getElementById('delivery-order-display').textContent = orderNumber;
    document.getElementById('delivery-photo-input').value = '';
    document.getElementById('delivery-preview-wrap').style.display = 'none';
    document.getElementById('delivery-preview-img').src = '';
    document.getElementById('modal-delivery').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeDeliveryModal() {
    document.getElementById('modal-delivery').classList.remove('open');
    document.body.style.overflow = '';
}
function previewDeliveryPhoto(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('delivery-preview-img').src = e.target.result;
            document.getElementById('delivery-preview-wrap').style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}
function previewPhoto(input) {
    const wrap = document.getElementById('photo-preview-wrap');
    const img  = document.getElementById('photo-preview-img');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; wrap.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}

/* ── Close on overlay click / Escape ── */
document.getElementById('modal-pickup').addEventListener('click', function(e) {
    if (e.target === this) closePickupModal();
});
document.getElementById('modal-delivery').addEventListener('click', function(e) {
    if (e.target === this) closeDeliveryModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closePickupModal();
        closeDeliveryModal();
    }
});

/* ── Auto-dismiss flash alerts ── */
document.querySelectorAll('.alert').forEach(a => {
    setTimeout(() => { a.style.opacity = '0'; a.style.transition = 'opacity 0.5s'; setTimeout(() => a.remove(), 500); }, 4000);
});

/* ── Shared order timeline (read-only view of each job's own stages) ── */
OrderTimeline.mountAll();

/* ── Rider GPS Tracking Client (Phase 2C) ── */
(function() {
    let watchId = null;
    let lastSentAt = 0;
    let lastSentLat = null;
    let lastSentLng = null;
    let isSending = false;

    const MIN_INTERVAL_MS = 10000; // ~10 seconds
    const MIN_DISTANCE_METERS = 10; // ~10 meters

    function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
        const R = 6371000; // meters
        const phi1 = lat1 * Math.PI / 180;
        const phi2 = lat2 * Math.PI / 180;
        const deltaPhi = (lat2 - lat1) * Math.PI / 180;
        const deltaLambda = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(deltaPhi / 2) * Math.sin(deltaPhi / 2) +
                  Math.cos(phi1) * Math.cos(phi2) *
                  Math.sin(deltaLambda / 2) * Math.sin(deltaLambda / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
    }

    function setGpsUiState(state, statusText, subText) {
        const card = document.getElementById('rider-gps-card');
        const dot = document.getElementById('rider-gps-dot');
        const text = document.getElementById('rider-gps-status-text');
        const sub = document.getElementById('rider-gps-sub');
        const btn = document.getElementById('btn-toggle-gps');

        if (!card) return;

        card.classList.remove('gps-state-off', 'gps-state-active', 'gps-state-error', 'gps-state-disabled');
        card.classList.add('gps-state-' + state);

        if (dot) {
            dot.className = 'gps-dot dot-' + (state === 'active' ? 'active' : (state === 'error' ? 'error' : (state === 'disabled' ? 'disabled' : 'off')));
        }
        if (text) text.textContent = statusText;
        if (sub && subText) sub.innerHTML = subText;

        if (btn) {
            if (state === 'active') {
                btn.className = 'btn btn-gps-stop btn-sm';
                btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg> Stop GPS';
            } else if (state === 'disabled') {
                btn.className = 'btn btn-ghost btn-sm';
                btn.disabled = true;
                btn.innerHTML = 'No Active Order';
            } else {
                btn.className = 'btn btn-gps-start btn-sm';
                btn.disabled = false;
                btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg> Start GPS';
            }
        }
    }

    async function sendGpsCoordinates(lat, lng) {
        const card = document.getElementById('rider-gps-card');
        if (!card) return;
        const orderIdVal = parseInt(card.getAttribute('data-order-id'), 10) || null;
        const orderNum = card.getAttribute('data-order-num') || '';

        isSending = true;
        try {
            const resp = await fetch('/api/rider/location', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    orderId: orderIdVal,
                    latitude: lat,
                    longitude: lng
                })
            });

            if (resp.ok) {
                lastSentAt = Date.now();
                lastSentLat = lat;
                lastSentLng = lng;
                const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                setGpsUiState('active', 'GPS Tracking Active', 'Broadcasting live location for order <strong style="color:var(--lh-text-headings);">' + orderNum + '</strong> · Last sent: ' + timeStr);
            } else if (resp.status === 400) {
                // Inactive order / invalid coordinates / lifecycle ended
                stopRiderGps('off');
                setGpsUiState('off', 'GPS Tracking Stopped', 'Order is no longer in an active tracking state.');
            } else if (resp.status === 401 || resp.status === 403) {
                stopRiderGps('error');
                setGpsUiState('error', 'Session Expired / Unauthorized', 'Please log in again as an active rider.');
            } else if (resp.status === 429) {
                // Rate limited, wait for next cycle
                console.warn('Rider GPS rate limit reached; throttling updates.');
            } else {
                setGpsUiState('error', 'GPS Connection Issue', 'Temporary issue reaching server. Retrying...');
            }
        } catch (err) {
            setGpsUiState('error', 'Network Connection Offline', 'Unable to transmit location. Will retry when connection returns.');
        } finally {
            isSending = false;
        }
    }

    function onGpsPosition(position) {
        if (!position || !position.coords) return;
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;
        const now = Date.now();

        // Evaluate throttling conditions:
        // 1. First location sends immediately (lastSentAt === 0).
        // 2. Otherwise send if elapsed >= MIN_INTERVAL_MS (~10s).
        // 3. Or send sooner if distance moved >= MIN_DISTANCE_METERS (~10m).
        let shouldSend = false;
        if (lastSentAt === 0) {
            shouldSend = true;
        } else if (now - lastSentAt >= MIN_INTERVAL_MS) {
            shouldSend = true;
        } else if (lastSentLat !== null && lastSentLng !== null) {
            const dist = calculateDistanceMeters(lastSentLat, lastSentLng, lat, lng);
            if (dist >= MIN_DISTANCE_METERS) {
                shouldSend = true;
            }
        }

        if (shouldSend && !isSending) {
            sendGpsCoordinates(lat, lng);
        }
    }

    function onGpsError(err) {
        let msg = 'Location error occurred.';
        if (err.code === 1) { // PERMISSION_DENIED
            msg = 'Location access was denied. Please allow geolocation in your browser settings.';
            stopRiderGps('off');
            setGpsUiState('off', 'GPS Permission Denied', msg);
        } else if (err.code === 2) { // POSITION_UNAVAILABLE
            msg = 'GPS signal unavailable. Ensure location/GPS is toggled on your device.';
            setGpsUiState('error', 'GPS Unavailable', msg);
        } else if (err.code === 3) { // TIMEOUT
            msg = 'GPS request timed out. Searching for satellites...';
            setGpsUiState('error', 'GPS Search Timeout', msg);
        } else {
            setGpsUiState('error', 'GPS Error', msg);
        }
    }

    window.startRiderGps = function() {
        const card = document.getElementById('rider-gps-card');
        if (!card || card.getAttribute('data-has-eligible') !== 'true') {
            return;
        }
        if (watchId !== null) {
            return; // Already active, prevent duplicate watches
        }
        if (!navigator.geolocation) {
            setGpsUiState('error', 'GPS Not Supported', 'Your device or browser does not support Geolocation.');
            return;
        }

        setGpsUiState('active', 'Acquiring GPS Signal...', 'Connecting to satellites and verifying position...');
        lastSentAt = 0;

        watchId = navigator.geolocation.watchPosition(onGpsPosition, onGpsError, {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 5000
        });
    };

    window.stopRiderGps = function(stateOverride) {
        if (watchId !== null) {
            navigator.geolocation.clearWatch(watchId);
            watchId = null;
        }
        const card = document.getElementById('rider-gps-card');
        const hasEligible = card && card.getAttribute('data-has-eligible') === 'true';
        const orderNum = card ? (card.getAttribute('data-order-num') || '') : '';

        const finalState = stateOverride || (hasEligible ? 'off' : 'disabled');
        const statusText = hasEligible ? 'GPS Tracking Off' : 'No Active Tracking Order';
        const subText = hasEligible
            ? 'Ready to track order <strong style="color:var(--lh-text-headings);">' + orderNum + '</strong>'
            : 'GPS tracking is only active during pickup or out-for-delivery trips';

        setGpsUiState(finalState, statusText, subText);
    };

    window.toggleRiderGps = function() {
        if (watchId !== null) {
            window.stopRiderGps();
        } else {
            window.startRiderGps();
        }
    };

    // Clean up watch on page unload
    window.addEventListener('beforeunload', function() {
        if (watchId !== null) {
            navigator.geolocation.clearWatch(watchId);
            watchId = null;
        }
    });
})();
</script>
</body>
</html>
