@model LaundryHub2._0.Models.RiderDashboardViewModel
@using LaundryHub2._0.Models
@{
    Layout = null;
    ViewData["Title"] = "Rider Portal | Laundry Hub Davao City";
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "dashboard";

    string StatusBadgeClass(OrderStatus s) => s switch {
        OrderStatus.RiderAssigned   => "rb rb-assigned",
        OrderStatus.PickedUp        => "rb rb-pickedup",
        OrderStatus.InTransitToShop => "rb rb-transit",
        OrderStatus.Weighing        => "rb rb-weighing",
        OrderStatus.ReadyForDelivery => "rb rb-ready",
        OrderStatus.OutForDelivery  => "rb rb-delivery",
        OrderStatus.Delivered       => "rb rb-complete",
        _ => "rb rb-done"
    };
    string StatusLabel(OrderStatus s) => s switch {
        OrderStatus.RiderAssigned   => "Rider Assigned",
        OrderStatus.PickedUp        => "Picked Up",
        OrderStatus.InTransitToShop => "In Transit to Shop",
        OrderStatus.Weighing        => "Arrived at Shop",
        OrderStatus.ReadyForDelivery => "Ready for Delivery",
        OrderStatus.OutForDelivery  => "Out for Delivery",
        OrderStatus.Delivered       => "Delivered",
        OrderStatus.Cancelled       => "Cancelled",
        OrderStatus.Abandoned       => "Abandoned",
        _ => s.ToString()
    };
    string Initials(string? n) {
        if (string.IsNullOrEmpty(n)) return "?";
        return string.Concat(n.Split(' ').Take(2).Where(p => p.Length > 0).Select(p => char.ToUpper(p[0])));
    }
    string? JsonUtc(DateTime? value) => value == null ? null : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToString("o");

    // Phase 2C: Determine active tracking job eligibility
    var eligibleJob = Model.ActiveJobs.FirstOrDefault(o =>
        (o.PickupRiderId == Model.Rider.Id && (o.Status == OrderStatus.RiderAssigned || o.Status == OrderStatus.PickedUp || o.Status == OrderStatus.InTransitToShop)) ||
        (o.DeliveryRiderId == Model.Rider.Id && (o.Status == OrderStatus.ReadyForDelivery || o.Status == OrderStatus.OutForDelivery || o.Status == OrderStatus.DeliveryAttemptFailed)));
    var hasEligibleJob = eligibleJob != null;
    var eligibleOrderId = eligibleJob?.Id ?? 0;
    var eligibleOrderNum = eligibleJob?.OrderNumber ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Laundry Hub Rider Portal — view assigned pickup jobs and update status." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-w:280px;
            --c-success:var(--lh-accent-jade);--c-success-bg:var(--lh-accent-mint);--c-success-border:var(--lh-accent-alabaster);
            --c-warning:var(--lh-accent-honey);--c-warning-bg:var(--lh-accent-cream);--c-warning-border:var(--lh-accent-sand);
            --c-danger:var(--lh-accent-red);--c-danger-bg:var(--lh-accent-blush);--c-danger-border:var(--lh-accent-rose);
        }
        /* Token-consolidation guard: ~/css/site.css is linked above for the canonical
           token block. Its element selectors (p, a, body -moz smoothing) would otherwise
           apply where this page previously relied on browser defaults, so pre-link
           rendering is restored here. No pixel changes by construction. */
        .rider-shell p{margin:1em 0;}
        .rider-shell a.btn{text-decoration:underline;}
        .rider-shell a[href^="tel:"]:hover{color:var(--lh-blue-600);}
        body{-moz-osx-font-smoothing:auto;}
        *,*::before,*::after{box-sizing:border-box;}
        html{font-size:16px;scroll-behavior:smooth;margin:0;padding:0;height:100%;background:var(--lh-blue-10);}
        body{margin:0;padding:0;min-height:100vh;font-family:var(--lh-font-body);font-size:1rem;line-height:1.6;color:var(--lh-text-body);background:var(--lh-blue-10);-webkit-font-smoothing:antialiased;overflow-x:hidden;}
        :focus-visible{outline:3px solid var(--lh-blue-400);outline-offset:2px;border-radius:var(--lh-radius-sm);}

        /* ── Shell ── */
        .rider-shell{display:flex;min-height:100vh;}

        /* ── Sidebar ── */
        .rider-sidebar{position:fixed;top:0;left:0;width:var(--sidebar-w);height:100vh;background:var(--lh-navy-900);display:flex;flex-direction:column;overflow-y:auto;z-index:100;box-shadow:4px 0 24px rgba(7,19,36,0.2);scrollbar-width:thin;scrollbar-color:var(--lh-navy-700) transparent;}
        .rider-sidebar::-webkit-scrollbar{width:4px;}
        .rider-sidebar::-webkit-scrollbar-thumb{background:var(--lh-navy-700);border-radius:4px;}
        .sb-brand{display:flex;align-items:center;gap:12px;padding:24px 20px 20px;border-bottom:1px solid rgba(255,255,255,0.07);}
        .sb-logo{width:40px;height:40px;background:linear-gradient(135deg,var(--lh-blue-500),var(--lh-blue-400));border-radius:var(--lh-radius-md);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(30,96,213,0.35);}
        .sb-logo svg{color:var(--lh-white);}
        .sb-brand-text{display:flex;flex-direction:column;gap:1px;}
        .sb-wordmark{font-family:var(--lh-font-heading);font-size:0.9rem;font-weight:700;color:var(--lh-white);line-height:1.2;}
        .sb-badge{display:inline-flex;align-items:center;padding:2px 8px;background:rgba(249,115,22,0.2);border:1px solid rgba(249,115,22,0.4);border-radius:20px;font-size:0.6875rem;font-weight:600;color:var(--lh-accent-orange);letter-spacing:0.04em;text-transform:uppercase;}
        .sb-nav{flex:1;padding:14px 10px;display:flex;flex-direction:column;gap:2px;}
        .sb-nav-item{display:flex;align-items:center;gap:12px;padding:11px 12px 11px 14px;border-radius:var(--lh-radius-md);color:rgba(255,255,255,0.6);font-size:0.9rem;font-weight:500;transition:var(--lh-transition);border:none;border-left:3px solid transparent;background:none;width:100%;text-align:left;cursor:pointer;}
        .sb-nav-item .nav-icon{flex-shrink:0;width:20px;height:20px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.4);transition:var(--lh-transition);}
        .sb-nav-item:hover{background:rgba(59,130,246,0.1);color:rgba(255,255,255,0.9);border-left-color:rgba(96,165,250,0.5);}
        .sb-nav-item:hover .nav-icon{color:var(--lh-blue-300);}
        .sb-nav-item.active{background:rgba(59,130,246,0.16);color:var(--lh-white);border-left-color:var(--lh-blue-400);}
        .sb-nav-item.active .nav-icon{color:var(--lh-blue-300);}
        .sb-job-count{margin-left:auto;background:var(--lh-accent-red);color:var(--lh-white);border-radius:10px;padding:1px 7px;font-size:0.6875rem;font-weight:700;}
        .sb-footer{padding:14px 10px 18px;border-top:1px solid rgba(255,255,255,0.07);}
        .sb-footer-info{display:flex;align-items:center;gap:10px;padding:8px 10px;}
        .sb-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--lh-accent-ember),var(--lh-accent-ember-dark));display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;color:var(--lh-white);flex-shrink:0;}
        .sb-meta{display:flex;flex-direction:column;gap:1px;overflow:hidden;}
        .sb-name{font-size:0.8rem;font-weight:600;color:rgba(255,255,255,0.85);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .sb-role{font-size:0.7rem;color:rgba(255,255,255,0.38);}

        /* ── Main ── */
        .rider-main{margin-left:var(--sidebar-w);flex:1;min-height:100vh;padding:36px 40px;display:flex;flex-direction:column;gap:0;}
        .panel{display:none;flex-direction:column;gap:24px;}
        .panel.active{display:flex;}
        .panel-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;}
        .panel-title{font-family:var(--lh-font-heading);font-size:1.625rem;font-weight:800;color:var(--lh-text-headings);margin:0;line-height:1.2;}
        .panel-subtitle{font-size:0.875rem;color:var(--lh-text-muted);margin:4px 0 0;}

        /* ── Cards ── */
        .card{background:var(--lh-white);border-radius:var(--lh-radius-lg);border:1px solid var(--lh-border-subtle);box-shadow:var(--lh-shadow-sm);overflow:hidden;}
        .card-body{padding:24px;}

        /* ── Job Cards ── */
        .jobs-grid{display:flex;flex-direction:column;gap:16px;}
        .job-card{background:var(--lh-white);border-radius:var(--lh-radius-lg);border:1px solid var(--lh-border-subtle);box-shadow:var(--lh-shadow-sm);overflow:hidden;transition:var(--lh-transition);}
        .job-card:hover{box-shadow:var(--lh-shadow-md);transform:translateY(-1px);}
        .job-card-header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px 14px;border-bottom:1px solid var(--lh-border-subtle);gap:12px;flex-wrap:wrap;}
        .job-order-num{font-family:var(--lh-font-heading);font-size:1rem;font-weight:700;color:var(--lh-blue-600);}
        .job-card-body{padding:16px 24px;}
        .job-info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px 20px;margin-bottom:16px;}
        .job-info-item{display:flex;flex-direction:column;gap:2px;}
        .job-info-label{font-size:0.7rem;font-weight:600;color:var(--lh-text-muted);text-transform:uppercase;letter-spacing:0.05em;}
        .job-info-value{font-size:0.875rem;font-weight:500;color:var(--lh-text-headings);}
        .job-services{font-size:0.8125rem;color:var(--lh-text-muted);margin-bottom:16px;}
        .job-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}

        /* ── Status badges (rider context) ──
           Outdoor legibility: 0.75rem / 700 with an 8px dot so the state
           reads at arm's length in daylight. */
        .rb{display:inline-flex;align-items:center;gap:6px;padding:5px 13px;border-radius:20px;font-size:0.75rem;font-weight:700;letter-spacing:0.03em;white-space:nowrap;}
        .rb::before{content:"";width:8px;height:8px;border-radius:50%;flex-shrink:0;}
        .rb-assigned{background:var(--lh-accent-peri);color:var(--lh-accent-iris);border:1px solid var(--lh-accent-lavender);}.rb-assigned::before{background:var(--lh-accent-cornflower);}
        .rb-pickedup{background:var(--lh-accent-peach);color:var(--lh-accent-clay);border:1px solid var(--lh-accent-apricot);}.rb-pickedup::before{background:var(--lh-accent-ember);}
        .rb-transit{background:var(--lh-accent-cream);color:var(--lh-accent-bronze);border:1px solid var(--lh-accent-sand);}.rb-transit::before{background:var(--lh-accent-honey);}
        .rb-weighing{background:var(--lh-accent-mint);color:var(--lh-accent-pine);border:1px solid var(--lh-accent-alabaster);}.rb-weighing::before{background:var(--lh-accent-jade);}
        .rb-ready{background:var(--lh-accent-frost);color:var(--lh-blue-600);border:1px solid var(--lh-blue-100);}.rb-ready::before{background:var(--lh-blue-400);}
        .rb-delivery{background:var(--lh-accent-peach);color:var(--lh-accent-clay);border:1px solid var(--lh-accent-apricot);}.rb-delivery::before{background:var(--lh-accent-ember);}
        .rb-complete{background:var(--lh-accent-mint);color:var(--lh-accent-pine);border:1px solid var(--lh-accent-alabaster);}.rb-complete::before{background:var(--lh-accent-jade);}
        .rb-done{background:var(--lh-accent-ash);color:var(--lh-accent-slate);border:1px solid var(--lh-accent-stone);}.rb-done::before{background:var(--lh-accent-smoke);}

        /* ── Buttons ── */
        .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;font-weight:600;cursor:pointer;border:none;transition:var(--lh-transition);line-height:1.4;white-space:nowrap;}
        .btn-primary{background:linear-gradient(135deg,var(--lh-blue-600),var(--lh-blue-400));color:var(--lh-white);box-shadow:0 2px 8px rgba(30,96,213,0.25);}
        .btn-primary:hover{box-shadow:0 4px 14px rgba(30,96,213,0.4);transform:translateY(-1px);}
        .btn-orange{background:linear-gradient(135deg,var(--lh-accent-ember-dark),var(--lh-accent-ember));color:var(--lh-white);box-shadow:0 2px 8px rgba(234,88,12,0.25);}
        .btn-orange:hover{box-shadow:0 4px 14px rgba(234,88,12,0.4);transform:translateY(-1px);}
        .btn-success{background:linear-gradient(135deg,var(--lh-accent-jade-dark),var(--lh-accent-jade));color:var(--lh-white);box-shadow:0 2px 8px rgba(5,150,105,0.25);}
        .btn-success:hover{box-shadow:0 4px 14px rgba(5,150,105,0.4);transform:translateY(-1px);}
        .btn-ghost{background:transparent;color:var(--lh-text-muted);border:1px solid var(--lh-border-light);}
        .btn-ghost:hover{background:var(--lh-blue-50);color:var(--lh-blue-600);border-color:var(--lh-blue-200);}
        .btn-sm{padding:6px 12px;font-size:0.75rem;}

        /* ── Stat Cards ── */
        .stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;}
        .stat-card{background:var(--lh-white);border:1px solid var(--lh-border-subtle);border-radius:var(--lh-radius-lg);padding:20px 24px;box-shadow:var(--lh-shadow-sm);display:flex;flex-direction:column;gap:4px;}
        .stat-label{font-size:0.75rem;font-weight:600;color:var(--lh-text-muted);text-transform:uppercase;letter-spacing:0.06em;}
        .stat-value{font-family:var(--lh-font-heading);font-size:2rem;font-weight:800;color:var(--lh-text-headings);}
        .stat-sub{font-size:0.75rem;color:var(--lh-text-muted);}

        /* ── Alert ── */
        .alert{display:flex;align-items:center;gap:10px;padding:14px 18px;border-radius:var(--lh-radius-md);font-size:0.875rem;font-weight:500;}
        .alert-success{background:var(--c-success-bg);color:var(--lh-accent-pine);border:1px solid var(--c-success-border);}
        .alert-error{background:var(--c-danger-bg);color:var(--lh-accent-crimson);border:1px solid var(--c-danger-border);}

        /* ── Empty state ── */
        .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;gap:12px;text-align:center;color:var(--lh-text-muted);}
        .empty-state svg{color:var(--lh-blue-200);}
        .empty-state p{margin:0;font-size:0.9rem;}

        /* ── Photo upload in modal ── */
        .photo-drop{border:2px dashed var(--lh-border-light);border-radius:var(--lh-radius-md);padding:24px;text-align:center;cursor:pointer;transition:var(--lh-transition);background:var(--lh-blue-10);}
        .photo-drop:hover{border-color:var(--lh-blue-400);background:var(--lh-blue-50);}
        .photo-drop input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;}
        .photo-preview{margin-top:12px;display:none;}
        .photo-preview img{max-width:100%;max-height:180px;border-radius:var(--lh-radius-md);object-fit:contain;}

        /* ── Modal ── */
        .modal-overlay{position:fixed;inset:0;background:rgba(7,19,36,0.55);backdrop-filter:blur(4px);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity 0.22s ease;}
        .modal-overlay.open{opacity:1;pointer-events:all;}
        .modal{background:var(--lh-white);border-radius:var(--lh-radius-xl);box-shadow:var(--lh-shadow-xl);width:100%;max-width:480px;max-height:90vh;overflow-y:auto;transform:translateY(16px) scale(0.97);transition:transform 0.28s cubic-bezier(0.16,1,0.3,1);}
        .modal-overlay.open .modal{transform:translateY(0) scale(1);}
        .modal-header{display:flex;align-items:center;justify-content:space-between;padding:22px 26px 18px;border-bottom:1px solid var(--lh-border-subtle);}
        .modal-title{font-family:var(--lh-font-heading);font-size:1.1rem;font-weight:700;color:var(--lh-text-headings);margin:0;}
        .modal-close{width:32px;height:32px;border-radius:var(--lh-radius-sm);border:none;background:var(--lh-blue-25);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--lh-text-muted);transition:var(--lh-transition);}
        .modal-close:hover{background:var(--c-danger-bg);color:var(--c-danger);}
        .modal-body{padding:22px 26px;display:flex;flex-direction:column;gap:16px;}
        .modal-footer{display:flex;justify-content:flex-end;gap:10px;padding:14px 26px 22px;border-top:1px solid var(--lh-border-subtle);}
        .form-group{display:flex;flex-direction:column;gap:6px;}
        .form-label{font-size:0.8125rem;font-weight:600;color:var(--lh-text-headings);}

        /* ── History table ── */
        .data-table{width:100%;border-collapse:collapse;}
        .data-table thead th{padding:11px 18px;text-align:left;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--lh-text-muted);background:var(--lh-blue-25);border-bottom:1px solid var(--lh-border-subtle);white-space:nowrap;}
        .data-table tbody tr{border-bottom:1px solid var(--lh-border-subtle);}
        .data-table tbody tr:last-child{border-bottom:none;}
        .data-table tbody tr:hover{background:var(--lh-blue-25);}
        .data-table tbody td{padding:13px 18px;font-size:0.875rem;color:var(--lh-text-body);vertical-align:middle;}

        /* ── Dashboard info card ── */
        .rider-welcome{background:linear-gradient(135deg,var(--lh-navy-900) 0%,var(--lh-navy-700) 100%);border-radius:var(--lh-radius-lg);padding:28px 32px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
        .rider-welcome-text{flex:1;min-width:0;}
        .rider-welcome-name{font-family:var(--lh-font-heading);font-size:1.5rem;font-weight:800;color:var(--lh-white);margin:0 0 4px;}
        .rider-welcome-sub{font-size:0.875rem;color:rgba(255,255,255,0.6);margin:0;}
        .rider-welcome-badge{background:rgba(249,115,22,0.2);border:1px solid rgba(249,115,22,0.4);border-radius:var(--lh-radius-md);padding:14px 20px;text-align:center;flex-shrink:0;}
        .rider-welcome-badge-num{font-family:var(--lh-font-heading);font-size:2.5rem;font-weight:800;color:var(--lh-accent-orange);line-height:1;}
        .rider-welcome-badge-label{font-size:0.75rem;color:rgba(255,255,255,0.5);margin-top:2px;}

        /* ── Rider notifications (customer bell/panel pattern, adapted IDs) ── */
        .rider-bell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--lh-blue-50);color:var(--lh-blue-600);text-decoration:none;flex-shrink:0;}
        .rider-bell-badge{position:absolute;top:-4px;right:-4px;background:#EF4444;color:#fff;border-radius:10px;padding:1px 7px;font-size:0.6875rem;font-weight:700;}
        .rider-note{padding:14px 24px;border-bottom:1px solid var(--lh-border-subtle);}
        .rider-note:last-child{border-bottom:none;}
        .rider-note.unread{background:var(--lh-blue-25);}

        /* ── Outdoor contrast pass ──
           Sidebar text was 0.38–0.6 white and unreadable in glare. Raised to
           >=0.7 white for labels, icons, and job counts. */
        .sb-nav-item{color:rgba(255,255,255,0.78);}
        .sb-nav-item .nav-icon{color:rgba(255,255,255,0.7);}
        .sb-nav-item.active{color:var(--lh-white);}
        .sb-nav-item:hover{color:var(--lh-white);}
        .sb-name{color:rgba(255,255,255,0.92);}
        .sb-role{color:rgba(255,255,255,0.7);}
        .sb-wordmark{color:var(--lh-white);}
        .rider-welcome-sub{color:rgba(255,255,255,0.78);}
        .rider-welcome-badge-label{color:rgba(255,255,255,0.72);}
        .sb-footer .btn-ghost{color:rgba(255,255,255,0.8);}
        .job-info-label{color:var(--lh-text-body);}

        /* ── Bottom navigation (<=768px) ── */
        .rider-bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:900;background:var(--lh-navy-900);border-top:1px solid rgba(255,255,255,0.1);box-shadow:0 -4px 20px rgba(7,19,36,0.25);padding:6px 8px calc(6px + env(safe-area-inset-bottom));display:none;align-items:stretch;justify-content:space-around;gap:4px;}
        .rbn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:44px;padding:8px 4px;border:none;background:none;border-radius:var(--lh-radius-md);color:rgba(255,255,255,0.72);font-size:0.75rem;font-weight:600;font-family:var(--lh-font-body);cursor:pointer;transition:var(--lh-transition);}
        .rbn-item .nav-icon{width:22px;height:22px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.7);}
        .rbn-item:hover{color:var(--lh-white);}
        .rbn-item.active{background:rgba(59,130,246,0.16);color:var(--lh-white);}
        .rbn-item.active .nav-icon{color:var(--lh-blue-300);}
        .rbn-item .rbn-count{background:var(--lh-accent-red);color:var(--lh-white);border-radius:10px;padding:0 6px;font-size:0.6875rem;font-weight:700;}

        /* ── Breakpoints ── */
        @@media (max-width:1024px){
            .rider-main{padding:28px 24px;}
        }
        /* Sidebar hidden, bottom nav shown */
        @@media (max-width:768px){
            .rider-sidebar{display:none;}
            .rider-main{margin-left:0;padding:20px 16px 96px;}
            .rider-bottom-nav{display:flex;}
            .panel-title{font-size:1.375rem;}
            .job-card-header,.job-card-body{padding-left:16px;padding-right:16px;}
            .rider-note{padding:14px 16px;}
            .card-body{padding:16px;}
            .rider-welcome{padding:22px 20px;}
            .rider-welcome-name{font-size:1.25rem;}
            .rider-welcome-badge{padding:12px 16px;}
            .rider-welcome-badge-num{font-size:2rem;}
            .job-actions{gap:10px;}
            .job-actions .btn{flex:1;justify-content:center;}
            .modal{max-height:88vh;}
            .modal-body,.modal-header{padding-left:18px;padding-right:18px;}
        }
        @@media (max-width:420px){
            .rider-main{padding:16px 12px 96px;}
            .stats-row{grid-template-columns:1fr;}
            .job-info-grid{grid-template-columns:1fr;}
            .stat-card{padding:16px 18px;}
            .rbn-item{font-size:0.6875rem;}
            .modal-footer{flex-direction:column-reverse;}
            .modal-footer .btn{width:100%;justify-content:center;min-height:44px;}
        }

        /* ── Rider GPS tracking banner / controls (Phase 2C) ── */
        .rider-gps-card{background:var(--lh-white);border-radius:var(--lh-card-radius);border:1px solid var(--lh-border-subtle);box-shadow:var(--lh-shadow-sm);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:20px;}
        .rider-gps-info{display:flex;align-items:center;gap:12px;min-width:0;}
        .rider-gps-icon-wrap{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--lh-transition);}
        .gps-state-off .rider-gps-icon-wrap{background:var(--lh-slate-100);color:var(--lh-slate-500);}
        .gps-state-active .rider-gps-icon-wrap{background:var(--lh-accent-mint);color:var(--lh-accent-jade);animation:pulse-gps 2s infinite;}
        .gps-state-error .rider-gps-icon-wrap{background:var(--lh-accent-blush);color:var(--lh-accent-red);}
        .gps-state-disabled .rider-gps-icon-wrap{background:var(--lh-blue-25);color:var(--lh-text-muted);}
        @@keyframes pulse-gps{0%{box-shadow:0 0 0 0 rgba(16,185,129,0.4);}70%{box-shadow:0 0 0 10px rgba(16,185,129,0);}100%{box-shadow:0 0 0 0 rgba(16,185,129,0);}}
        .rider-gps-text{display:flex;flex-direction:column;gap:2px;}
        .rider-gps-status{font-size:0.9375rem;font-weight:700;color:var(--lh-text-headings);display:flex;align-items:center;gap:8px;}
        .rider-gps-sub{font-size:0.8125rem;color:var(--lh-text-muted);}
        .gps-dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
        .gps-dot.dot-off{background:#94A3B8;}
        .gps-dot.dot-active{background:#10B981;}
        .gps-dot.dot-error{background:#EF4444;}
        .gps-dot.dot-disabled{background:#CBD5E1;}
        .rider-gps-actions{display:flex;align-items:center;gap:10px;}
        .btn-gps-start{background:linear-gradient(135deg,var(--lh-blue-600),var(--lh-blue-500));color:var(--lh-white);border:none;}
        .btn-gps-start:hover{box-shadow:0 4px 14px rgba(30,96,213,0.35);transform:translateY(-1px);}
        .btn-gps-stop{background:var(--c-danger-bg);color:var(--c-danger);border:1px solid var(--c-danger-border);}
        .btn-gps-stop:hover{background:var(--c-danger);color:var(--lh-white);}
    </style>
</head>
<body>
<div class="rider-shell">

    <!-- SIDEBAR -->
    <aside class="rider-sidebar" aria-label="Rider navigation">
        <div class="sb-brand">
            <div class="sb-logo">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM7.5 17.5C6.67 17.5 6 16.83 6 16C6 15.17 6.67 14.5 7.5 14.5C8.33 14.5 9 15.17 9 16C9 16.83 8.33 17.5 7.5 17.5ZM12 17.5C11.17 17.5 10.5 16.83 10.5 16C10.5 15.17 11.17 14.5 12 14.5C12.83 14.5 13.5 15.17 13.5 16C13.5 16.83 12.83 17.5 12 17.5ZM16.5 17.5C15.67 17.5 15 16.83 15 16C15 15.17 15.67 14.5 16.5 14.5C17.33 14.5 18 15.17 18 16C18 16.83 17.33 17.5 16.5 17.5ZM17.2 11.8C16.88 12.28 16.34 12.56 15.77 12.56H8.23C7.66 12.56 7.12 12.28 6.8 11.8L5.35 9.63C4.9 8.95 5.39 8.04 6.2 8.04H17.8C18.61 8.04 19.1 8.95 18.65 9.63L17.2 11.8Z" fill="currentColor"/>
                </svg>
            </div>
            <div class="sb-brand-text">
                <span class="sb-wordmark">Laundry Hub</span>
                <span class="sb-badge">Rider</span>
            </div>
        </div>

        <nav class="sb-nav" aria-label="Rider menu">
            <button class="sb-nav-item @(activeTab == "dashboard" ? "active" : "")" id="nav-dashboard" onclick="showPanel('dashboard')">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                </span>
                Dashboard
            </button>

            <button class="sb-nav-item @(activeTab == "jobs" ? "active" : "")" id="nav-jobs" onclick="showPanel('jobs')">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </span>
                My Jobs
                @if (Model.ActiveJobs.Count > 0) {
                    <span class="sb-job-count">@Model.ActiveJobs.Count</span>
                }
            </button>

            <button class="sb-nav-item @(activeTab == "history" ? "active" : "")" id="nav-history" onclick="showPanel('history')">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                </span>
                History
            </button>
        </nav>

        <div class="sb-footer">
            <div class="sb-footer-info">
                <div class="sb-avatar">@Initials(Model.Rider.FullName)</div>
                <div class="sb-meta">
                    <span class="sb-name">@Model.Rider.FullName</span>
                    <span class="sb-role">Rider · @(Model.Rider.PhoneNumber ?? "No number")</span>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:10px;padding:0 10px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;color:rgba(255,255,255,0.65);border-color:rgba(255,255,255,0.15);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Log Out
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="rider-main" aria-label="Rider main content">

        @if (TempData["SuccessMessage"] != null) {
            <div class="alert alert-success" style="margin-bottom:16px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null) {
            <div class="alert alert-error" style="margin-bottom:16px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- ══ RIDER GPS TRACKING STATUS & CONTROLS (Phase 2C) ══ -->
        <div class="rider-gps-card @(hasEligibleJob ? "gps-state-off" : "gps-state-disabled")" id="rider-gps-card" data-has-eligible="@(hasEligibleJob ? "true" : "false")" data-order-id="@eligibleOrderId" data-order-num="@eligibleOrderNum">
            <div class="rider-gps-info">
                <div class="rider-gps-icon-wrap" id="rider-gps-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                    </svg>
                </div>
                <div class="rider-gps-text">
                    <div class="rider-gps-status" id="rider-gps-status">
                        <span class="gps-dot @(hasEligibleJob ? "dot-off" : "dot-disabled")" id="rider-gps-dot"></span>
                        <span id="rider-gps-status-text">@(hasEligibleJob ? "GPS Tracking Off" : "No Active Tracking Order")</span>
                    </div>
                    <div class="rider-gps-sub" id="rider-gps-sub">
                        @if (hasEligibleJob) {
                            <span>Ready to track order <strong style="color:var(--lh-text-headings);">@eligibleOrderNum</strong></span>
                        } else {
                            <span>GPS tracking is only active during pickup or out-for-delivery trips</span>
                        }
                    </div>
                </div>
            </div>
            <div class="rider-gps-actions">
                @if (hasEligibleJob) {
                    <button type="button" class="btn btn-gps-start btn-sm" id="btn-toggle-gps" onclick="toggleRiderGps()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        Start GPS
                    </button>
                } else {
                    <button type="button" class="btn btn-ghost btn-sm" id="btn-toggle-gps" disabled style="opacity:0.6;cursor:not-allowed;">
                        No Active Order
                    </button>
                }
            </div>
        </div>

        <!-- ══ DASHBOARD PANEL ══ -->
        <div class="panel @(activeTab == "dashboard" ? "active" : "")" id="panel-dashboard">
            <div class="panel-header">
                <div>
                    <h1 class="panel-title">Dashboard</h1>
                    <p class="panel-subtitle">Your pickup and delivery performance at a glance.</p>
                </div>
                <a href="#rider-notifications-card" class="rider-bell" aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    @if (Model.UnreadNotificationsCount > 0) {
                        <span class="rider-bell-badge">@Model.UnreadNotificationsCount</span>
                    }
                </a>
            </div>

            <div class="rider-welcome">
                <div class="rider-welcome-text">
                    <p class="rider-welcome-name">Hey, @(Model.Rider.FullName?.Split(' ').FirstOrDefault() ?? "Rider")! 👋</p>
                    <p class="rider-welcome-sub">You have <strong style="color:var(--lh-accent-orange);">@Model.ActiveJobs.Count active job@(Model.ActiveJobs.Count == 1 ? "" : "s")</strong> waiting for action.</p>
                </div>
                <div class="rider-welcome-badge">
                    <div class="rider-welcome-badge-num">@Model.ActiveJobs.Count</div>
                    <div class="rider-welcome-badge-label">Active Jobs</div>
                </div>
            </div>

            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-label">Active Jobs</div>
                    <div class="stat-value" style="color:var(--lh-accent-ember)">@Model.ActiveJobs.Count</div>
                    <div class="stat-sub">Assigned + In progress</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Awaiting Pickup</div>
                    <div class="stat-value" style="color:var(--lh-blue-600)">@Model.ActiveJobs.Count(o => o.Status == OrderStatus.RiderAssigned)</div>
                    <div class="stat-sub">Go pick up now</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Completed Jobs</div>
                    <div class="stat-value" style="color:#10B981">@Model.TotalPickupsCompleted</div>
                    <div class="stat-sub">Pickup or delivery</div>
                </div>
            </div>

            <div class="job-card" id="rider-notifications-card">
                <div class="job-card-header">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="job-order-num">Notifications</span>
                        @if (Model.UnreadNotificationsCount > 0) {
                            <span class="rider-bell-badge" style="position:static;">@Model.UnreadNotificationsCount unread</span>
                        }
                    </div>
                    @if (Model.UnreadNotificationsCount > 0) {
                        <form method="post" asp-controller="Rider" asp-action="MarkNotificationsRead" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm">Mark all read</button>
                        </form>
                    }
                </div>
                <div class="job-card-body" style="padding:0;">
                    @if (!Model.Notifications.Any()) {
                        <div class="empty-state">
                            <p>No notifications yet. New pickup and delivery assignments will appear here.</p>
                        </div>
                    } else {
                        @foreach (var note in Model.Notifications) {
                            <div class="rider-note @(note.IsRead ? "" : "unread")">
                                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                                    <strong style="font-size:0.9rem;color:var(--lh-text-headings);">@note.Title</strong>
                                    <span style="font-size:0.75rem;color:var(--lh-text-muted);white-space:nowrap;">@note.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                                </div>
                                <p style="font-size:0.85rem;color:var(--lh-text-body);margin:4px 0 0;">@note.Body</p>
                                @if (!note.IsRead) {
                                    <form method="post" asp-controller="Rider" asp-action="MarkNotificationsRead" style="margin-top:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@note.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm">Mark read</button>
                                    </form>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @if (Model.ActiveJobs.Count > 0) {
                <div>
                    <h2 style="font-family:var(--lh-font-heading);font-size:1rem;font-weight:700;color:var(--lh-text-headings);margin:0 0 12px;">
                        Active Jobs Summary
                    </h2>
                    <div class="jobs-grid">
                        @foreach (var job in Model.ActiveJobs.Take(3)) {
                            <div class="job-card">
                                <div class="job-card-header">
                                    <span class="job-order-num">@job.OrderNumber</span>
                                    <span class="@StatusBadgeClass(job.Status)">@StatusLabel(job.Status)</span>
                                </div>
                                <div class="job-card-body">
                                    <div class="job-info-grid">
                                        <div class="job-info-item">
                                            <span class="job-info-label">Customer</span>
                                            <span class="job-info-value">@(job.Customer?.FullName ?? "—")</span>
                                        </div>
                                        <div class="job-info-item">
                                            <span class="job-info-label">Pickup Date</span>
                                            <span class="job-info-value">@job.PreferredPickupDate.ToString("MMM d") — @job.PreferredPickupTime</span>
                                        </div>
                                    </div>
                                <div class="job-actions">
                                        <button class="btn btn-primary btn-sm" onclick="showPanel('jobs')">
                                            View Job Details
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ══ MY JOBS PANEL ══ -->
        <div class="panel @(activeTab == "jobs" ? "active" : "")" id="panel-jobs">
            <div class="panel-header">
                <div>
                    <h1 class="panel-title">My Jobs</h1>
                    <p class="panel-subtitle">Orders assigned to you for pickup or delivery. Follow the steps below for each job.</p>
                </div>
            </div>

            @if (!Model.ActiveJobs.Any()) {
                <div class="card">
                    <div class="card-body">
                        <div class="empty-state">
                            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                            <p>No active pickup or delivery jobs right now.<br>New jobs assigned by the admin will appear here.</p>
                        </div>
                    </div>
                </div>
            } else {
                <div class="jobs-grid">
                    <script type="application/json" id="rider-timeline-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveJobs.Select(j => new {
    orderNumber = j.OrderNumber,
    status = j.Status.ToString(),
    leg = j.Status == OrderStatus.OutForDelivery ? "delivery" : "pickup",
    createdAt = JsonUtc(j.CreatedAt),
    riderAssignedAt = JsonUtc(j.RiderAssignedAt),
    pickedUpAt = JsonUtc(j.PickedUpAt),
    weightConfirmedAt = JsonUtc(j.WeightConfirmedAt),
    washingStartedAt = JsonUtc(j.WashingStartedAt),
    dryingStartedAt = JsonUtc(j.DryingStartedAt),
    readyNotifiedAt = JsonUtc(j.ReadyForDeliveryNotifiedAt),
    deliveryAssignedAt = JsonUtc(j.DeliveryAssignedAt),
    deliveredAt = JsonUtc(j.DeliveredAt)
}).ToList()))
                    </script>
                    @{ int jobIndex = 0; }
                    @foreach (var job in Model.ActiveJobs) {
                        var timelineIndex = jobIndex++;
                        var isDeliveryJob = job.Status == OrderStatus.OutForDelivery;
                        var assignedAt = isDeliveryJob ? job.DeliveryAssignedAt : job.RiderAssignedAt;
                        var assignedLabel = isDeliveryJob ? "Dispatched" : "Assigned";
                        var svcList = string.Join(", ", job.OrderServices.Select(os => os.Service?.Name ?? "?"));
                        <div class="job-card">
                            <div class="job-card-header">
                                <div>
                                    <span class="job-order-num">@job.OrderNumber</span>
                                    <div style="font-size:0.75rem;color:var(--lh-text-muted);margin-top:2px;">@assignedLabel @(assignedAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "—")</div>
                                </div>
                                <span class="@StatusBadgeClass(job.Status)">@StatusLabel(job.Status)</span>
                            </div>
                            <div class="job-card-body">
                                <div class="job-info-grid">
                                    <div class="job-info-item">
                                        <span class="job-info-label">Customer</span>
                                        <span class="job-info-value">@(job.Customer?.FullName ?? "—")</span>
                                    </div>
                                    <div class="job-info-item">
                                        <span class="job-info-label">Contact</span>
                                        <span class="job-info-value">
                                            <a href="tel:@job.ContactNumber" style="color:var(--lh-blue-600);text-decoration:none;font-weight:600;">@job.ContactNumber</a>
                                        </span>
                                    </div>
                                    @if (isDeliveryJob) {
                                        <div class="job-info-item">
                                            <span class="job-info-label">Dispatched</span>
                                            <span class="job-info-value">@(job.DeliveryAssignedAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "—")</span>
                                        </div>
                                        <div class="job-info-item">
                                            <span class="job-info-label">Delivery Address</span>
                                            <span class="job-info-value">@job.PickupLocation</span>
                                        </div>
                                    } else {
                                        <div class="job-info-item">
                                            <span class="job-info-label">Pickup Date</span>
                                            <span class="job-info-value">@job.PreferredPickupDate.ToString("MMM d, yyyy")</span>
                                        </div>
                                        <div class="job-info-item">
                                            <span class="job-info-label">Pickup Time</span>
                                            <span class="job-info-value">@job.PreferredPickupTime</span>
                                        </div>
                                    }
                                </div>
                                @if (!isDeliveryJob) {
                                    <div class="job-info-item" style="margin-bottom:16px;">
                                        <span class="job-info-label">Pickup Address</span>
                                        <span class="job-info-value" style="font-size:0.9rem;">@job.PickupLocation</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(svcList)) {
                                    <div class="job-services">
                                        <strong>Services:</strong> @svcList
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(job.SpecialInstructions)) {
                                    <div style="background:var(--lh-blue-25);border:1px solid var(--lh-border-subtle);border-radius:var(--lh-radius-md);padding:10px 14px;font-size:0.8125rem;color:var(--lh-text-body);margin-bottom:16px;">
                                        <strong>Special Instructions:</strong> @job.SpecialInstructions
                                    </div>
                                }
                                <div data-timeline-surface="processing" data-timeline-orders="rider-timeline-data" data-timeline-index="@timelineIndex" data-timeline-leg="@(isDeliveryJob ? "delivery" : "pickup")" aria-label="Order stages for @job.OrderNumber"></div>
                                <div class="job-actions">
                                    @if (job.Status == OrderStatus.RiderAssigned) {
                                        <button class="btn btn-orange" onclick="openPickupModal(@job.Id, '@job.OrderNumber')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                            Mark as Picked Up
                                        </button>
                                    }
                                    @if (job.Status == OrderStatus.PickedUp) {
                                        <form method="post" asp-controller="Rider" asp-action="MarkInTransit" asp-route-id="@job.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                                In Transit to Shop
                                            </button>
                                        </form>
                                    }
                                    @if (job.Status == OrderStatus.PickedUp || job.Status == OrderStatus.InTransitToShop) {
                                        <form method="post" asp-controller="Rider" asp-action="ArrivedAtShop" asp-route-id="@job.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                                Arrived at Shop
                                            </button>
                                        </form>
                                    }
                                    @if (job.Status == OrderStatus.OutForDelivery) {
                                        <button class="btn btn-success" onclick="openDeliveryModal(@job.Id, '@job.OrderNumber')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                            Mark Delivered
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(job.PickupPhotoPath)) {
                                        <a href="@job.PickupPhotoPath" target="_blank" class="btn btn-ghost btn-sm">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                            Pickup Photo
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(job.DeliveryPhotoPath)) {
                                        <a href="@job.DeliveryPhotoPath" target="_blank" class="btn btn-ghost btn-sm">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                            Delivery Photo
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ══ HISTORY PANEL ══ -->
        <div class="panel @(activeTab == "history" ? "active" : "")" id="panel-history">
            <div class="panel-header">
                <div>
                    <h1 class="panel-title">Job History</h1>
