<script>
    /* Shared responsive contract: collapsible sidebar, bottom nav, condensed table columns. */
    (function () {
        var CHEVRON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>';

        function enhanceTable(table) {
            if (!table.tHead || !table.tHead.rows[0] || !table.tBodies[0]) return;
            if (table.tHead.rows[0].cells.length < 4) return;
            var rows = Array.prototype.slice.call(table.tBodies[0].rows);
            rows.forEach(function (row) {
                if (row.querySelector('.row-toggle')) return;
                var cell = row.cells[0];
                if (!cell) return;
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'row-toggle';
                btn.setAttribute('aria-expanded', 'false');
                btn.setAttribute('aria-label', 'Show all columns for this row');
                btn.innerHTML = CHEVRON;
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var open = row.classList.toggle('row-expanded');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                cell.insertBefore(btn, cell.firstChild);
            });
        }

        function enhance() {
            var tables = document.querySelectorAll('.table-scroll table');
            Array.prototype.forEach.call(tables, enhanceTable);
        }

        window.lhEnhanceResponsiveTables = enhance;

        /* Sidebar collapse (off-canvas <=1024px) */
        var sidebar = document.getElementById('adminSidebar');
        var scrim = document.getElementById('sidebarScrim');
        var toggle = document.getElementById('sidebarToggle');
        function setSidebar(open) {
            if (!sidebar || !toggle) return;
            sidebar.classList.toggle('open', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        if (toggle) {
            toggle.addEventListener('click', function () {
                setSidebar(!sidebar.classList.contains('open'));
            });
        }
        if (scrim) {
            scrim.addEventListener('click', function () { setSidebar(false); });
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') setSidebar(false);
        });

        /* Bottom-nav active state mirrors the sidebar selection (also on programmatic showPanel). */
        var nav = document.querySelector('.sidebar-nav');
        function syncBottomNav() {
            if (!nav) return;
            var activeId = null;
            var active = nav.querySelector('.sidebar-nav-item.active');
            if (active) activeId = active.id;
            var items = document.querySelectorAll('.admin-bottom-nav-item');
            Array.prototype.forEach.call(items, function (item) {
                item.classList.toggle('active', item.getAttribute('data-nav-sync') === activeId);
            });
        }
        document.querySelectorAll('.admin-bottom-nav-item').forEach(function (item) {
            item.addEventListener('click', function () { setSidebar(false); });
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () { enhance(); syncBottomNav(); });
        } else {
            enhance();
            syncBottomNav();
        }

        if (window.MutationObserver) {
            var mo = new MutationObserver(function () { enhance(); syncBottomNav(); });
            mo.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
        }

        function openContactAttemptModal(orderId, orderNumber) {
            document.getElementById('contact-order-id').value = orderId;
            document.getElementById('contact-order-display').value = orderNumber;
            openModal('modal-contact-attempt');
        }
        function openExtendDeadlineModal(orderId, orderNumber) {
            document.getElementById('extend-order-id').value = orderId;
            document.getElementById('extend-order-display').value = orderNumber;
            openModal('modal-extend-deadline');
        }
        function openWeightOverrideModal(orderId, orderNumber, currentWeight) {
            document.getElementById('override-order-id').value = orderId;
            document.getElementById('override-order-display').value = orderNumber;
            document.getElementById('override-estimated-weight').value = currentWeight || '';
            openModal('modal-weight-override');
        }
    })();
</script>

