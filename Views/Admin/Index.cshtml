<!-- MODAL: Walk-in Order -->
<div class="modal-overlay" id="modal-walkin" role="dialog" aria-modal="true" aria-labelledby="modal-walkin-title">
    <div class="modal" style="max-width:520px">
        <div class="modal-header">
            <h2 class="modal-title" id="modal-walkin-title">New Walk-in Order</h2>
            <button class="modal-close" onclick="closeModal('modal-walkin')" aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="walkin-customer-id" value="" />
            @Html.AntiForgeryToken()
            <div class="suspend-warning" style="background:#EFF6FF;border-color:#BFDBFE;color:#1E40AF;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>The shop holds the bag: the order starts at the Weighing stage with no pickup leg.</span>
            </div>
            <div class="form-group">
                <label class="form-label" for="walkin-customer-search">Customer (search email or name) <span style="color:var(--c-danger)">*</span></label>
                <input type="text" class="form-control" id="walkin-customer-search" placeholder="e.g. maria@gmail.com" autocomplete="off" oninput="searchWalkInCustomers(this.value)" />
                <div id="walkin-customer-matches" style="display:flex;flex-direction:column;gap:4px;margin-top:8px;"></div>
                <div id="walkin-customer-selected" class="user-email" style="margin-top:6px;"></div>
            </div>
            <div class="form-group">
                <span class="form-label">Services <span style="color:var(--c-danger)">*</span></span>
                @foreach (var svc in Model.AvailableServices) {
                    <label style="display:flex;align-items:center;gap:8px;font-size:0.875rem;padding:4px 0;">
                        <input type="checkbox" class="walkin-service-check" value="@svc.Id" />
                        <span>@svc.Name — ₱@svc.PricePerKg.ToString("0.##") / kg</span>
                    </label>
                }
            </div>
            <div class="form-group">
                <label style="display:flex;align-items:flex-start;gap:8px;font-size:0.8125rem;">
                    <input type="checkbox" id="walkin-terms-check" style="margin-top:3px;" />
                    <span>I confirm the customer was shown and accepted Laundry Hub's <a href="/Terms" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a>.</span>
                </label>
            </div>
            <span class="form-error" id="err-walkin"></span>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" onclick="closeModal('modal-walkin')">Cancel</button>
            <button class="btn btn-primary" onclick="confirmWalkInOrder()">Create Walk-in Order</button>
        </div>
    </div>
</div>

