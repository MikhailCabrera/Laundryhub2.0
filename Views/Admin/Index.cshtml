/* ============================================================
   SUSPEND / UNSUSPEND — server-backed. POSTs to Admin/SuspendUser or
   Admin/UnsuspendUser (which update AspNetUsers), then reloads the page
   on the same tab so the tables re-render from database truth.
   NOTE: Add / Edit / Archive have no backend yet — their demo-only UI and
   logic were removed in this iteration rather than left pretending to work.
   ============================================================ */
function findUserById(id){
    return employees.find(x=>x.id===id) || customers.find(x=>x.id===id) || null;
}
function userTabFor(a){
    return CUSTOMER_ROLES.includes(a.role) ? 'customers' : 'employees';
}
function antiForgeryToken(){
    const el = document.querySelector('#modal-suspend input[name="__RequestVerificationToken"]')
            || document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
async function postUserAction(url, params){
    const body = new URLSearchParams(params);
    body.append('__RequestVerificationToken', antiForgeryToken());
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
        body: body.toString()
    });
    if(!res.ok){
        let message = 'Server returned HTTP ' + res.status;
        try{ const errData = await res.json(); if(errData && errData.message) message = errData.message; }catch(_){}
        throw new Error(message);
    }
    return await res.json();
}
function openSuspendModal(id){
    if(!LH_CAN_MANAGE_USERS) return;
    const host=document.getElementById('suspend-id');if(!host) return;
    const a=findUserById(id);if(!a)return;
    host.value=a.id;
    document.getElementById('suspend-target-name').value=a.fullName+' ('+a.email+')';
    document.getElementById('suspend-note').value='';
    document.getElementById('err-suspend-note').textContent='';
    openModal('modal-suspend');
}
async function confirmSuspend(){
    const id=document.getElementById('suspend-id').value;
    const note=document.getElementById('suspend-note').value.trim();
    if(!note){document.getElementById('err-suspend-note').textContent='A suspension reason is required.';return;}
    const a=findUserById(id);if(!a)return;
    try{
        const data = await postUserAction('/Admin/SuspendUser', { UserId: id, SuspendNote: note });
        if(!data || !data.success) throw new Error((data && data.message) || 'Suspension failed.');
        closeModal('modal-suspend');
        window.location.href = '/Admin/Index?tab=' + userTabFor(a);
    }catch(err){
        document.getElementById('err-suspend-note').textContent = err.message || 'Suspension failed. Please try again.';
    }
}
async function unsuspendAccount(id){
    const a=findUserById(String(id));if(!a)return;
    if(!confirm('Unsuspend ' + a.fullName + ' (' + a.email + ')? They will regain access.')) return;
    try{
        const data = await postUserAction('/Admin/UnsuspendUser', { UserId: a.id });
        if(!data || !data.success) throw new Error((data && data.message) || 'Unsuspend failed.');
        window.location.href = '/Admin/Index?tab=' + userTabFor(a);
    }catch(err){
        alert(err.message || 'Unsuspend failed. Please try again.');
    }
}
