    if(!/.+@@.+\..+/.test(email)){ errEl.textContent='Please enter a valid email address.'; return; }
    if(!ACCOUNT_ROLES.includes(role)){ errEl.textContent='Please select a valid role.'; return; }
    const params = { FullName: name, Email: email, Role: role };
    let url = '/Admin/EditUser';
    if(!isEdit){
        const password = document.getElementById('acc-password').value;
        if(password.length < 6){ errEl.textContent='Password must be at least 6 characters.'; return; }
