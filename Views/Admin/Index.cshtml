let trackingTableMgr = null;
let trackingLegs = [];
let trackingGroupFilter = 'all';
let trackingOverdueOnly = false;
const TRACK_WASH_OVERDUE_HOURS = 4;
const TRACK_DRY_OVERDUE_HOURS = 4;

function trackStageOverdue(item, nowMs){
    const now = nowMs || Date.now();
    const elapsedHours = start => {
        if(!start) return null;
        const ms = now - new Date(start).getTime();
        if(Number.isNaN(ms) || ms < 0) return null;
        return ms / 3600000;
    };
    const washHours = elapsedHours(item.washingStartedAt);
    if(washHours !== null && item.dryingStartedAt == null && washHours > TRACK_WASH_OVERDUE_HOURS)
        return { overdue:true, hours:Math.floor(washHours) };
    const dryHours = elapsedHours(item.dryingStartedAt);
    if(dryHours !== null && item.processingCompletedAt == null && dryHours > TRACK_DRY_OVERDUE_HOURS)
        return { overdue:true, hours:Math.floor(dryHours) };
    return { overdue:false, hours:0 };
}

function trackOverdueBadge(item){
    const info = trackStageOverdue(item);
    if(!info.overdue) return '';
    return '<div style="margin-top:4px;"><span class="ord-badge ord-awaiting-payment">Overdue ' + info.hours + 'h</span></div>';
}

function trackingGroup(status){
    if(status === 'WeightConfirmed' || status === 'Washing' || status === 'Drying' || status === 'PaymentConfirmed') return 'processing';
    if(status === 'AwaitingPayment') return 'payment';
    if(status === 'ReadyForDelivery' || status === 'OutForDelivery') return 'delivery';
    if(status === 'Delivered') return 'completed';
    return null;
}

function renderTrackingRow(item){
    const weight = (item.weightKg === null || item.weightKg === undefined || item.weightKg === '') ? '—' : Number(item.weightKg).toFixed(2) + ' kg';
    const total = '₱' + Number(item.totalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return `
        <tr class="pd-row" onclick="togglePdTimeline(event,'tracking',${item.id})">
            <td><span style="font-weight:700;color:var(--lh-blue-600);font-size:0.825rem;font-family:var(--lh-font-heading);">${escapeHtml(item.orderNumber)}</span></td>
            <td><div class="user-name">${escapeHtml(item.customerName)}</div><div class="user-email">${escapeHtml(item.contactNumber || '')}</div></td>
            <td style="font-size:0.8125rem;max-width:220px;">${escapeHtml(item.services || '—')}</td>
            <td style="font-weight:600;white-space:nowrap;">${escapeHtml(weight)}</td>
            <td style="font-weight:700;color:var(--lh-text-headings);white-space:nowrap;">${escapeHtml(total)}</td>
            <td>${pdStageBadge(item.status)}${trackOverdueBadge(item)}</td>
            <td><span class="pd-chevron" id="pd-ch-tracking-${item.id}">▸</span></td>
        </tr>
        <tr class="pd-detail-row"><td colspan="7" class="pd-detail-cell"><div class="pd-timeline-wrap" id="pd-tl-tracking-${item.id}" style="display:none;"></div></td></tr>`;
}

function initTrackingTable(){
    if(!trackingTableMgr){
        trackingTableMgr = new TableManager({
            tableBodyId: 'tracking-table-body',
            paginationContainerId: 'tracking-pagination',
            emptyStateId: 'tracking-empty',
            searchInputId: 'tracking-search',
            pageSize: 10,
            renderRow: renderTrackingRow,
            searchPredicate: (item, q) => ((item.orderNumber || '') + ' ' + (item.customerName || '') + ' ' + (item.services || '')).toLowerCase().includes(q)
        });
    }
    trackingLegs = readUserData('tracking-data');
    trackingTableMgr.setData(trackingLegs);
    applyTrackingFilter();
    renderTrackingStats();
    renderTrackingChipCounts();
}

function buildTrackingFilter(){
    return item => (trackingGroupFilter === 'all' || trackingGroup(item.status) === trackingGroupFilter) && (!trackingOverdueOnly || trackStageOverdue(item).overdue);
}

function applyTrackingFilter(){
    if(trackingTableMgr) trackingTableMgr.setCustomFilter(buildTrackingFilter());
}

function filterTracking(group){
    trackingGroupFilter = group;
    document.querySelectorAll('#tracking-stage-chips .chip').forEach(c => { if(c.dataset.group !== undefined) c.classList.toggle('active', c.dataset.group === group); });
    applyTrackingFilter();
}

function toggleTrackingOverdue(){
    trackingOverdueOnly = !trackingOverdueOnly;
    document.getElementById('tracking-overdue-chip').classList.toggle('active', trackingOverdueOnly);
    applyTrackingFilter();
}

function renderTrackingStats(){
    const statsElement = document.getElementById('tracking-stats');
    if(!statsElement) return;
    const items = trackingLegs;
    const count = g => items.filter(x => trackingGroup(x.status) === g).length;
    statsElement.innerHTML = `
        <div class="stat-card"><div class="stat-label">Tracked Orders</div><div class="stat-value">${items.length}</div><div class="stat-sub">Weight confirmed</div></div>
        <div class="stat-card"><div class="stat-label">Processing</div><div class="stat-value" style="color:var(--lh-blue-600)">${count('processing')}</div><div class="stat-sub">In-shop stages</div></div>
        <div class="stat-card"><div class="stat-label">Awaiting Payment</div><div class="stat-value" style="color:#DC2626">${count('payment')}</div><div class="stat-sub">Unpaid, ready total</div></div>
        <div class="stat-card"><div class="stat-label">Completed</div><div class="stat-value" style="color:#059669">${count('completed')}</div><div class="stat-sub">Delivered orders</div></div>`;
}

function renderTrackingChipCounts(){
    const labels = { all:'All', processing:'Processing', payment:'Awaiting Payment', delivery:'Out for Delivery', completed:'Completed' };
    document.querySelectorAll('#tracking-stage-chips .chip').forEach(c => {
        const g = c.dataset.group;
        const n = g === 'all' ? trackingLegs.length : trackingLegs.filter(x => trackingGroup(x.status) === g).length;
        c.textContent = labels[g] + ' (' + n + ')';
    });
}

