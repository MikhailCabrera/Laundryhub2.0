        <script type="application/json" id="inventory-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InventoryTransactions.Select(t => new {
    id = t.Id,
    itemId = t.InventoryItemId,
    itemName = t.Item != null ? t.Item.Name : "Unknown item",
    unit = t.Item != null ? t.Item.Unit : "",
    action = t.Action.ToString(),
    quantity = t.Quantity,
    previousStock = t.PreviousStock,
    newStock = t.NewStock,
    performedBy = t.PerformedBy != null ? t.PerformedBy.FullName : "Unknown staff",
