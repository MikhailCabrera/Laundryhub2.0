                <div class="card-body">
                    <table class="data-table" id="loyalty-table" aria-label="Loyalty members">
                        <thead><tr><th>Customer</th><th>Balance</th><th>Earned</th><th>Redeemed</th><th>Expiring ≤30d</th><th>Last Activity</th><th>Actions</th></tr></thead>
                        <tbody id="loyalty-table-body"></tbody>
                    </table>
                    <div id="loyalty-empty" class="empty-state" style="display:none;">
                        <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <p>No loyalty members found.</p>
                    </div>
                    <div id="loyalty-pagination"></div>
                </div>
            </div>
        </div>

        <!-- REPORTS / AUDIT LOG PANEL -->
        <div class="panel" id="panel-reports">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Reports &amp; Audit Log</h1>
                    <p class="panel-subtitle">Complete record of all admin actions on accounts.</p>
                </div>
            </div>
            @{
                var revenuePaid = Model.Orders.Where(o => o.IsPaymentConfirmed && o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Abandoned && !o.IsAbandoned && o.PaymentConfirmedAt.HasValue).ToList();
                var revenueNet = revenuePaid.ToDictionary(o => o.Id, o => {
                    var pts = Model.LoyaltyTransactions.Where(t => t.OrderId == o.Id && t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Redeem).Sum(t => (int?)t.Points) ?? 0;
                    var disc = pts < 0 ? Math.Min(-(decimal)pts / 100m * 10m, o.TotalAmount ?? 0m) : 0m;
                    return Math.Max(0m, (o.TotalAmount ?? 0m) + (o.AccruedPenaltyAmount ?? 0m) - disc);
                });
                var revenueBasis = revenuePaid.ToDictionary(o => o.Id, o => o.OrderServices.Sum(os => os.PricePerKgSnapshot * (o.WeightKg ?? 0m)));
                var revenueDaily = revenuePaid.GroupBy(o => o.PaymentConfirmedAt!.Value.Date).OrderBy(g => g.Key).Select(g => new {
                    date = g.Key.ToString("yyyy-MM-dd"),
                    amount = Math.Round(g.Sum(o => revenueNet[o.Id]), 2),
                    count = g.Count()
                }).ToList<object>();
                var revenueServices = revenuePaid
                    .SelectMany(o => o.OrderServices.Select(os => new { Name = os.Service != null ? os.Service.Name : "?", OrderId = o.Id, Basis = os.PricePerKgSnapshot * (o.WeightKg ?? 0m) }))
                    .GroupBy(x => x.Name)
                    .Select(g => new { service = g.Key, amount = Math.Round(g.Sum(x => revenueBasis[x.OrderId] > 0 ? revenueNet[x.OrderId] * x.Basis / revenueBasis[x.OrderId] : 0m), 2) })
                    .OrderByDescending(x => x.amount)
                    .ToList<object>();
                var revenueOutstanding = new List<object>();
                foreach (var o in Model.Orders.Where(o => !o.IsPaymentConfirmed && o.TotalAmount.HasValue && o.WeightConfirmedAt.HasValue && o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Abandoned && !o.IsAbandoned))
                {
                    var days = o.ReadyForDeliveryNotifiedAt.HasValue ? Math.Max(0, (int)Math.Floor((DateTime.UtcNow - o.ReadyForDeliveryNotifiedAt.Value.AddHours(24)).TotalDays)) : 0;
                    revenueOutstanding.Add(new {
                        orderNumber = o.OrderNumber,
                        customer = o.Customer != null ? o.Customer.FullName : "Unknown",
                        baseAmount = o.TotalAmount!.Value,
                        penalty = o.AccruedPenaltyAmount ?? 0m,
                        total = Math.Round((o.TotalAmount ?? 0m) + (o.AccruedPenaltyAmount ?? 0m), 2),
                        overdueDays = days,
                        bucket = days < 7 ? "current" : (days < 30 ? "7d+" : "30d+")
                    });
                }
                var revenueDeliveries = Model.Orders
                    .Where(o => o.Status == OrderStatus.Delivered)
                    .GroupBy(o => o.DeliveryRider != null ? o.DeliveryRider.FullName : "Unknown")
                    .Select(g => new { rider = g.Key, count = g.Count(), weight = Math.Round(g.Sum(o => o.WeightKg ?? 0m), 2) })
                    .OrderByDescending(x => x.count)
                    .ToList<object>();
            }
            @if (canRevenueView) {
            <script type="application/json" id="revenue-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { daily = revenueDaily, services = revenueServices, outstanding = revenueOutstanding, deliveries = revenueDeliveries }))
            </script>
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header" style="flex-wrap:wrap;gap:12px;">
                    <div class="card-header-left" style="flex-wrap:wrap;gap:10px;">
                        <div class="filter-chips" id="revenue-range-chips">
                            <span class="chip" data-range="7" onclick="setRevenueRange(7)">7 days</span>
                            <span class="chip active" data-range="30" onclick="setRevenueRange(30)">30 days</span>
                            <span class="chip" data-range="90" onclick="setRevenueRange(90)">90 days</span>
                        </div>
                        <div class="filter-row" style="margin-left:4px;">
                            <span class="filter-label">From:</span>
                            <input type="date" class="filter-date" id="revenue-date-from" />
                            <span class="filter-label">To:</span>
                            <input type="date" class="filter-date" id="revenue-date-to" />
                            <button class="btn btn-ghost btn-sm" onclick="applyRevenueCustomRange()" title="Apply custom range">Apply</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="stats-row" id="revenue-stats"></div>
                    <h3 style="margin:8px 0 12px;font-size:1rem;">Revenue by Day</h3>
                    <table class="data-table" aria-label="Revenue by day">
                        <thead><tr><th>Date</th><th>Paid Orders</th><th>Revenue</th></tr></thead>
                        <tbody id="revenue-daily-body"></tbody>
                    </table>
                    <div id="revenue-daily-empty" class="empty-state" style="display:none;">
                        <p>No paid orders in the selected range.</p>
                    </div>
                    <h3 style="margin:28px 0 12px;font-size:1rem;">Revenue by Service</h3>
                    <table class="data-table" aria-label="Revenue by service">
                        <thead><tr><th>Service</th><th>Revenue Share</th><th>% of Paid</th></tr></thead>
                        <tbody id="revenue-service-body"></tbody>
                    </table>
                    <h3 style="margin:28px 0 12px;font-size:1rem;">Outstanding Balances</h3>
                    <div class="stats-row" id="revenue-outstanding-stats" style="margin-bottom:12px;"></div>
                    <table class="data-table" aria-label="Outstanding balances">
                        <thead><tr><th>Order #</th><th>Customer</th><th>Base</th><th>Penalty</th><th>Total Due</th><th>Overdue</th><th>Bucket</th></tr></thead>
                        <tbody id="revenue-outstanding-body"></tbody>
                    </table>
                    <div id="revenue-outstanding-empty" class="empty-state" style="display:none;">
                        <p>No outstanding balances. All weighed orders are paid.</p>
                    </div>
                    <h3 style="margin:28px 0 12px;font-size:1rem;">Deliveries per Rider</h3>
                    <table class="data-table" aria-label="Deliveries per rider">
                        <thead><tr><th>Rider</th><th>Deliveries</th><th>Total Weight</th></tr></thead>
                        <tbody id="revenue-delivery-body"></tbody>
                    </table>
                    <div id="revenue-delivery-empty" class="empty-state" style="display:none;">
                        <p>No deliveries recorded yet.</p>
                    </div>
                </div>
            </div>
            }
            @if (canAuditView) {
            <div class="stats-row" id="audit-stats"></div>
            <div class="card">
                <div class="card-header">
                    <div class="card-header-left">
                        <div class="filter-chips" id="audit-chips">
                            <span class="chip active" data-action="all" onclick="filterAudit('all')">All</span>
                            <span class="chip" data-action="Add" onclick="filterAudit('Add')">Added</span>
                            <span class="chip" data-action="Update" onclick="filterAudit('Update')">Updated</span>
                            <span class="chip" data-action="Suspend" onclick="filterAudit('Suspend')">Suspended</span>
                            <span class="chip" data-action="Unsuspend" onclick="filterAudit('Unsuspend')">Unsuspended</span>
                            <span class="chip" data-action="Archive" onclick="filterAudit('Archive')">Archived</span>
                            <span class="chip" data-action="Restore" onclick="filterAudit('Restore')">Restored</span>
                            <span class="chip" data-action="Assign" onclick="filterAudit('Assign')">Assigned</span>
                            <span class="chip" data-action="Reassign" onclick="filterAudit('Reassign')">Reassigned</span>
                            <span class="chip" data-action="Payment" onclick="filterAudit('Payment')">Payments</span>
                            <span class="chip" data-action="Note" onclick="filterAudit('Note')">Notes</span>
                            <span class="chip" data-action="Refund" onclick="filterAudit('Refund')">Refunds</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <table class="data-table" id="audit-table" aria-label="Audit log">
                        <tbody id="audit-table-body"></tbody>
                    </table>
                    <div id="audit-empty" class="empty-state" style="display:none;">
                        <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        <p>No audit entries yet. Admin actions will appear here.</p>
                    </div>
                    <div id="audit-pagination"></div>
                </div>
            </div>
            }
        </div>

    </main>
</div>

<!-- MODAL: Walk-in Order -->
