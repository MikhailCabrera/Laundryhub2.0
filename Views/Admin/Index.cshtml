<script>
document.addEventListener('DOMContentLoaded', function () {
    if (window.SimplePager) {
        SimplePager.paginate('open-claims-body', 'open-claims-pagination', 10);
        SimplePager.paginate('resolved-claims-body', 'resolved-claims-pagination', 10);
