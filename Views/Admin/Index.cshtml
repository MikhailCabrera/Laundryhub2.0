/* ============================================================
   DATA STORE — live Identity users, serialized server-side into the
   #employee-data / #customer-data JSON blocks above. Snapshot is taken
   on each page load; suspend/unsuspend POST to the server and then
   reload the page so the tables always reflect database truth.
   (No demo data — the hardcoded array was removed.)
   ============================================================ */
const EMPLOYEE_ROLES = ['Admin','Manager','Staff','Rider'];
const CUSTOMER_ROLES = ['Customer'];
const AVATAR_COLORS = ['#4F46E5','#7C3AED','#0EA5E9','#10B981','#F59E0B','#EF4444','#EC4899','#14B8A6'];

function readUserData(elementId){
    const el = document.getElementById(elementId);
    if(!el) return [];
    try{
        const items = JSON.parse(el.textContent || '[]');
        return Array.isArray(items) ? items : [];
    }catch(e){ return []; }
}
const employees = readUserData('employee-data');
const customers = readUserData('customer-data');
// Tiered action gating flags — computed server-side with IAuthorizationService
// against the same named policies as the controllers. The [Authorize(Policy)]
// gates stay authoritative; these only hide forbidden controls entirely.
const LH_CAN_MANAGE_USERS = @(canUserManagement ? "true" : "false");
const LH_CAN_ADJUST_LOYALTY = @(canLoyaltyAdjust ? "true" : "false");
const LH_CAN_RESOLVE_CLAIMS = @(canClaimsResolve ? "true" : "false");
// TEMPORARY in-memory audit trail. Kept for display only until the persistent
// Reports / Audit Log module is built — do not treat as durable history.
let employeeFilter='all', customerFilter='all', auditFilter='all';
let employeeTableMgr = null;
let customerTableMgr = null;

/* ============================================================
   UTILITIES
   ============================================================ */
function avatarColor(n){let h=0;for(let c of n)h=c.charCodeAt(0)+((h<<5)-h);return AVATAR_COLORS[Math.abs(h)%AVATAR_COLORS.length];}
function initials(n){return n.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();}
function formatDate(d){return new Date(d).toLocaleDateString('en-PH',{year:'numeric',month:'short',day:'numeric'});}
function formatDT(d){return d.toLocaleString('en-PH',{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}
function escapeHtml(v){return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function roleBadge(r){const m={Admin:'role-admin',Manager:'role-manager',Staff:'role-staff',Rider:'role-rider',Customer:'role-customer'};return '<span class="role-badge '+( m[r]||'')+'">' +escapeHtml(r)+'</span>';}
function statusBadge(a){if(a.isArchived)return'<span class="status-badge status-archived">Archived</span>';if(a.isSuspended)return'<span class="status-badge status-suspended">Suspended</span>';return'<span class="status-badge status-active">Active</span>';}
function roleClass(r){return{Admin:'role-admin',Manager:'role-manager',Staff:'role-staff',Rider:'role-rider',Customer:'role-customer'}[r]||'';}
function actionLabel(a){return{Add:'added account for',Update:'updated account of',Archive:'archived account of',Suspend:'suspended account of',Unsuspend:'unsuspended account of'}[a]||a;}

/* ============================================================
   SIDEBAR
   ============================================================ */
function toggleAccountDropdown(){
    const btn=document.getElementById('nav-account-management');
    const kids=document.getElementById('nav-account-children');
    const open=kids.classList.contains('open');
    if(open){kids.style.maxHeight='0';kids.classList.remove('open');btn.classList.remove('open');btn.setAttribute('aria-expanded','false');}
    else{kids.style.maxHeight=kids.scrollHeight+'px';kids.classList.add('open');btn.classList.add('open');btn.setAttribute('aria-expanded','true');}
}

function showPanel(panel){
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    const panelEl = document.getElementById('panel-'+panel);
    if (!panelEl) return;
    panelEl.classList.add('active');
    document.querySelectorAll('.sidebar-nav-child,.sidebar-nav-item').forEach(c=>c.classList.remove('active'));
    if(panel==='dashboard'){document.getElementById('nav-dashboard').classList.add('active');renderDashboard();}
    else if(panel==='employees'){document.getElementById('nav-child-employees').classList.add('active');renderEmployeeTable();renderEmployeeStats();}
    else if(panel==='customers'){document.getElementById('nav-child-customers').classList.add('active');renderCustomerTable();renderCustomerStats();}
    else if(panel==='reports'){document.getElementById('nav-reports')?.classList.add('active');renderRevenue();renderAuditLog();renderAuditStats();}
    else if(panel==='orders'){document.getElementById('nav-orders').classList.add('active');filterOrders('all');}
    else if(panel==='billing'){document.getElementById('nav-billing').classList.add('active');renderBillingTable();}
    else if(panel==='inventory'){document.getElementById('nav-inventory').classList.add('active');renderInventoryPanel();}
    else if(panel==='pickup-delivery'){document.getElementById('nav-pickup-delivery').classList.add('active');renderPickupDelivery();}
    else if(panel==='tracking'){document.getElementById('nav-tracking').classList.add('active');renderTracking();}
    else if(panel==='crm'){document.getElementById('nav-crm').classList.add('active');renderCrm();}
    else if(panel==='loyalty'){document.getElementById('nav-loyalty').classList.add('active');renderLoyalty();}
}

/* ============================================================
   DASHBOARD
   ============================================================ */
const ORDER_STATS = {
    pending:   @Model.PendingOrdersCount,
    ongoing:   @Model.OngoingOrdersCount,
    payment:   @Model.AwaitingPaymentCount,
    completed: @Model.CompletedOrdersCount,
    customers: @Model.TotalCustomersCount,
    employees: @Model.TotalEmployeesCount
};

function renderDashboard(){
    document.getElementById('dash-pending').textContent   = ORDER_STATS.pending;
    document.getElementById('dash-ongoing').textContent   = ORDER_STATS.ongoing;
    document.getElementById('dash-payment').textContent   = ORDER_STATS.payment;
    document.getElementById('dash-completed').textContent = ORDER_STATS.completed;
    document.getElementById('dash-customers').textContent = ORDER_STATS.customers;
    document.getElementById('dash-employees').textContent = ORDER_STATS.employees;
}

/* ============================================================
   FILTER & SEARCH
   ============================================================ */
function buildEmployeeFilter(){
    const role   = employeeFilter;
    const status = document.getElementById('employee-status-filter')?.value || 'all';
    const from   = document.getElementById('employee-date-from')?.value;
    const to     = document.getElementById('employee-date-to')?.value;
    return item => {
        if(role !== 'all' && item.role !== role) return false;
        if(status === 'active'    && item.isSuspended)  return false;
        if(status === 'suspended' && !item.isSuspended) return false;
        const day = (item.createdAt || '').substring(0, 10);
        if(from && day < from) return false;
        if(to   && day > to)   return false;
        return true;
    };
}
function buildCustomerFilter(){
    const role   = customerFilter;
    const status = document.getElementById('customer-status-filter')?.value || 'all';
    const from   = document.getElementById('customer-date-from')?.value;
    const to     = document.getElementById('customer-date-to')?.value;
    return item => {
        if(role === 'active'    && item.isSuspended)  return false;
        if(role === 'suspended' && !item.isSuspended) return false;
        if(status === 'active'    && item.isSuspended)  return false;
        if(status === 'suspended' && !item.isSuspended) return false;
        const day = (item.createdAt || '').substring(0, 10);
        if(from && day < from) return false;
        if(to   && day > to)   return false;
        return true;
    };
}
function filterTable(type,role){
    if(type==='employees'){
        employeeFilter=role;
        document.querySelectorAll('#employee-role-chips .chip').forEach(c=>c.classList.toggle('active',c.dataset.role===role));
        if(employeeTableMgr) employeeTableMgr.setCustomFilter(buildEmployeeFilter());
    }else{
        customerFilter=role;
        document.querySelectorAll('#customer-role-chips .chip').forEach(c=>c.classList.toggle('active',c.dataset.role===role));
        if(customerTableMgr) customerTableMgr.setCustomFilter(buildCustomerFilter());
    }
}
function applyEmployeeFilters(){
    if(employeeTableMgr) employeeTableMgr.setCustomFilter(buildEmployeeFilter());
}
function applyCustomerFilters(){
    if(customerTableMgr) customerTableMgr.setCustomFilter(buildCustomerFilter());
}
function clearEmployeeFilters(){
    document.getElementById('employee-date-from').value='';
    document.getElementById('employee-date-to').value='';
    document.getElementById('employee-status-filter').value='all';
    applyEmployeeFilters();
}
function clearCustomerFilters(){
    document.getElementById('customer-date-from').value='';
    document.getElementById('customer-date-to').value='';
    document.getElementById('customer-status-filter').value='all';
    applyCustomerFilters();
}
function filterAudit(action){auditFilter=action;document.querySelectorAll('#audit-chips .chip').forEach(c=>c.classList.toggle('active',c.dataset.action===action));applyAuditFilter();}

/* ============================================================
   EMPLOYEE TABLE (with TableManager pagination & live search)
   ============================================================ */
function getEmployees(){return employees.filter(a=>EMPLOYEE_ROLES.includes(a.role));}

function renderEmployeeRow(a) {
    const safeId = escapeHtml(a.id);
    const userActions = LH_CAN_MANAGE_USERS ? `<div class="td-actions">
                <button class="btn btn-ghost btn-sm" onclick="openAccountModal('edit','${safeId}')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit
                </button>
                ${a.isArchived?`<button class="btn btn-success btn-sm" onclick="openArchiveUserModal('${safeId}')">Restore</button>`
                    :`<button class="btn btn-danger btn-sm" onclick="openArchiveUserModal('${safeId}')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/></svg> Archive
                    </button>`}
                ${a.isSuspended?`<button class="btn btn-success btn-sm" onclick="unsuspendAccount('${safeId}')">Unsuspend</button>`
                    :`<button class="btn btn-warning btn-sm" onclick="openSuspendModal('${safeId}')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg> Suspend
                    </button>`}
            </div>` : '<span style="font-size:0.75rem;color:var(--lh-text-muted);">—</span>';
    return `
        <tr>
            <td><div class="user-cell">
                <div class="user-avatar" style="background:${avatarColor(a.fullName || '?')}">${initials(a.fullName || '?')}</div>
                <div><div class="user-name">${escapeHtml(a.fullName)}</div><div class="user-email">${escapeHtml(a.email)}</div>
                ${a.isSuspended&&a.suspendNote?`<div class="user-email" style="color:#B45309;font-style:italic;margin-top:2px">Note: ${escapeHtml(a.suspendNote)}</div>`:''}
                </div></div></td>
            <td style="font-size:0.8125rem;">${escapeHtml(a.phoneNumber || '—')}</td>
            <td style="font-size:0.8125rem;">${escapeHtml(a.district || '—')}</td>
            <td>${roleBadge(a.role)}</td>
            <td>${statusBadge(a)}</td>
            <td style="font-size:0.8125rem;white-space:nowrap;">${formatDate(a.createdAt)}</td>
            <td>${userActions}</td>
        </tr>`;
}

function initEmployeeTable() {
    if (!employeeTableMgr) {
        employeeTableMgr = new TableManager({
            tableBodyId: 'employee-table-body',
            paginationContainerId: 'employee-pagination',
            emptyStateId: 'employee-empty',
            searchInputId: 'employee-search',
            pageSize: 10,
            renderRow: renderEmployeeRow,
            searchPredicate: (item, q) => ((item.fullName || '') + ' ' + (item.email || '') + ' ' + (item.phoneNumber || '') + ' ' + (item.district || '') + ' ' + (item.role || '')).toLowerCase().includes(q)
        });
    }
    employeeTableMgr.setData(getEmployees());
}

function renderEmployeeTable(){
    initEmployeeTable();
}

function renderEmployeeStats(){
    const e=getEmployees();const byR=EMPLOYEE_ROLES.reduce((a,r)=>({...a,[r]:e.filter(x=>x.role===r).length}),{});
    document.getElementById('employee-stats').innerHTML=`
        <div class="stat-card"><div class="stat-label">Total Employees</div><div class="stat-value">${e.length}</div></div>
        <div class="stat-card"><div class="stat-label">Active</div><div class="stat-value" style="color:var(--c-active)">${e.filter(x=>!x.isSuspended).length}</div></div>
