function filterBilling(status) {
    billingPaymentFilter = status;
    document.querySelectorAll('#billing-status-chips .chip').forEach(c => c.classList.toggle('active', c.dataset.paymentStatus === status));
    if (billingTableMgr) billingTableMgr.setCustomFilter(buildBillingFilter());
}

function buildBillingFilter() {
    const status = billingPaymentFilter;
    return item => {
        if (status === 'paid' && !item.isPaid) return false;
        if (status === 'unpaid' && item.isPaid) return false;
        return true;
    };
}

function renderBillingStats() {
    const statsElement = document.getElementById('billing-stats');
    if (!statsElement) return;
    const items = getBillingTransactions();
    const paidItems = items.filter(x => x.isPaid);
    const unpaidItems = items.filter(x => !x.isPaid);
    const outstanding = unpaidItems.reduce((sum, x) => sum + Number(x.totalDue || 0), 0);
    statsElement.innerHTML = `
        <div class="stat-card"><div class="stat-label">Billing Records</div><div class="stat-value">${items.length}</div><div class="stat-sub">Weight-confirmed orders</div></div>
        <div class="stat-card"><div class="stat-label">Paid</div><div class="stat-value" style="color:#059669">${paidItems.length}</div><div class="stat-sub">Payment confirmed</div></div>
        <div class="stat-card"><div class="stat-label">Unpaid</div><div class="stat-value" style="color:#DC2626">${unpaidItems.length}</div><div class="stat-sub">Outstanding transactions</div></div>
        <div class="stat-card"><div class="stat-label">Outstanding Balance</div><div class="stat-value" style="font-size:1.35rem;">${formatBillingPeso(outstanding)}</div><div class="stat-sub">Base amount plus penalty</div></div>`;
}

