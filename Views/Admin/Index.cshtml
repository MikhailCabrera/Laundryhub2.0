let trackingTableMgr = null;
let trackingLegs = [];
let trackingGroupFilter = 'all';
let trackingOverdueOnly = false;
const TRACK_WASH_OVERDUE_HOURS = 4;
const TRACK_DRY_OVERDUE_HOURS = 4;

function trackStageOverdue(item, nowMs){
    const now = nowMs || Date.now();
    const elapsedHours = start => {
        if(!start) return null;
        const ms = now - new Date(start).getTime();
        if(Number.isNaN(ms) || ms < 0) return null;
        return ms / 3600000;
    };
    const washHours = elapsedHours(item.washingStartedAt);
    if(washHours !== null && item.dryingStartedAt == null && washHours > TRACK_WASH_OVERDUE_HOURS)
        return { overdue:true, hours:Math.floor(washHours) };
    const dryHours = elapsedHours(item.dryingStartedAt);
    if(dryHours !== null && item.processingCompletedAt == null && dryHours > TRACK_DRY_OVERDUE_HOURS)
        return { overdue:true, hours:Math.floor(dryHours) };
    return { overdue:false, hours:0 };
}

function trackOverdueBadge(item){
    const info = trackStageOverdue(item);
    if(!info.overdue) return '';
    return '<div style="margin-top:4px;"><span class="ord-badge ord-awaiting-payment">Overdue ' + info.hours + 'h</span></div>';
}

function trackingGroup(status){
    if(status === 'WeightConfirmed' || status === 'Washing' || status === 'Drying' || status === 'PaymentConfirmed') return 'processing';
    if(status === 'AwaitingPayment') return 'payment';
    if(status === 'ReadyForDelivery' || status === 'OutForDelivery') return 'delivery';
    if(status === 'Delivered') return 'completed';
    return null;
}

