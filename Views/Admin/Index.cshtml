                    @if (Model.AvailableRiders.Any()) {
                        <select class="form-control" id="assign-rider-select" name="RiderId" required>
                            <option value="">-- Choose an available rider --</option>
                            @foreach (var rider in Model.AvailableRiders) {
                                <option value="@rider.Id">@rider.FullName — @(rider.PhoneNumber ?? "no number on file")</option>
                            }
                        </select>
                    } else {
                        <div style="padding:12px 14px;background:#FFFBEB;border:1px solid #FDE68A;border-radius:var(--lh-radius-md);font-size:0.875rem;color:#92400E;">
                            No active riders available. Please add riders in <strong>Employee Management</strong>.
                        </div>
                        <input type="hidden" name="RiderId" value="" />
