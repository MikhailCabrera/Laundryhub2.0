function pdStageBadge(status){
    const map = { RiderAssigned:'ord-badge ord-rider-assigned', PickedUp:'ord-badge ord-in-transit', InTransitToShop:'ord-badge ord-in-transit', OutForDelivery:'ord-badge ord-out-delivery', WeightConfirmed:'ord-badge ord-weighing', Washing:'ord-badge ord-washing', Drying:'ord-badge ord-drying', AwaitingPayment:'ord-badge ord-awaiting-payment', PaymentConfirmed:'ord-badge ord-payment-confirmed', ReadyForDelivery:'ord-badge ord-ready-delivery', Delivered:'ord-badge ord-delivered', Cancelled:'ord-badge ord-cancelled', Abandoned:'ord-badge ord-abandoned' };
    const labels = { RiderAssigned:'Rider Assigned', PickedUp:'Picked Up', InTransitToShop:'In Transit', OutForDelivery:'Out for Delivery', WeightConfirmed:'Weight Confirmed', Washing:'Washing', Drying:'Drying', AwaitingPayment:'Awaiting Payment', PaymentConfirmed:'Payment Confirmed', ReadyForDelivery:'Ready for Delivery', Delivered:'Delivered', Cancelled:'Cancelled', Abandoned:'Abandoned' };
    return '<span class="' + (map[status] || 'ord-badge ord-default') + '">' + escapeHtml(labels[status] || status) + '</span>';
}

function pdLegTime(status, item){
    if(status === 'RiderAssigned') return { caption:'Assigned', at:item.riderAssignedAt };
    if(status === 'OutForDelivery') return { caption:'Dispatched', at:item.deliveryAssignedAt };
    return { caption:'Picked up', at:item.pickedUpAt };
}

