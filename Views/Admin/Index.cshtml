    if(listName === 'pickup') pickupStageFilter = stage; else deliveryStageFilter = stage;
    const chipsId = listName === 'pickup' ? 'pickup-status-chips' : 'delivery-status-chips';
    document.querySelectorAll('#' + chipsId + ' .chip').forEach(c => { if(c.dataset.stage !== undefined) c.classList.toggle('active', c.dataset.stage === stage); });
    applyPickupDeliveryFilters();
}

