<!-- MODAL: Assign Pickup Rider -->
<div class="modal-overlay" id="modal-assign-rider" role="dialog" aria-modal="true" aria-labelledby="modal-assign-rider-title">
    <div class="modal" style="max-width:480px">
        <div class="modal-header">
            <h2 class="modal-title" id="modal-assign-rider-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:6px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Assign Pickup Rider
            </h2>
            <button class="modal-close" onclick="closeModal('modal-assign-rider')" aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form method="post" asp-controller="Admin" asp-action="AssignPickupRider" id="form-assign-rider">
            @Html.AntiForgeryToken()
            <input type="hidden" id="assign-rider-order-id" name="OrderId" value="" />
            <div class="modal-body">
                <div class="suspend-warning" style="background:#EFF6FF;border-color:#BFDBFE;color:#1E40AF;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Assigning a rider will change the order status to <strong>Rider Assigned</strong>. The customer will see the rider's name on their dashboard.</span>
                </div>
                <div class="form-group">
                    <label class="form-label" for="assign-rider-order-display">Order</label>
                    <input type="text" class="form-control" id="assign-rider-order-display" readonly style="background:var(--lh-blue-25);cursor:default;font-weight:700;color:var(--lh-blue-600);" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="assign-rider-select">Select Rider <span style="color:var(--c-danger)">*</span></label>
                    @if (Model.AvailableRiders.Any()) {
                        <select class="form-control" id="assign-rider-select" name="RiderId" required>
                            <option value="">-- Choose an available rider --</option>
                            @foreach (var rider in Model.AvailableRiders) {
                                <option value="@rider.Id">@rider.FullName — @(rider.PhoneNumber ?? "no number on file")</option>
                            }
                        </select>
                    } else {
                        <div style="padding:12px 14px;background:#FFFBEB;border:1px solid #FDE68A;border-radius:var(--lh-radius-md);font-size:0.875rem;color:#92400E;">
                            No active riders available. Please add riders in <strong>Employee Management</strong>.
                        </div>
                        <input type="hidden" name="RiderId" value="" />
                    }
                    <span class="form-error" id="err-assign-rider"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modal-assign-rider')">Cancel</button>
                @if (Model.AvailableRiders.Any()) {
                    <button type="submit" class="btn btn-primary" id="btn-confirm-assign">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Assign Rider
                    </button>
                }
            </div>
        </form>
    </div>
</div>

