/* ============================================================
   SUSPEND / UNSUSPEND — server-backed. POSTs to Admin/SuspendUser or
   Admin/UnsuspendUser (which update AspNetUsers), then reloads the page
   on the same tab so the tables re-render from database truth.
   NOTE: Add / Edit / Archive have no backend yet — their demo-only UI and
   logic were removed in this iteration rather than left pretending to work.
   ============================================================ */
function findUserById(id){
    return employees.find(x=>x.id===id) || customers.find(x=>x.id===id) || null;
}
function userTabFor(a){
    return CUSTOMER_ROLES.includes(a.role) ? 'customers' : 'employees';
}
function antiForgeryToken(){
    const el = document.querySelector('#modal-suspend input[name="__RequestVerificationToken"]')
            || document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
async function postUserAction(url, params){
    const body = new URLSearchParams(params);
    body.append('__RequestVerificationToken', antiForgeryToken());
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
        body: body.toString()
    });
    if(!res.ok){
        let message = 'Server returned HTTP ' + res.status;
        try{ const errData = await res.json(); if(errData && errData.message) message = errData.message; }catch(_){}
        throw new Error(message);
    }
    return await res.json();
}
function openSuspendModal(id){
    if(!LH_CAN_MANAGE_USERS) return;
    const host=document.getElementById('suspend-id');if(!host) return;
    const a=findUserById(id);if(!a)return;
    host.value=a.id;
    document.getElementById('suspend-target-name').value=a.fullName+' ('+a.email+')';
    document.getElementById('suspend-note').value='';
    document.getElementById('err-suspend-note').textContent='';
    openModal('modal-suspend');
}
async function confirmSuspend(){
    const id=document.getElementById('suspend-id').value;
    const note=document.getElementById('suspend-note').value.trim();
    if(!note){document.getElementById('err-suspend-note').textContent='A suspension reason is required.';return;}
    const a=findUserById(id);if(!a)return;
    try{
        const data = await postUserAction('/Admin/SuspendUser', { UserId: id, SuspendNote: note });
        if(!data || !data.success) throw new Error((data && data.message) || 'Suspension failed.');
        closeModal('modal-suspend');
        window.location.href = '/Admin/Index?tab=' + userTabFor(a);
    }catch(err){
        document.getElementById('err-suspend-note').textContent = err.message || 'Suspension failed. Please try again.';
    }
}
async function unsuspendAccount(id){
    const a=findUserById(String(id));if(!a)return;
    if(!confirm('Unsuspend ' + a.fullName + ' (' + a.email + ')? They will regain access.')) return;
    try{
        const data = await postUserAction('/Admin/UnsuspendUser', { UserId: a.id });
        if(!data || !data.success) throw new Error((data && data.message) || 'Unsuspend failed.');
        window.location.href = '/Admin/Index?tab=' + userTabFor(a);
    }catch(err){
        alert(err.message || 'Unsuspend failed. Please try again.');
    }
}
const ACCOUNT_ROLES = ['Admin','Manager','Staff','Rider','Customer'];
function openAccountModal(mode, id){
    if(!LH_CAN_MANAGE_USERS) return;
    if(!document.getElementById('acc-user-id')) return;
    document.getElementById('acc-user-id').value='';
    document.getElementById('acc-fullname').value='';
    document.getElementById('acc-email').value='';
    document.getElementById('acc-password').value='';
    document.getElementById('acc-note').value='';
    document.getElementById('err-account').textContent='';
    const isEdit = mode === 'edit';
    const a = isEdit ? findUserById(String(id)) : null;
    if(isEdit && !a) return;
    document.getElementById('acc-mode').value = isEdit ? 'edit' : 'create';
    document.getElementById('modal-account-title').textContent = isEdit ? 'Edit Account' : (mode === 'add-customer' ? 'Add Customer' : 'Add Employee');
    document.getElementById('acc-submit').textContent = isEdit ? 'Save Changes' : 'Create Account';
    document.getElementById('acc-role').value = isEdit ? a.role : (mode === 'add-customer' ? 'Customer' : 'Staff');
    if(isEdit){
        document.getElementById('acc-user-id').value = a.id;
        document.getElementById('acc-fullname').value = a.fullName || '';
        document.getElementById('acc-email').value = a.email || '';
    }
    document.getElementById('acc-password-row').style.display = isEdit ? 'none' : '';
    document.getElementById('acc-note-row').style.display = isEdit ? 'none' : '';
    openModal('modal-account');
}
async function confirmAccount(){
    const errEl = document.getElementById('err-account');
    errEl.textContent='';
    const isEdit = document.getElementById('acc-mode').value === 'edit';
    const name = document.getElementById('acc-fullname').value.trim();
    const email = document.getElementById('acc-email').value.trim();
    const role = document.getElementById('acc-role').value;
    if(name.length < 2){ errEl.textContent='Full name must be at least 2 characters.'; return; }
    if(!/.+@@.+\..+/.test(email)){ errEl.textContent='Please enter a valid email address.'; return; }
    if(!ACCOUNT_ROLES.includes(role)){ errEl.textContent='Please select a valid role.'; return; }
    const params = { FullName: name, Email: email, Role: role };
    let url = '/Admin/EditUser';
    if(!isEdit){
        const password = document.getElementById('acc-password').value;
        if(password.length < 6){ errEl.textContent='Password must be at least 6 characters.'; return; }
        params.Password = password;
        params.SuspendNote = document.getElementById('acc-note').value.trim();
        url = '/Admin/CreateUser';
    }else{
        params.UserId = document.getElementById('acc-user-id').value;
    }
    try{
        const data = await postUserAction(url, params);
        if(!data || !data.success) throw new Error((data && data.message) || 'Save failed.');
        closeModal('modal-account');
        window.location.href = '/Admin/Index?tab=' + (role === 'Customer' ? 'customers' : 'employees');
    }catch(err){
        errEl.textContent = err.message || 'Save failed. Please try again.';
    }
}
function openArchiveUserModal(id){
    if(!LH_CAN_MANAGE_USERS) return;
    if(!document.getElementById('arc-user-id')) return;
    const a=findUserById(String(id));if(!a)return;
    document.getElementById('arc-user-id').value=a.id;
    document.getElementById('arc-is-archived').value=a.isArchived ? 'false' : 'true';
    document.getElementById('err-archive-user').textContent='';
    document.getElementById('modal-archive-user-title').textContent = a.isArchived ? 'Restore Account' : 'Archive Account';
    document.getElementById('arc-submit').textContent = a.isArchived ? 'Restore Account' : 'Archive Account';
    document.getElementById('archive-user-text').textContent = a.isArchived
        ? 'Restore ' + a.fullName + ' (' + a.email + ')? They will reappear in the active lists.'
        : 'Archive ' + a.fullName + ' (' + a.email + ')? They will be hidden from the active lists, but their data and history are preserved.';
    openModal('modal-archive-user');
}
async function confirmArchiveUser(){
    const errEl = document.getElementById('err-archive-user');
    errEl.textContent='';
    const id = document.getElementById('arc-user-id').value;
    const a = findUserById(id);
    try{
        const data = await postUserAction('/Admin/SetUserArchived', { UserId: id, IsArchived: document.getElementById('arc-is-archived').value });
        if(!data || !data.success) throw new Error((data && data.message) || 'Archive failed.');
        closeModal('modal-archive-user');
        window.location.href = '/Admin/Index?tab=' + (a ? userTabFor(a) : 'employees');
    }catch(err){
        errEl.textContent = err.message || 'Archive failed. Please try again.';
    }
}
async function submitClaim(){
    const errEl = document.getElementById('err-claim');
    errEl.textContent = '';
    const orderNumber = document.getElementById('claim-order-number').value.trim();
    const type = document.getElementById('claim-type').value;
    const description = document.getElementById('claim-description').value.trim();
    if(!orderNumber){ errEl.textContent = 'Please enter an order number.'; return; }
    if(!description){ errEl.textContent = 'Please describe the damage or loss.'; return; }
    try{
        const data = await postUserAction('/Admin/FileClaim', { OrderNumber: orderNumber, Type: type, Description: description });
        if(!data || !data.success) throw new Error((data && data.message) || 'Filing failed.');
        window.location.href = '/Admin/Index?tab=orders';
    }catch(err){
        errEl.textContent = err.message || 'Filing failed. Please try again.';
    }
}
async function resolveClaim(claimId){
    if(!LH_CAN_RESOLVE_CLAIMS) return;
    const errEl = document.getElementById('err-claim-' + claimId);
    const statusEl = document.getElementById('claim-status-' + claimId);
    const noteEl = document.getElementById('claim-note-' + claimId);
    if(!errEl || !statusEl || !noteEl) return;
    errEl.textContent = '';
    const note = (noteEl.value || '').trim();
    if(!note){ errEl.textContent = 'A resolution note is required.'; return; }
    try{
        const data = await postUserAction('/Admin/ResolveClaim', { ClaimId: claimId, Status: statusEl.value, ResolutionNote: note });
        if(!data || !data.success) throw new Error((data && data.message) || 'Resolve failed.');
        window.location.href = '/Admin/Index?tab=orders';
    }catch(err){
        errEl.textContent = err.message || 'Resolve failed. Please try again.';
    }
}

/* ============================================================
   MODAL HELPERS
   ============================================================ */
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
function showError(id,msg){document.getElementById(id).textContent=msg;}
function clearModalErrors(){document.querySelectorAll('.form-error').forEach(e=>e.textContent='');document.querySelectorAll('.form-control').forEach(e=>e.classList.remove('error'));}

document.querySelectorAll('.modal-overlay').forEach(o=>{
    o.addEventListener('click',function(e){if(e.target===this)closeModal(this.id);});
});
document.addEventListener('keydown',function(e){
    if(e.key==='Escape')document.querySelectorAll('.modal-overlay.open').forEach(m=>closeModal(m.id));
});

