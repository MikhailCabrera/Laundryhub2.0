                </div>
                <div class="form-group">
                    <label class="form-label" for="assign-rider-order-display">Order</label>
                    <input type="text" class="form-control" id="assign-rider-order-display" readonly style="background:var(--lh-blue-25);cursor:default;font-weight:700;color:var(--lh-blue-600);" />
