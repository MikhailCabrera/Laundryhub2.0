            <td>${crmSegmentBadge(segment)}${c.isArchived ? ' <span class="status-badge status-archived">Archived</span>' : (c.isSuspended ? ' <span class="status-badge status-suspended">Suspended</span>' : '')}</td>
            <td><span class="pd-crm-chevron" id="pd-crm-${escapeHtml(c.id)}">▸</span></td>
        </tr>
