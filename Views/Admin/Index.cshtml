        @{
            var loyaltyNow = DateTime.UtcNow;
            var loyaltyCutoff = loyaltyNow.AddDays(30);
            var loyaltyMembers = Model.Customers.Select(c => {
                var tx = Model.LoyaltyTransactions.Where(t => t.CustomerId == c.Id).ToList();
                var bal = tx.Where(t => !(t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Earn && t.ExpiresAt != null && t.ExpiresAt < loyaltyNow)).Sum(t => (int?)t.Points) ?? 0;
                var earned = tx.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Earn).Sum(t => (int?)t.Points) ?? 0;
                var redeemed = tx.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Redeem).Sum(t => (int?)t.Points) ?? 0;
                var adjusted = tx.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Adjust).Sum(t => (int?)t.Points) ?? 0;
                var expiring = tx.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Earn && t.ExpiresAt != null && t.ExpiresAt >= loyaltyNow && t.ExpiresAt <= loyaltyCutoff).Sum(t => (int?)t.Points) ?? 0;
                var last = tx.Select(t => (DateTime?)t.CreatedAt).Max();
                return new {
                    id = c.Id,
                    fullName = c.FullName,
                    email = c.Email,
                    balance = bal,
                    lifetimeEarned = earned,
                    lifetimeRedeemed = redeemed,
                    lifetimeAdjusted = adjusted,
                    expiringSoon = expiring,
                    isExpiringSoon = expiring > 0,
                    hasBalance = bal > 0,
                    lastActivity = JsonUtc(last)
                };
            }).OrderByDescending(m => m.balance).ThenBy(m => m.fullName).ToList();
            var loyaltyPointsIssued = Model.LoyaltyTransactions.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Earn).Sum(t => (int?)t.Points) ?? 0;
            var loyaltyPointsRedeemed = Model.LoyaltyTransactions.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Redeem).Sum(t => (int?)t.Points) ?? 0;
            var loyaltyPointsAdjusted = Model.LoyaltyTransactions.Where(t => t.Type == LaundryHub2._0.Models.LoyaltyTransactionType.Adjust).Sum(t => (int?)t.Points) ?? 0;
            var loyaltyLiability = loyaltyMembers.Sum(m => m.balance);
            var loyaltyLiabilityPeso = Math.Round(loyaltyLiability * 0.1m, 2);
            var loyaltyExpiringPoints = loyaltyMembers.Sum(m => m.expiringSoon);
            var loyaltyWithBalance = loyaltyMembers.Count(m => m.balance > 0);
            var loyaltyExpiringCount = loyaltyMembers.Count(m => m.isExpiringSoon);
            var loyaltyTotals = new {
                totalMembers = loyaltyMembers.Count,
                membersWithBalance = loyaltyWithBalance,
                pointsIssued = loyaltyPointsIssued,
                pointsRedeemed = loyaltyPointsRedeemed,
                pointsAdjusted = loyaltyPointsAdjusted,
                outstandingLiability = loyaltyLiability,
                liabilityPeso = loyaltyLiabilityPeso,
                expiringSoonPoints = loyaltyExpiringPoints
            };
        }
