    if(!el) return null;
    try{
        const data = JSON.parse(el.textContent || 'null');
        return data && typeof data === 'object' ? data : null;
    }catch(e){ return null; }
}
function loyaltyPesoFromPoints(pts){
    return '₱' + (Number(pts || 0) * 0.1).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function loyaltyDateText(iso){
    if(!iso) return '—';
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? '—' : formatDate(d.toISOString());
}
function renderLoyaltyRow(m){
    const safeId = escapeHtml(m.id);
    const balancePeso = loyaltyPesoFromPoints(m.balance);
    const redeemedAbs = Math.abs(Number(m.lifetimeRedeemed || 0));
    const expiringCell = (Number(m.expiringSoon || 0) > 0)
        ? '<div style="font-weight:700;color:#B45309;white-space:nowrap;">' + Number(m.expiringSoon).toLocaleString('en-US') + ' pts</div><span class="ord-badge ord-in-transit">Expiring soon</span>'
        : '<span style="color:var(--lh-text-muted);font-size:0.8125rem;">—</span>';
    const balanceBadge = (Number(m.balance || 0) > 0) ? ' <span class="status-badge status-active">With balance</span>' : '';
    return `
        <tr>
            <td><div class="user-cell">
                <div class="user-avatar" style="background:${avatarColor(m.fullName || '?')}">${initials(m.fullName || '?')}</div>
                <div><div class="user-name">${escapeHtml(m.fullName)}</div><div class="user-email">${escapeHtml(m.email)}</div></div>
            </div></td>
            <td><div style="font-weight:700;color:var(--lh-text-headings);white-space:nowrap;">${Number(m.balance || 0).toLocaleString('en-US')} pts</div><div class="user-email">${escapeHtml(balancePeso)}</div>${balanceBadge}</td>
            <td style="font-weight:600;white-space:nowrap;">+${Number(m.lifetimeEarned || 0).toLocaleString('en-US')}</td>
            <td style="font-weight:600;white-space:nowrap;">${redeemedAbs > 0 ? '−' + redeemedAbs.toLocaleString('en-US') : '—'}</td>
            <td>${expiringCell}</td>
            <td style="font-size:0.8125rem;white-space:nowrap;">${escapeHtml(loyaltyDateText(m.lastActivity))}</td>
            <td>${LH_CAN_ADJUST_LOYALTY ? `<div class="td-actions">
                <button class="btn btn-ghost btn-sm" onclick="openLoyaltyAdjust('${safeId}')">Adjust</button>
            </div>` : '<span style="font-size:0.75rem;color:var(--lh-text-muted);">—</span>'}</td>
        </tr>`;
}
function initLoyaltyTable(){
    if(!loyaltyTableMgr){
        loyaltyTableMgr = new TableManager({
            tableBodyId: 'loyalty-table-body',
            paginationContainerId: 'loyalty-pagination',
            emptyStateId: 'loyalty-empty',
            searchInputId: 'loyalty-search',
            pageSize: 10,
            renderRow: renderLoyaltyRow,
            searchPredicate: (item, q) => ((item.fullName || '') + ' ' + (item.email || '')).toLowerCase().includes(q)
        });
    }
    loyaltyMembers = getLoyaltyMembers();
    loyaltyTotals = getLoyaltyTotals();
    loyaltyTableMgr.setData(loyaltyMembers);
    applyLoyaltyFilter();
    renderLoyaltyStats();
}
function buildLoyaltyFilter(){
    return item => {
        if(loyaltyFilter === 'balance' && !(Number(item.balance || 0) > 0)) return false;
        if(loyaltyFilter === 'expiring' && !item.isExpiringSoon) return false;
        return true;
    };
}
function applyLoyaltyFilter(){
    if(loyaltyTableMgr) loyaltyTableMgr.setCustomFilter(buildLoyaltyFilter());
}
function filterLoyalty(f){
    loyaltyFilter = f;
    document.querySelectorAll('#loyalty-chips .chip').forEach(c => c.classList.toggle('active', c.dataset.loyalty === f));
    applyLoyaltyFilter();
}
function renderLoyaltyStats(){
    const statsElement = document.getElementById('loyalty-stats');
    if(!statsElement) return;
    const t = loyaltyTotals || { totalMembers: loyaltyMembers.length, membersWithBalance: loyaltyMembers.filter(x => Number(x.balance || 0) > 0).length, pointsIssued: 0, pointsRedeemed: 0, pointsAdjusted: 0, outstandingLiability: 0, liabilityPeso: 0, expiringSoonPoints: 0 };
    const redeemedAbs = Math.abs(Number(t.pointsRedeemed || 0));
    statsElement.innerHTML = `
        <div class="stat-card"><div class="stat-label">Members With Balance</div><div class="stat-value">${Number(t.membersWithBalance || 0).toLocaleString('en-US')}</div><div class="stat-sub">of ${Number(t.totalMembers || 0).toLocaleString('en-US')} members</div></div>
        <div class="stat-card"><div class="stat-label">Outstanding Liability</div><div class="stat-value">${Number(t.outstandingLiability || 0).toLocaleString('en-US')} pts</div><div class="stat-sub">${escapeHtml(loyaltyPesoFromPoints(t.outstandingLiability))} at 100 pts = ₱10</div></div>
        <div class="stat-card"><div class="stat-label">Points Issued</div><div class="stat-value" style="color:var(--lh-blue-600)">${Number(t.pointsIssued || 0).toLocaleString('en-US')}</div><div class="stat-sub">Lifetime earned</div></div>
        <div class="stat-card"><div class="stat-label">Points Redeemed</div><div class="stat-value" style="color:#059669">${redeemedAbs.toLocaleString('en-US')}</div><div class="stat-sub">Lifetime redeemed</div></div>
        <div class="stat-card"><div class="stat-label">Points Adjusted</div><div class="stat-value">${Number(t.pointsAdjusted || 0).toLocaleString('en-US')}</div><div class="stat-sub">Manual adjustments</div></div>
        <div class="stat-card"><div class="stat-label">Expiring ≤30 Days</div><div class="stat-value" style="color:#B45309">${Number(t.expiringSoonPoints || 0).toLocaleString('en-US')} pts</div><div class="stat-sub">Earn rows expiring soon</div></div>`;
}
function renderLoyalty(){
    initLoyaltyTable();
}
function openLoyaltyAdjust(id){
    if(!LH_CAN_ADJUST_LOYALTY) return;
    const modalHost = document.getElementById('loyalty-adjust-id');
    if(!modalHost) return;
    const m = (loyaltyMembers && loyaltyMembers.length ? loyaltyMembers : getLoyaltyMembers()).find(x => String(x.id) === String(id));
    if(!m) return;
    modalHost.value = m.id;
    document.getElementById('loyalty-adjust-display').value = (m.fullName || '') + ' (' + (m.email || '') + ') — ' + Number(m.balance || 0) + ' pts';
    document.getElementById('loyalty-adjust-points').value = '';
    document.getElementById('loyalty-adjust-reason').value = '';
    document.getElementById('err-loyalty-adjust').textContent = '';
    openModal('modal-loyalty-adjust');
}
async function submitLoyaltyAdjust(){
    const errEl = document.getElementById('err-loyalty-adjust');
    errEl.textContent = '';
    const customerId = document.getElementById('loyalty-adjust-id').value;
    const pointsRaw = document.getElementById('loyalty-adjust-points').value;
    const reason = (document.getElementById('loyalty-adjust-reason').value || '').trim();
    const points = parseInt(pointsRaw, 10);
    if(!customerId){ errEl.textContent = 'Customer is required.'; return; }
    if(!Number.isInteger(points) || points === 0){ errEl.textContent = 'Points must be a non-zero whole number.'; return; }
    if(reason.length < 2){ errEl.textContent = 'Reason is required (min 2 characters).'; return; }
    try{
        const data = await postUserAction('/Admin/AdjustLoyaltyPoints', { CustomerId: customerId, Points: points, Reason: reason });
        if(!data || !data.success) throw new Error((data && data.message) || 'Adjustment failed.');
        closeModal('modal-loyalty-adjust');
        window.location.href = '/Admin/Index?tab=loyalty';
    }catch(err){
        errEl.textContent = err.message || 'Adjustment failed. Please try again.';
    }
}

let revenueRangeDays = 30;
let revenueCustomFrom = '';
let revenueCustomTo = '';

function revenuePeso(value){
    return '₱' + Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function revenueTodayKey(){
    return new Date().toISOString().slice(0, 10);
}

function revenueAddDays(key, delta){
    const d = new Date(key + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + delta);
    return d.toISOString().slice(0, 10);
}

function getRevenueData(){
    const el = document.getElementById('revenue-data');
    if(!el) return { daily: [], services: [], outstanding: [], deliveries: [] };
    try{
        const data = JSON.parse(el.textContent || '{}');
        return {
            daily: Array.isArray(data.daily) ? data.daily : [],
            services: Array.isArray(data.services) ? data.services : [],
            outstanding: Array.isArray(data.outstanding) ? data.outstanding : [],
            deliveries: Array.isArray(data.deliveries) ? data.deliveries : []
        };
    }catch(error){
        return { daily: [], services: [], outstanding: [], deliveries: [] };
    }
}

function setRevenueRange(days){
    revenueRangeDays = days;
    revenueCustomFrom = '';
    revenueCustomTo = '';
    document.getElementById('revenue-date-from').value = '';
    document.getElementById('revenue-date-to').value = '';
    document.querySelectorAll('#revenue-range-chips .chip').forEach(c => c.classList.toggle('active', Number(c.dataset.range) === days));
    renderRevenue();
}

function applyRevenueCustomRange(){
    const from = document.getElementById('revenue-date-from').value || '';
    const to = document.getElementById('revenue-date-to').value || '';
    if(!from && !to) return;
    revenueCustomFrom = from;
    revenueCustomTo = to;
    document.querySelectorAll('#revenue-range-chips .chip').forEach(c => c.classList.remove('active'));
    renderRevenue();
}

function revenueInRange(dateKey){
    if(revenueCustomFrom || revenueCustomTo){
        if(revenueCustomFrom && dateKey < revenueCustomFrom) return false;
        if(revenueCustomTo && dateKey > revenueCustomTo) return false;
        return true;
    }
    const start = revenueAddDays(revenueTodayKey(), -(revenueRangeDays - 1));
    return dateKey >= start;
}

function renderRevenue(){
    const data = getRevenueData();
    const days = data.daily.filter(d => revenueInRange(d.date));
    const total = days.reduce((sum, d) => sum + Number(d.amount || 0), 0);
    const count = days.reduce((sum, d) => sum + Number(d.count || 0), 0);
    const span = revenueCustomFrom || revenueCustomTo ? 'custom range' : 'last ' + revenueRangeDays + ' days';
    const statsElement = document.getElementById('revenue-stats');
    if(statsElement){
        statsElement.innerHTML = `
            <div class="stat-card"><div class="stat-label">Revenue (${span})</div><div class="stat-value" style="font-size:1.35rem;">${revenuePeso(total)}</div><div class="stat-sub">Paid orders, net of discounts</div></div>
            <div class="stat-card"><div class="stat-label">Paid Orders</div><div class="stat-value">${count}</div><div class="stat-sub">In range</div></div>
            <div class="stat-card"><div class="stat-label">Avg / Day</div><div class="stat-value" style="font-size:1.35rem;">${revenuePeso(days.length ? total / days.length : 0)}</div><div class="stat-sub">Across active days</div></div>`;
    }
    const dailyBody = document.getElementById('revenue-daily-body');
    const dailyEmpty = document.getElementById('revenue-daily-empty');
    if(dailyBody){
        dailyBody.innerHTML = days.map(d => `<tr><td style="font-weight:600;">${escapeHtml(d.date)}</td><td>${d.count}</td><td style="font-weight:700;">${revenuePeso(d.amount)}</td></tr>`).join('');
        if(dailyEmpty) dailyEmpty.style.display = days.length ? 'none' : 'flex';
    }
    const serviceTotal = data.services.reduce((sum, s) => sum + Number(s.amount || 0), 0);
    const serviceBody = document.getElementById('revenue-service-body');
    if(serviceBody){
        serviceBody.innerHTML = data.services.map(s => {
            const pct = serviceTotal > 0 ? (Number(s.amount || 0) / serviceTotal * 100) : 0;
            return `<tr><td><div class="user-name">${escapeHtml(s.service)}</div></td><td style="font-weight:700;">${revenuePeso(s.amount)}</td><td>${pct.toFixed(1)}%</td></tr>`;
        }).join('');
    }
    const bucketTotals = { current: 0, '7d+': 0, '30d+': 0 };
    data.outstanding.forEach(o => { if(bucketTotals[o.bucket] !== undefined) bucketTotals[o.bucket] += Number(o.total || 0); });
    const outStats = document.getElementById('revenue-outstanding-stats');
    if(outStats){
        outStats.innerHTML = `
            <div class="stat-card"><div class="stat-label">Current</div><div class="stat-value" style="font-size:1.25rem;">${revenuePeso(bucketTotals.current)}</div></div>
            <div class="stat-card"><div class="stat-label">7d+ Overdue</div><div class="stat-value" style="font-size:1.25rem;color:#D97706;">${revenuePeso(bucketTotals['7d+'])}</div></div>
            <div class="stat-card"><div class="stat-label">30d+ Overdue</div><div class="stat-value" style="font-size:1.25rem;color:#DC2626;">${revenuePeso(bucketTotals['30d+'])}</div></div>`;
    }
    const outBody = document.getElementById('revenue-outstanding-body');
    const outEmpty = document.getElementById('revenue-outstanding-empty');
    if(outBody){
        outBody.innerHTML = data.outstanding.map(o => `<tr>
            <td><span style="font-weight:700;color:var(--lh-blue-600);font-size:0.825rem;">${escapeHtml(o.orderNumber)}</span></td>
            <td><div class="user-name">${escapeHtml(o.customer)}</div></td>
            <td>${revenuePeso(o.baseAmount)}</td>
            <td>${revenuePeso(o.penalty)}</td>
            <td style="font-weight:700;">${revenuePeso(o.total)}</td>
            <td style="font-size:0.8125rem;">${o.overdueDays > 0 ? o.overdueDays + 'd' : '—'}</td>
            <td><span class="ord-badge ${o.bucket === 'current' ? 'ord-payment-confirmed' : (o.bucket === '7d+' ? 'ord-in-transit' : 'ord-awaiting-payment')}">${escapeHtml(o.bucket)}</span></td>
        </tr>`).join('');
        if(outEmpty) outEmpty.style.display = data.outstanding.length ? 'none' : 'flex';
    }
    const delBody = document.getElementById('revenue-delivery-body');
    const delEmpty = document.getElementById('revenue-delivery-empty');
    if(delBody){
        delBody.innerHTML = data.deliveries.map(d => `<tr>
            <td><div class="user-name">${escapeHtml(d.rider)}</div></td>
            <td style="font-weight:600;">${d.count}</td>
            <td>${Number(d.weight || 0).toFixed(2)} kg</td>
        </tr>`).join('');
        if(delEmpty) delEmpty.style.display = data.deliveries.length ? 'none' : 'flex';
    }
}

/* ============================================================
   PAGE INIT
   ============================================================ */
document.addEventListener('DOMContentLoaded', function() {
    const activeTab = '@(ViewData["ActiveTab"] ?? "dashboard")';
    if (activeTab && activeTab !== 'dashboard') {
        // Switch to the right panel without animation flicker
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        const target = document.getElementById('panel-' + activeTab);
        if (target) target.classList.add('active');
        showPanel(activeTab);
    } else {
        renderDashboard();
    }
});
</script>
</body>
</html>
