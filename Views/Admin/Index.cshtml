            <input type="text" class="form-control" id="crm-note-input-${escapeHtml(c.id)}" maxlength="1000" placeholder="Add a note about this customer..." style="flex:1;" />
            <button type="button" class="btn btn-primary btn-sm" onclick="submitCustomerNote('${escapeHtml(c.id)}')">Add Note</button>
        </div>
        <span class="form-error" id="crm-note-error-${escapeHtml(c.id)}"></span>`;
    wrap.style.display = '';
    const chev = document.getElementById('pd-crm-' + id);
    if(chev) chev.textContent = '▾';
}

function renderCrmNotes(c){
    const notes = c.notes || [];
    if(!notes.length) return '<p style="color:var(--lh-text-muted);font-size:0.85rem;margin:0;">No notes yet.</p>';
    return notes.map(n => `
