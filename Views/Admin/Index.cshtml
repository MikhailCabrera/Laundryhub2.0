                            <div class="empty-state" style="padding:28px 20px;">
                                <p>All stocked items are above their low-stock thresholds.</p>
                            </div>
                        } else {
                            <table class="data-table" aria-label="Low stock items">
                                <thead><tr><th>Item</th><th>Stock / Threshold</th><th>% Full</th><th>Status</th></tr></thead>
                                <tbody>
                                    @foreach (var item in lowInventoryItems) {
                                        var fillPct = item.MaxCapacity > 0 ? Math.Min(100m, Math.Max(0m, item.CurrentStock / item.MaxCapacity * 100m)) : 0m;
                                        var isOut = item.CurrentStock <= 0;
                                        <tr>
                                            <td><div class="user-name">@item.Name</div><div class="user-email">@item.Unit</div></td>
                                            <td style="font-weight:600;">@item.CurrentStock.ToString("0.##") / @item.LowStockThreshold.ToString("0.##") @item.Unit</td>
                                            <td>@fillPct.ToString("0")%</td>
                                            <td>@if (isOut) { <span class="ord-badge ord-awaiting-payment">Out of stock</span> } else { <span class="status-badge status-suspended">Low stock</span> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
