@model LaundryHub2._0.Models.AdminDashboardViewModel
@using LaundryHub2._0.Models
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using Microsoft.Extensions.Options
@inject IOptions<LaundryHub2._0.Models.MapSettings> MapSettingsOptions
@{
    Layout = null;
    ViewData["Title"] = "Admin | Laundry Hub Davao City";

    // ── Razor helper functions ──────────────────────────────────────────────
    string OrderInitials(string? n) {
        if (string.IsNullOrEmpty(n)) return "?";
        return string.Concat(n.Split(' ').Take(2).Where(p => p.Length > 0).Select(p => char.ToUpper(p[0])));
    }
    string OrderStatusBadgeClass(OrderStatus s) => s switch {
        OrderStatus.Pending         => "ord-badge ord-pending",
        OrderStatus.RiderAssigned   => "ord-badge ord-rider-assigned",
        OrderStatus.PickedUp        => "ord-badge ord-in-transit",
        OrderStatus.InTransitToShop => "ord-badge ord-in-transit",
        OrderStatus.Weighing        => "ord-badge ord-weighing",
        OrderStatus.WeightConfirmed => "ord-badge ord-weighing",
        OrderStatus.Washing         => "ord-badge ord-washing",
        OrderStatus.Drying          => "ord-badge ord-drying",
        OrderStatus.AwaitingPayment => "ord-badge ord-awaiting-payment",
        OrderStatus.PaymentConfirmed  => "ord-badge ord-payment-confirmed",
        OrderStatus.ReadyForDelivery  => "ord-badge ord-ready-delivery",
        OrderStatus.OutForDelivery    => "ord-badge ord-out-delivery",
        OrderStatus.Delivered  => "ord-badge ord-delivered",
        OrderStatus.Cancelled  => "ord-badge ord-cancelled",
        OrderStatus.Abandoned  => "ord-badge ord-abandoned",
        _                      => "ord-badge ord-default"
    };
    string OrderStatusLabel(OrderStatus s) => s switch {
        OrderStatus.Pending           => "Pending",
        OrderStatus.RiderAssigned     => "Rider Assigned",
        OrderStatus.PickedUp          => "Picked Up",
        OrderStatus.InTransitToShop   => "In Transit to Shop",
        OrderStatus.Weighing          => "Weighing",
        OrderStatus.WeightConfirmed   => "Weight Confirmed",
        OrderStatus.Washing           => "Washing",
        OrderStatus.Drying            => "Drying",
        OrderStatus.AwaitingPayment   => "Awaiting Payment",
        OrderStatus.PaymentConfirmed  => "Payment Confirmed",
        OrderStatus.ReadyForDelivery  => "Ready for Delivery",
        OrderStatus.OutForDelivery    => "Out for Delivery",
        OrderStatus.Delivered         => "Delivered",
        OrderStatus.Cancelled         => "Cancelled",
        OrderStatus.Abandoned         => "Abandoned",
        _                             => s.ToString()
    };
    string OrderStatusGroup(OrderStatus s) => s switch {
        OrderStatus.Pending   => "pending",
        OrderStatus.Delivered or
        OrderStatus.Cancelled or
        OrderStatus.Abandoned => "completed",
        _                     => "ongoing"
    };
    string? JsonUtc(DateTime? value) => value == null ? null : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToString("o");
}
@{
    // ── Tiered action gating ──────────────────────────────────────────────────
    // Same named policies as the controllers (registered in Program.cs).
    // Server-side [Authorize(Policy=...)] stays authoritative; these flags only
    // hide forbidden controls entirely (never disabled states).
    var canUserManagement = (await AuthorizationService.AuthorizeAsync(User, "UserManagement")).Succeeded;
    var canLoyaltyAdjust = (await AuthorizationService.AuthorizeAsync(User, "LoyaltyAdjust")).Succeeded;
    var canClaimsResolve = (await AuthorizationService.AuthorizeAsync(User, "ClaimsResolve")).Succeeded;
    var canRevenueView = (await AuthorizationService.AuthorizeAsync(User, "RevenueView")).Succeeded;
    var canAuditView = (await AuthorizationService.AuthorizeAsync(User, "AuditView")).Succeeded;
    var canViewDispatchMap = User.IsInRole("Admin") || User.IsInRole("Manager");
    var mapSettings = MapSettingsOptions.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Laundry Hub Admin Dashboard — Account Management, Audit Logs." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (canViewDispatchMap) {
        <link rel="stylesheet" href="~/lib/maplibre-gl/maplibre-gl.css" />
    }
    <style>
        :root {
            /* --lh-* design tokens load from the canonical wwwroot/css/site.css (linked above); page-scoped vars stay here. */
            /* Page-scoped vars only; card radius token per shared responsive contract. */
            --lh-card-radius:20px;--lh-touch-min:0px;
            --sidebar-width:300px;
            --c-active:#10B981;--c-active-bg:#ECFDF5;--c-active-border:#A7F3D0;
            --c-suspended:#F59E0B;--c-suspended-bg:#FFFBEB;--c-suspended-border:#FDE68A;
            --c-archived:#6B7280;--c-archived-bg:#F9FAFB;--c-archived-border:#E5E7EB;
            --c-danger:#EF4444;--c-danger-bg:#FEF2F2;--c-danger-border:#FECACA;
        }
        *,*::before,*::after{box-sizing:border-box;}
        html{font-size:16px;scroll-behavior:smooth;margin:0;padding:0;width:100%;height:100%;overflow-x:hidden;background-color:var(--lh-blue-10);}
        body{margin:0;padding:0;width:100%;min-height:100vh;font-family:var(--lh-font-body);font-size:1rem;line-height:1.6;color:var(--lh-text-body);background-color:var(--lh-blue-10);-webkit-font-smoothing:antialiased;overflow-x:hidden;}
        :focus-visible{outline:3px solid var(--lh-blue-400);outline-offset:2px;border-radius:var(--lh-radius-sm);}
        .admin-shell{display:flex;min-height:100vh;}
        .admin-sidebar{position:fixed;top:0;left:0;width:var(--sidebar-width);height:100vh;background-color:var(--lh-navy-900);display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;z-index:100;box-shadow:4px 0 24px rgba(7,19,36,0.18);scrollbar-width:thin;scrollbar-color:var(--lh-navy-700) transparent;}
        .admin-sidebar::-webkit-scrollbar{width:4px;}
        .admin-sidebar::-webkit-scrollbar-track{background:transparent;}
        .admin-sidebar::-webkit-scrollbar-thumb{background-color:var(--lh-navy-700);border-radius:4px;}
        .sidebar-brand{display:flex;align-items:center;gap:12px;padding:28px 20px 24px;border-bottom:1px solid rgba(255,255,255,0.07);text-decoration:none;flex-shrink:0;}
        .sidebar-logo-icon{width:40px;height:40px;background:linear-gradient(135deg,var(--lh-blue-500) 0%,var(--lh-blue-400) 100%);border-radius:var(--lh-radius-md);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(30,96,213,0.35);}
        .sidebar-logo-icon svg{color:var(--lh-white);}
        .sidebar-brand-text{display:flex;flex-direction:column;gap:1px;}
        .sidebar-wordmark{font-family:var(--lh-font-heading);font-size:0.9375rem;font-weight:700;color:var(--lh-white);line-height:1.2;letter-spacing:-0.01em;}
        .sidebar-role-badge{display:inline-flex;align-items:center;padding:2px 8px;background-color:rgba(59,130,246,0.2);border:1px solid rgba(96,165,250,0.3);border-radius:20px;font-size:0.6875rem;font-weight:600;color:var(--lh-blue-300);letter-spacing:0.04em;text-transform:uppercase;line-height:1;}
        .sidebar-nav{flex:1;padding:16px 12px;display:flex;flex-direction:column;gap:2px;}
        .sidebar-nav-section-label{font-size:0.6875rem;font-weight:600;color:rgba(255,255,255,0.3);text-transform:uppercase;letter-spacing:0.08em;padding:12px 10px 6px;margin-top:4px;}
        .sidebar-nav-item{display:flex;align-items:center;gap:12px;padding:11px 12px 11px 14px;border-radius:var(--lh-radius-md);text-decoration:none;color:rgba(255,255,255,0.62);font-size:0.9375rem;font-weight:500;line-height:1.3;transition:var(--lh-transition);position:relative;border:none;border-left:3px solid transparent;background:none;width:100%;text-align:left;cursor:pointer;}
        .sidebar-nav-item .nav-icon{flex-shrink:0;width:20px;height:20px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.45);transition:var(--lh-transition);}
        .sidebar-nav-item:hover{background-color:rgba(59,130,246,0.10);color:rgba(255,255,255,0.90);border-left-color:rgba(96,165,250,0.50);}
        .sidebar-nav-item:hover .nav-icon{color:var(--lh-blue-300);}
        .sidebar-nav-item.active{background-color:rgba(59,130,246,0.16);color:var(--lh-white);border-left-color:var(--lh-blue-400);}
        .sidebar-nav-item.active .nav-icon{color:var(--lh-blue-300);}
        .nav-chevron{margin-left:auto;width:16px;height:16px;flex-shrink:0;color:rgba(255,255,255,0.35);transition:transform 0.22s ease;}
        .sidebar-nav-item.open .nav-chevron{transform:rotate(90deg);color:var(--lh-blue-300);}
        .sidebar-nav-item.open{color:rgba(255,255,255,0.90);background-color:rgba(59,130,246,0.08);}
        .sidebar-nav-item.open .nav-icon{color:var(--lh-blue-300);}
        .sidebar-nav-children{overflow:hidden;max-height:0;transition:max-height 0.3s cubic-bezier(0.16,1,0.3,1),opacity 0.2s ease;opacity:0;}
        .sidebar-nav-children.open{opacity:1;}
        .sidebar-nav-child{display:flex;align-items:center;gap:10px;padding:9px 12px 9px 44px;border-radius:var(--lh-radius-md);text-decoration:none;color:rgba(255,255,255,0.52);font-size:0.875rem;font-weight:500;transition:var(--lh-transition);cursor:pointer;border:none;border-left:3px solid transparent;background:none;width:100%;text-align:left;margin-bottom:1px;}
        .sidebar-nav-child .nav-icon{flex-shrink:0;width:16px;height:16px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.35);transition:var(--lh-transition);}
        .sidebar-nav-child:hover{background-color:rgba(59,130,246,0.08);color:rgba(255,255,255,0.82);border-left-color:rgba(96,165,250,0.35);}
        .sidebar-nav-child:hover .nav-icon{color:var(--lh-blue-200);}
        .sidebar-nav-child.active{background-color:rgba(59,130,246,0.14);color:var(--lh-white);border-left-color:var(--lh-blue-300);}
        .sidebar-nav-child.active .nav-icon{color:var(--lh-blue-200);}
        .sidebar-footer{padding:16px 12px 20px;border-top:1px solid rgba(255,255,255,0.07);flex-shrink:0;}
        .sidebar-footer-info{display:flex;align-items:center;gap:10px;padding:8px 10px;}
        .sidebar-footer-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--lh-navy-700) 0%,var(--lh-blue-600) 100%);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1.5px solid rgba(96,165,250,0.25);}
        .sidebar-footer-meta{display:flex;flex-direction:column;gap:1px;overflow:hidden;}
        .sidebar-footer-name{font-size:0.8125rem;font-weight:600;color:rgba(255,255,255,0.85);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .sidebar-footer-role{font-size:0.6875rem;color:rgba(255,255,255,0.38);}
        .admin-main{margin-left:var(--sidebar-width);flex:1;min-height:100vh;padding:40px;display:flex;flex-direction:column;gap:0;}
        .panel{display:none;flex-direction:column;gap:24px;width:100%;}
        .panel.active{display:flex;}
        .panel-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;}
        .panel-title-group{display:flex;flex-direction:column;gap:4px;}
        .panel-title{font-family:var(--lh-font-heading);font-size:1.625rem;font-weight:800;color:var(--lh-text-headings);line-height:1.2;margin:0;}
        .panel-subtitle{font-size:0.875rem;color:var(--lh-text-muted);margin:0;}
        .card{background:var(--lh-white);border-radius:var(--lh-card-radius);border:1px solid var(--lh-border-subtle);box-shadow:var(--lh-shadow-sm);overflow:hidden;}
        .card-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:20px 24px;border-bottom:1px solid var(--lh-border-subtle);}
        .card-header-left{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
        .card-body{padding:0;}
        .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;font-weight:600;cursor:pointer;border:none;transition:var(--lh-transition);text-decoration:none;line-height:1.4;white-space:nowrap;}
        .btn-primary{background:linear-gradient(135deg,var(--lh-blue-600),var(--lh-blue-400));color:var(--lh-white);box-shadow:0 2px 8px rgba(30,96,213,0.25);}
        .btn-primary:hover{box-shadow:0 4px 14px rgba(30,96,213,0.4);transform:translateY(-1px);}
        .btn-ghost{background:transparent;color:var(--lh-text-muted);border:1px solid var(--lh-border-light);}
        .btn-ghost:hover{background:var(--lh-blue-50);color:var(--lh-blue-600);border-color:var(--lh-blue-200);}
        .btn-danger{background:var(--c-danger-bg);color:var(--c-danger);border:1px solid var(--c-danger-border);}
        .btn-danger:hover{background:var(--c-danger);color:var(--lh-white);}
        .btn-warning{background:var(--c-suspended-bg);color:#B45309;border:1px solid var(--c-suspended-border);}
        .btn-warning:hover{background:var(--c-suspended);color:var(--lh-white);}
        .btn-success{background:var(--c-active-bg);color:#065F46;border:1px solid var(--c-active-border);}
        .btn-success:hover{background:var(--c-active);color:var(--lh-white);}
        .btn-sm{padding:5px 10px;font-size:0.75rem;}
        .filter-chips{display:flex;gap:6px;flex-wrap:wrap;}
        .chip{display:inline-flex;align-items:center;padding:5px 12px;border-radius:20px;font-size:0.75rem;font-weight:600;cursor:pointer;border:1.5px solid var(--lh-border-light);background:var(--lh-white);color:var(--lh-text-muted);transition:var(--lh-transition);user-select:none;}
        .chip:hover{border-color:var(--lh-blue-300);color:var(--lh-blue-600);background:var(--lh-blue-50);}
        .chip.active{background:var(--lh-blue-600);color:var(--lh-white);border-color:var(--lh-blue-600);}
        .search-wrap{position:relative;}
        .search-wrap svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--lh-text-muted);pointer-events:none;}
        .search-input{padding:8px 12px 8px 34px;border:1px solid var(--lh-border-light);border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;color:var(--lh-text-body);background:var(--lh-white);outline:none;transition:var(--lh-transition);width:220px;}
        .search-input:focus{border-color:var(--lh-border-focus);box-shadow:0 0 0 3px rgba(30,96,213,0.12);}
        .data-table{width:100%;border-collapse:collapse;}
        .data-table thead th{padding:12px 20px;text-align:left;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--lh-text-muted);background:var(--lh-blue-25);border-bottom:1px solid var(--lh-border-subtle);white-space:nowrap;}
        .data-table tbody tr{border-bottom:1px solid var(--lh-border-subtle);transition:background 0.15s ease;}
        .data-table tbody tr:last-child{border-bottom:none;}
        .data-table tbody tr:hover{background-color:var(--lh-blue-25);}
        .data-table tbody td{padding:14px 20px;font-size:0.875rem;color:var(--lh-text-body);vertical-align:middle;}
        .td-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
        .user-cell{display:flex;align-items:center;gap:10px;}
        .user-avatar{width:34px;height:34px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;color:var(--lh-white);}
        .user-name{font-weight:600;color:var(--lh-text-headings);font-size:0.875rem;}
        .user-email{font-size:0.75rem;color:var(--lh-text-muted);}
        .role-badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:0.7rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;}
        .role-admin{background:#EEF2FF;color:#4338CA;border:1px solid #C7D2FE;}
        .role-manager{background:#FDF4FF;color:#7C3AED;border:1px solid #E9D5FF;}
        .role-staff{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;}
        .role-rider{background:#FFF7ED;color:#C2410C;border:1px solid #FED7AA;}
        .role-customer{background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE;}
        .status-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:0.7rem;font-weight:700;letter-spacing:0.03em;text-transform:uppercase;}
        .status-badge::before{content:"";width:6px;height:6px;border-radius:50%;flex-shrink:0;}
        .status-active{background:var(--c-active-bg);color:#065F46;border:1px solid var(--c-active-border);}
        .status-active::before{background:var(--c-active);}
        .status-suspended{background:var(--c-suspended-bg);color:#92400E;border:1px solid var(--c-suspended-border);}
        .status-suspended::before{background:var(--c-suspended);}
        .status-archived{background:var(--c-archived-bg);color:var(--c-archived);border:1px solid var(--c-archived-border);}
        .status-archived::before{background:var(--c-archived);}
        .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;gap:12px;}
        .empty-state-icon{color:var(--lh-blue-200);}
        .empty-state p{font-size:0.9rem;color:var(--lh-text-muted);margin:0;text-align:center;}
        .audit-list{display:flex;flex-direction:column;gap:0;}
        .audit-entry{display:flex;align-items:flex-start;gap:14px;padding:16px 24px;border-bottom:1px solid var(--lh-border-subtle);transition:background 0.15s ease;}
        .audit-entry:last-child{border-bottom:none;}
        .audit-entry:hover{background:var(--lh-blue-25);}
        .audit-dot{width:34px;height:34px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;margin-top:2px;}
        .audit-dot-add{background:#DCFCE7;color:#16A34A;}
        .audit-dot-update{background:#DBEAFE;color:#2563EB;}
        .audit-dot-archive{background:#F3F4F6;color:#6B7280;}
        .audit-dot-suspend{background:#FEF3C7;color:#D97706;}
        .audit-dot-unsuspend{background:#ECFDF5;color:#059669;}
        .audit-body{flex:1;display:flex;flex-direction:column;gap:2px;}
        .audit-title{font-size:0.875rem;font-weight:600;color:var(--lh-text-headings);}
        .audit-title span{color:var(--lh-blue-600);}
        .audit-note{font-size:0.8rem;color:var(--lh-text-muted);}
        .audit-time{font-size:0.75rem;color:var(--lh-text-muted);white-space:nowrap;margin-top:2px;}
        .modal-overlay{position:fixed;inset:0;background:rgba(7,19,36,0.55);backdrop-filter:blur(4px);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity 0.22s ease;}
        .modal-overlay.open{opacity:1;pointer-events:all;}
        .modal{background:var(--lh-white);border-radius:var(--lh-radius-xl);box-shadow:var(--lh-shadow-xl);width:100%;max-width:500px;max-height:90vh;overflow-y:auto;transform:translateY(16px) scale(0.97);transition:transform 0.28s cubic-bezier(0.16,1,0.3,1);}
        .modal-overlay.open .modal{transform:translateY(0) scale(1);}
        .modal-header{display:flex;align-items:center;justify-content:space-between;padding:24px 28px 20px;border-bottom:1px solid var(--lh-border-subtle);}
        .modal-title{font-family:var(--lh-font-heading);font-size:1.125rem;font-weight:700;color:var(--lh-text-headings);margin:0;}
        .modal-close{width:32px;height:32px;border-radius:var(--lh-radius-sm);border:none;background:var(--lh-blue-25);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--lh-text-muted);transition:var(--lh-transition);}
        .modal-close:hover{background:var(--c-danger-bg);color:var(--c-danger);}
        .modal-body{padding:24px 28px;display:flex;flex-direction:column;gap:16px;}
        .modal-footer{display:flex;justify-content:flex-end;gap:10px;padding:16px 28px 24px;border-top:1px solid var(--lh-border-subtle);}
        .form-group{display:flex;flex-direction:column;gap:6px;}
        .form-label{font-size:0.8125rem;font-weight:600;color:var(--lh-text-headings);}
        .form-control{padding:9px 13px;border:1.5px solid var(--lh-border-light);border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.875rem;color:var(--lh-text-body);outline:none;transition:var(--lh-transition);background:var(--lh-white);}
        .form-control:focus{border-color:var(--lh-border-focus);box-shadow:0 0 0 3px rgba(30,96,213,0.12);}
        .form-control.error{border-color:var(--c-danger);}
        .form-error{font-size:0.75rem;color:var(--c-danger);}
        textarea.form-control{resize:vertical;min-height:90px;}
        .suspend-warning{background:var(--c-suspended-bg);border:1px solid var(--c-suspended-border);border-radius:var(--lh-radius-md);padding:12px 14px;font-size:0.8125rem;color:#92400E;display:flex;gap:8px;align-items:flex-start;}
        .stats-row{display:flex;gap:16px;flex-wrap:wrap;}
        .stat-card{flex:1 1 160px;background:var(--lh-white);border:1px solid var(--lh-border-subtle);border-radius:var(--lh-radius-lg);padding:20px 24px;box-shadow:var(--lh-shadow-sm);display:flex;flex-direction:column;gap:4px;}
        .stat-label{font-size:0.75rem;font-weight:600;color:var(--lh-text-muted);text-transform:uppercase;letter-spacing:0.06em;}
        .stat-value{font-family:var(--lh-font-heading);font-size:1.75rem;font-weight:800;color:var(--lh-text-headings);}
        .stat-sub{font-size:0.75rem;color:var(--lh-text-muted);}
        .welcome-panel{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:70vh;gap:16px;text-align:center;}
        .welcome-panel h1{font-family:var(--lh-font-heading);font-size:2rem;font-weight:800;color:var(--lh-text-headings);margin:0;}
        .welcome-panel p{font-size:0.95rem;color:var(--lh-text-muted);max-width:400px;margin:0;}
        .welcome-icon{width:72px;height:72px;background:var(--lh-blue-50);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:4px;}
        /* Universal Pagination Controls */
        .lh-pagination-wrapper{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:16px 24px;border-top:1px solid var(--lh-border-subtle);background-color:var(--lh-white);}
        .lh-pagination-info{font-size:0.8125rem;color:var(--lh-text-muted);}
        .lh-pagination-info strong{color:var(--lh-text-headings);font-weight:600;}
        .lh-pagination-nav{display:flex;align-items:center;gap:6px;}
        .lh-page-numbers{display:flex;align-items:center;gap:4px;}
        .lh-page-btn{display:inline-flex;align-items:center;justify-content:center;gap:4px;min-width:32px;height:32px;padding:0 8px;border:1px solid var(--lh-border-light);background-color:var(--lh-white);color:var(--lh-text-body);border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;font-weight:600;cursor:pointer;transition:var(--lh-transition);line-height:1;}
        .lh-page-btn:hover:not(:disabled){border-color:var(--lh-blue-300);color:var(--lh-blue-600);background-color:var(--lh-blue-50);}
        .lh-page-btn.active{background-color:var(--lh-blue-600);border-color:var(--lh-blue-600);color:var(--lh-white);cursor:default;}
        .lh-page-btn:disabled{opacity:0.45;cursor:not-allowed;background-color:var(--lh-blue-10);}
        /* Dashboard panel */
        .dash-stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}
        .dash-stat-card{background:var(--lh-white);border:1px solid var(--lh-border-subtle);border-radius:var(--lh-card-radius);padding:22px 24px;box-shadow:var(--lh-shadow-sm);display:flex;flex-direction:column;gap:6px;}
        .dash-stat-icon{width:40px;height:40px;border-radius:var(--lh-radius-md);display:flex;align-items:center;justify-content:center;margin-bottom:4px;}
        .dash-stat-label{font-size:0.75rem;font-weight:600;color:var(--lh-text-muted);text-transform:uppercase;letter-spacing:0.06em;}
        .dash-stat-value{font-family:var(--lh-font-heading);font-size:2rem;font-weight:800;color:var(--lh-text-headings);line-height:1;}
        .dash-stat-sub{font-size:0.75rem;color:var(--lh-text-muted);}
        .dash-activity-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--lh-border-subtle);}
        .dash-activity-item:last-child{border-bottom:none;}
        .dash-activity-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
        /* Filter row extras */
        .filter-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
        .filter-select{padding:6px 10px;border:1px solid var(--lh-border-light);border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;color:var(--lh-text-body);background:var(--lh-white);outline:none;cursor:pointer;transition:var(--lh-transition);}
        .filter-select:focus{border-color:var(--lh-border-focus);box-shadow:0 0 0 3px rgba(30,96,213,0.12);}
        .filter-date{padding:6px 10px;border:1px solid var(--lh-border-light);border-radius:var(--lh-radius-md);font-family:var(--lh-font-body);font-size:0.8125rem;color:var(--lh-text-body);background:var(--lh-white);outline:none;cursor:pointer;transition:var(--lh-transition);}
        .filter-date:focus{border-color:var(--lh-border-focus);box-shadow:0 0 0 3px rgba(30,96,213,0.12);}
        .filter-label{font-size:0.75rem;font-weight:600;color:var(--lh-text-muted);white-space:nowrap;}
        /* ── Order status badges ── */
        .ord-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:0.7rem;font-weight:700;letter-spacing:0.03em;white-space:nowrap;}
        .ord-badge::before{content:"";width:6px;height:6px;border-radius:50%;flex-shrink:0;}
        .ord-pending{background:#EEF2FF;color:#4338CA;border:1px solid #C7D2FE;}.ord-pending::before{background:#6366F1;}
        .ord-rider-assigned{background:#FFF7ED;color:#C2410C;border:1px solid #FED7AA;}.ord-rider-assigned::before{background:#F97316;}
        .ord-in-transit{background:#FFFBEB;color:#B45309;border:1px solid #FDE68A;}.ord-in-transit::before{background:#F59E0B;}
        .ord-weighing{background:#F5F3FF;color:#6D28D9;border:1px solid #DDD6FE;}.ord-weighing::before{background:#8B5CF6;}
        .ord-washing{background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE;}.ord-washing::before{background:#3B82F6;}
        .ord-drying{background:#F0F9FF;color:#0369A1;border:1px solid #BAE6FD;}.ord-drying::before{background:#0EA5E9;}
        .ord-awaiting-payment{background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA;}.ord-awaiting-payment::before{background:#EF4444;}
        .ord-payment-confirmed{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;}.ord-payment-confirmed::before{background:#10B981;}
        .ord-ready-delivery{background:#F0FDF4;color:#15803D;border:1px solid #BBF7D0;}.ord-ready-delivery::before{background:#22C55E;}
        .ord-out-delivery{background:#FFF7ED;color:#C2410C;border:1px solid #FED7AA;}.ord-out-delivery::before{background:#F97316;}
        .ord-delivered{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;}.ord-delivered::before{background:#10B981;}
        .ord-cancelled{background:#F9FAFB;color:#6B7280;border:1px solid #E5E7EB;}.ord-cancelled::before{background:#9CA3AF;}
        .ord-abandoned{background:#FEF2F2;color:#9B1C1C;border:1px solid #FECACA;}.ord-abandoned::before{background:#EF4444;}
        .ord-default{background:#F3F4F6;color:#374151;border:1px solid #D1D5DB;}.ord-default::before{background:#6B7280;}
        /* ── Dispatch Map Styles (Phase 2F) ── */
        .dispatch-map-container{width:100%;height:440px;position:relative;background:#E2E8F0;border-radius:0 0 var(--lh-card-radius) var(--lh-card-radius);overflow:hidden;}
        .dispatch-map-canvas{width:100%;height:100%;}
        .dispatch-map-overlay{position:absolute;top:12px;left:12px;z-index:5;display:flex;flex-wrap:wrap;gap:8px;pointer-events:none;}
        .dispatch-overlay-pill{pointer-events:auto;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(255,255,255,0.92);backdrop-filter:blur(6px);border:1px solid var(--lh-border-subtle);border-radius:20px;font-size:0.75rem;font-weight:600;color:var(--lh-text-headings);box-shadow:var(--lh-shadow-sm);}
        .dispatch-dot{width:8px;height:8px;border-radius:50%;}
        .dispatch-dot.dot-live{background:#10B981;box-shadow:0 0 0 2px rgba(16,185,129,0.25);animation:dispatchPulse 2s infinite;}
        .dispatch-dot.dot-stale{background:#F59E0B;}
        .dispatch-dot.dot-offline{background:#9CA3AF;}
        @@keyframes dispatchPulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,0.5);}70%{box-shadow:0 0 0 6px rgba(16,185,129,0);}}
        .dispatch-rider-marker{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;border:2.5px solid #fff;box-shadow:0 3px 8px rgba(0,0,0,0.25);cursor:pointer;transition:transform 0.15s ease;}
        .dispatch-rider-marker:hover{transform:scale(1.15);}
        .dispatch-rider-marker.is-live{background:#10B981;}
        .dispatch-rider-marker.is-stale{background:#F59E0B;}
        .dispatch-rider-marker.is-waiting{background:#6B7280;}
        .dispatch-order-marker{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.2);cursor:pointer;}
        .dispatch-order-marker.is-pickup{background:#2563EB;}
        .dispatch-order-marker.is-delivery{background:#7C3AED;}
        .dispatch-popup{font-family:var(--lh-font-body);padding:2px;font-size:0.8125rem;}
        .dispatch-popup-title{font-weight:700;color:var(--lh-text-headings);font-size:0.875rem;margin-bottom:4px;}
        .dispatch-popup-row{display:flex;gap:4px;margin-bottom:2px;color:var(--lh-text-body);}
        .dispatch-popup-row strong{color:var(--lh-text-headings);}
        .ord-row.hidden{display:none !important;}
        /* ── Admin flash alerts ── */
        .admin-alert{display:flex;align-items:center;gap:10px;padding:14px 18px;border-radius:var(--lh-radius-md);font-size:0.875rem;font-weight:500;}
        .admin-alert-success{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;}
        .admin-alert-error{background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA;}
        /* ── Rider info in table ── */
        .rider-cell{display:flex;align-items:center;gap:8px;}
        .rider-avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:#fff;flex-shrink:0;background:#D97706;}
        .inv-fill-track{height:8px;min-width:140px;background:#E2E8F0;border-radius:9999px;overflow:hidden;}
        .inv-fill-bar{height:100%;border-radius:9999px;transition:width 0.2s ease;}
        .pd-row{cursor:pointer;}
        .pd-detail-cell{background:var(--lh-blue-10);}
        .pd-chevron{color:var(--lh-text-muted);font-size:0.8rem;}

        /* ============ Shared responsive contract (breakpoints 1024px / 640px) ============ */
        /* Horizontal scroll lives on the table wrapper only — never on the page. */
        .table-scroll{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;}
        .table-scroll th:first-child,.table-scroll td:first-child{position:sticky;left:0;z-index:2;background:var(--lh-white);}
        .table-scroll thead th:first-child{background:var(--lh-blue-25);z-index:3;}
        .table-scroll tbody tr:hover td:first-child{background:var(--lh-blue-25);}
        .table-scroll th:first-child::after,.table-scroll td:first-child::after{content:"";position:absolute;top:0;right:0;bottom:0;width:1px;background:var(--lh-border-subtle);}

        /* Condensed essential-column disclosure control (injected by the row-toggle script). */
        .row-toggle{display:none;align-items:center;justify-content:center;min-width:var(--lh-touch-min);min-height:var(--lh-touch-min);margin-right:8px;border:1px solid var(--lh-border-light);border-radius:var(--lh-radius-sm);background:var(--lh-white);color:var(--lh-text-muted);cursor:pointer;vertical-align:middle;}
        .row-toggle[aria-expanded="true"] svg{transform:rotate(180deg);}

        /* Collapsible sidebar chrome (desktop hidden, <=1024px shown). */
        .sidebar-toggle{display:none;position:fixed;top:12px;left:12px;z-index:120;width:40px;height:40px;align-items:center;justify-content:center;border:1px solid var(--lh-border-light);border-radius:var(--lh-radius-md);background:var(--lh-white);color:var(--lh-text-headings);box-shadow:var(--lh-shadow-sm);cursor:pointer;}
        .sidebar-scrim{display:none;position:fixed;inset:0;background:rgba(7,19,36,0.45);z-index:110;}

        /* Bottom navigation (sidebar hidden at <=640px). */
        .admin-bottom-nav{display:none;position:fixed;left:0;right:0;bottom:0;z-index:120;background:var(--lh-navy-900);border-top:1px solid var(--lh-navy-800);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px));}
        .admin-bottom-nav-inner{display:flex;align-items:stretch;justify-content:space-around;gap:4px;}
        .admin-bottom-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:var(--lh-touch-min);padding:6px 4px;border-radius:var(--lh-radius-md);color:rgba(255,255,255,0.62);font-size:0.6875rem;font-weight:600;text-decoration:none;}
        .admin-bottom-nav-item.active{color:var(--lh-white);background:rgba(59,130,246,0.16);}
        .admin-bottom-nav-item .nav-icon{display:flex;width:20px;height:20px;align-items:center;justify-content:center;}

        /* 1024px and below: sidebar collapses off-canvas, essential table columns only. */
        @@media (max-width: 1024px) {
            .sidebar-toggle{display:flex;}
            .admin-sidebar{transform:translateX(-100%);transition:transform 0.28s cubic-bezier(0.16,1,0.3,1);box-shadow:none;}
            .admin-sidebar.open{transform:translateX(0);box-shadow:4px 0 24px rgba(7,19,36,0.28);}
            .admin-sidebar.open ~ .sidebar-scrim{display:block;}
            .admin-main{margin-left:0;padding:64px 20px 32px;min-width:0;}
            .dash-stat-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));}
            .table-scroll th:nth-child(n+4):not(:last-child),.table-scroll td:nth-child(n+4):not(:last-child){display:none;}
            .table-scroll tr.row-expanded th:nth-child(n+4):not(:last-child),.table-scroll tr.row-expanded td:nth-child(n+4):not(:last-child){display:table-cell;}
            .row-toggle{display:inline-flex;}
            .data-table thead th,.data-table tbody td{padding:12px 14px;}
            .lh-pagination-wrapper{padding:14px 16px;}
        }

        /* 640px and below: two essential columns plus the trailing action column, sidebar hidden. */
        @@media (max-width: 640px) {
            .admin-sidebar{display:none;}
            .admin-bottom-nav{display:block;}
            .admin-main{padding:64px 14px 84px;}
            .panel-header{gap:8px;}
            .dash-stat-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;}
            .table-scroll th:nth-child(n+3):not(:last-child),.table-scroll td:nth-child(n+3):not(:last-child){display:none;}
            .table-scroll tr.row-expanded th:nth-child(n+3):not(:last-child),.table-scroll tr.row-expanded td:nth-child(n+3):not(:last-child){display:table-cell;}
            .card-header{padding:16px;}
            .search-input{width:100%;}
            .modal-header{padding:18px 18px 14px;}
        }

        /* Touch sizing: 44px minimums come from the token, never per-button overrides. */
        @@media (pointer: coarse) {
            :root{--lh-touch-min:44px;}
            .btn,.btn-sm,.btn-icon,.chip,.lh-page-btn,.modal-close,.filter-chip{min-height:var(--lh-touch-min);}
            .btn,.btn-sm,.btn-icon,.chip,.lh-page-btn,.modal-close,.filter-chip{min-width:var(--lh-touch-min);}
            .sidebar-nav-item,.sidebar-nav-child{min-height:var(--lh-touch-min);}
            .sidebar-toggle{min-width:var(--lh-touch-min);min-height:var(--lh-touch-min);}
            .row-toggle{min-width:var(--lh-touch-min);min-height:var(--lh-touch-min);}
        }
    </style>
</head>
<body>
<div class="admin-shell" id="admin-root">

    <!-- COLLAPSIBLE SIDEBAR TOGGLE (visible <=1024px) -->
    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="adminSidebar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <!-- SIDEBAR -->
    <aside class="admin-sidebar" id="adminSidebar" aria-label="Admin navigation">
        <a href="#" class="sidebar-brand" aria-label="Laundry Hub Admin home">
            <div class="sidebar-logo-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM7.5 17.5C6.67 17.5 6 16.83 6 16C6 15.17 6.67 14.5 7.5 14.5C8.33 14.5 9 15.17 9 16C9 16.83 8.33 17.5 7.5 17.5ZM12 17.5C11.17 17.5 10.5 16.83 10.5 16C10.5 15.17 11.17 14.5 12 14.5C12.83 14.5 13.5 15.17 13.5 16C13.5 16.83 12.83 17.5 12 17.5ZM16.5 17.5C15.67 17.5 15 16.83 15 16C15 15.17 15.67 14.5 16.5 14.5C17.33 14.5 18 15.17 18 16C18 16.83 17.33 17.5 16.5 17.5ZM17.2 11.8C16.88 12.28 16.34 12.56 15.77 12.56H8.23C7.66 12.56 7.12 12.28 6.8 11.8L5.35 9.63C4.9 8.95 5.39 8.04 6.2 8.04H17.8C18.61 8.04 19.1 8.95 18.65 9.63L17.2 11.8Z" fill="currentColor"/>
                </svg>
            </div>
            <div class="sidebar-brand-text">
                <span class="sidebar-wordmark">Laundry Hub</span>
                <span class="sidebar-role-badge">Admin</span>
            </div>
        </a>

        <nav class="sidebar-nav" aria-label="Admin menu">
            <!-- Dashboard -->
            <button class="sidebar-nav-item active" id="nav-dashboard" onclick="showPanel('dashboard')">
                <span class="nav-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                </span>
                Dashboard
            </button>

            <span class="sidebar-nav-section-label">Management</span>

            <!-- Account Management (expandable) -->
            <button class="sidebar-nav-item" id="nav-account-management"
                    aria-expanded="false" aria-controls="nav-account-children"
                    onclick="toggleAccountDropdown()">
                <span class="nav-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                Account Management
                <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>

            <div class="sidebar-nav-children" id="nav-account-children">
                @if (canUserManagement) {
                <button class="sidebar-nav-child" id="nav-child-employees" onclick="showPanel('employees')">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    Employee Management
                </button>
                <button class="sidebar-nav-child" id="nav-child-customers" onclick="showPanel('customers')">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                        </svg>
                    </span>
                    Customer Management
                </button>
                }
            </div>

            <button class="sidebar-nav-item" id="nav-orders" onclick="showPanel('orders')">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        <polyline points="10 9 9 9 8 9"/>
                    </svg>
                </span>
                Laundry Service Orders
                @if (Model.PendingOrdersCount > 0) {
                    <span style="margin-left:auto;background:#EF4444;color:#fff;border-radius:10px;padding:1px 7px;font-size:0.6875rem;font-weight:700;">@Model.PendingOrdersCount</span>
                }
            </button>

            <button class="sidebar-nav-item" id="nav-pickup-delivery" onclick="showPanel('pickup-delivery')">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13" rx="1"/>
                        <path d="M16 8h4l3 5v4h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </span>
                Pickup &amp; Delivery
            </button>

            <button class="sidebar-nav-item" id="nav-tracking" onclick="showPanel('tracking')">
                <span class="nav-icon">
