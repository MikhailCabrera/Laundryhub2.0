        <script type="application/json" id="employee-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Employees.Select(e => new {
    id = e.Id,
    fullName = e.FullName,
    email = e.Email,
    phoneNumber = e.PhoneNumber,
    district = e.District,
    role = e.Role,
    isSuspended = e.IsSuspended,
    suspendNote = e.SuspendNote,
    isArchived = e.IsArchived,
    createdAt = JsonUtc(e.CreatedAt)
})))
        </script>
        <script type="application/json" id="customer-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customers.Select(c => new {
    id = c.Id,
    fullName = c.FullName,
    email = c.Email,
    phoneNumber = c.PhoneNumber,
    district = c.District,
    role = c.Role,
    isSuspended = c.IsSuspended,
    suspendNote = c.SuspendNote,
    isArchived = c.IsArchived,
    createdAt = JsonUtc(c.CreatedAt)
})))
        </script>
        <script type="application/json" id="billing-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Orders.Where(o => o.WeightConfirmedAt.HasValue).OrderByDescending(o => o.WeightConfirmedAt).Select(o => new {
    id = o.Id,
    orderNumber = o.OrderNumber,
    customerName = o.Customer != null ? o.Customer.FullName : "Unknown",
    contactNumber = o.ContactNumber,
    weightKg = o.WeightKg,
    baseAmount = o.TotalAmount,
    penalty = o.AccruedPenaltyAmount ?? 0m,
    totalDue = (o.TotalAmount ?? 0m) + (o.AccruedPenaltyAmount ?? 0m),
    isPaid = o.IsPaymentConfirmed,
    weightConfirmedAt = JsonUtc(o.WeightConfirmedAt),
    paymentDeadline = JsonUtc(o.ReadyForDeliveryNotifiedAt?.AddHours(24)),
    paymentConfirmedAt = JsonUtc(o.PaymentConfirmedAt),
    paymentReference = o.PayMongoPaymentId,
    checkoutUrl = o.PayMongoCheckoutUrl
})))
        </script>
        <div class="panel" id="panel-billing">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Billing</h1>
                    <p class="panel-subtitle">Weight-confirmed orders and outstanding balances — read directly from the order records.</p>
                </div>
            </div>
            <div class="stats-row" id="billing-stats"></div>
            <div class="card">
                <div class="card-header" style="flex-wrap:wrap;gap:12px;">
                    <div class="card-header-left" style="flex-wrap:wrap;gap:10px;">
                        <div class="filter-chips" id="billing-status-chips">
                            <span class="chip active" data-payment-status="all" onclick="filterBilling('all')">All (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue))</span>
                            <span class="chip" data-payment-status="paid" onclick="filterBilling('paid')">Paid (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue && o.IsPaymentConfirmed))</span>
                            <span class="chip" data-payment-status="unpaid" onclick="filterBilling('unpaid')">Unpaid (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue && !o.IsPaymentConfirmed))</span>
                        </div>
                    </div>
                    <div class="search-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="search-input" id="billing-search" placeholder="Search order # or customer..." />
                    </div>
                </div>
                <div class="card-body">
                    <table class="data-table" id="billing-table" aria-label="Billing transactions">
                        <thead><tr><th>Order #</th><th>Customer</th><th>Weight</th><th>Amount Due</th><th>Penalty</th><th>Total Due</th><th>Status</th><th>Weight Confirmed</th><th>Payment Deadline</th></tr></thead>
                        <tbody id="billing-table-body"></tbody>
                    </table>
                    <div id="billing-empty" class="empty-state" style="display:none;">
                        <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                        <p>No billing records yet. Orders appear here as soon as their weight is confirmed.</p>
                    </div>
                    <div id="billing-pagination"></div>
                </div>
            </div>
        </div>

        @{
            var activeInventoryItems = Model.InventoryItems.Where(i => !i.IsArchived).OrderBy(i => i.Name).ToList();
            var archivedInventoryItems = Model.InventoryItems.Where(i => i.IsArchived).OrderBy(i => i.Name).ToList();
            var lowOnlyInventoryItems = activeInventoryItems.Where(i => i.CurrentStock > 0 && i.CurrentStock <= i.LowStockThreshold).ToList();
            var outInventoryItems = activeInventoryItems.Where(i => i.CurrentStock <= 0).ToList();
            var lowInventoryItems = activeInventoryItems.Where(i => i.CurrentStock <= i.LowStockThreshold).OrderBy(i => i.MaxCapacity > 0 ? i.CurrentStock / i.MaxCapacity : 0).ToList();
        }
        <script type="application/json" id="inventory-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InventoryTransactions.Select(t => new {
    id = t.Id,
    itemId = t.InventoryItemId,
    itemName = t.Item != null ? t.Item.Name : "Unknown item",
    unit = t.Item != null ? t.Item.Unit : "",
    action = t.Action.ToString(),
    quantity = t.Quantity,
    previousStock = t.PreviousStock,
    newStock = t.NewStock,
    performedBy = t.PerformedBy != null ? t.PerformedBy.FullName : "Unknown staff",
    createdAt = JsonUtc(t.CreatedAt),
    notes = t.Notes
})))
        </script>
        <div class="panel" id="panel-inventory">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Supplies Inventory</h1>
                    <p class="panel-subtitle">Track stock levels, log every add or deduct, and review usage reports.</p>
                </div>
                <button class="btn btn-primary" onclick="openInventoryItemModal('add', this)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Item
                </button>
            </div>
            @if (TempData["SuccessMessage"] != null && ViewData["ActiveTab"]?.ToString() == "inventory") {
                <div class="admin-alert admin-alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null && ViewData["ActiveTab"]?.ToString() == "inventory") {
                <div class="admin-alert admin-alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @TempData["ErrorMessage"]
                </div>
            }
            <div class="stats-row">
                <div class="stat-card"><div class="stat-label">Active Items</div><div class="stat-value">@activeInventoryItems.Count</div><div class="stat-sub">Currently tracked supplies</div></div>
                <div class="stat-card"><div class="stat-label">Low Stock</div><div class="stat-value" style="color:#D97706">@lowOnlyInventoryItems.Count</div><div class="stat-sub">Below threshold</div></div>
                <div class="stat-card"><div class="stat-label">Out of Stock</div><div class="stat-value" style="color:#DC2626">@outInventoryItems.Count</div><div class="stat-sub">Needs immediate restock</div></div>
                <div class="stat-card"><div class="stat-label">Logged Movements</div><div class="stat-value">@Model.InventoryTransactions.Count</div><div class="stat-sub">Add / deduct history</div></div>
            </div>
            <div class="card">
                <div class="card-header" style="flex-wrap:wrap;gap:12px;">
                    <div class="card-header-left">
                        <div class="filter-chips" id="inventory-tab-chips">
                            <span class="chip active" data-inventory-tab="stock" onclick="switchInventoryTab('stock')">Stock Items</span>
                            <span class="chip" data-inventory-tab="reports" onclick="switchInventoryTab('reports')">Reports</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="inventory-tab-stock">
                        <table class="data-table" aria-label="Inventory stock levels">
                            <thead><tr><th>Item</th><th>Stock</th><th>Fill Level</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                @foreach (var item in activeInventoryItems) {
                                    var fillPct = item.MaxCapacity > 0 ? Math.Min(100m, Math.Max(0m, item.CurrentStock / item.MaxCapacity * 100m)) : 0m;
                                    var isOut = item.CurrentStock <= 0;
                                    var isLow = !isOut && item.CurrentStock <= item.LowStockThreshold;
                                    var barColor = isOut ? "#DC2626" : isLow ? "#D97706" : "#059669";
                                    var hasHistory = Model.InventoryTransactions.Any(t => t.InventoryItemId == item.Id);
                                    <tr>
                                        <td><div class="user-name">@item.Name</div><div class="user-email">Unit: @item.Unit · Low threshold: @item.LowStockThreshold.ToString("0.##") @item.Unit</div></td>
                                        <td style="font-weight:600;white-space:nowrap;">@item.CurrentStock.ToString("0.##") / @item.MaxCapacity.ToString("0.##") @item.Unit</td>
                                        <td><div class="inv-fill-track"><div class="inv-fill-bar" style="width:@fillPct.ToString("0")%;background:@barColor;"></div></div><div class="user-email" style="margin-top:4px;">@fillPct.ToString("0")% full</div></td>
                                        <td>
                                            @if (isOut) { <span class="ord-badge ord-awaiting-payment">Out of stock</span> }
                                            else if (isLow) { <span class="status-badge status-suspended">Low stock</span> }
                                            else { <span class="status-badge status-active">Good</span> }
                                        </td>
                                        <td><div class="td-actions">
                                            <button class="btn btn-success btn-sm" data-id="@item.Id" data-name="@item.Name" data-current="@item.CurrentStock" data-unit="@item.Unit" data-direction="Add" onclick="openInventoryAdjustModal(this)">Add</button>
                                            <button class="btn btn-warning btn-sm" data-id="@item.Id" data-name="@item.Name" data-current="@item.CurrentStock" data-unit="@item.Unit" data-direction="Deduct" onclick="openInventoryAdjustModal(this)">Deduct</button>
                                            <button class="btn btn-ghost btn-sm" data-id="@item.Id" data-name="@item.Name" data-unit="@item.Unit" data-max="@item.MaxCapacity" data-threshold="@item.LowStockThreshold" onclick="openInventoryItemModal('edit', this)">Edit</button>
                                            <form method="post" asp-controller="Admin" asp-action="SetInventoryItemArchived" style="display:inline;" onsubmit="return confirm('Archive this item? It will be hidden from stock lists but its history is preserved.')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="isArchived" value="true" />
                                                <button type="submit" class="btn btn-ghost btn-sm">Archive</button>
                                            </form>
                                            @if (!hasHistory) {
                                                <form method="post" asp-controller="Admin" asp-action="DeleteInventoryItem" style="display:inline;" onsubmit="return confirm('Delete this item permanently?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            }
                                        </div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (archivedInventoryItems.Any()) {
                            <h3 style="margin:28px 0 12px;font-size:1rem;">Archived Items</h3>
                            <table class="data-table" aria-label="Archived inventory items">
                                <thead><tr><th>Item</th><th>Stock</th><th>Actions</th></tr></thead>
                                <tbody>
                                    @foreach (var item in archivedInventoryItems) {
                                        var hasHistory = Model.InventoryTransactions.Any(t => t.InventoryItemId == item.Id);
                                        <tr>
                                            <td><div class="user-name">@item.Name</div><div class="user-email">Unit: @item.Unit</div></td>
                                            <td style="font-weight:600;">@item.CurrentStock.ToString("0.##") / @item.MaxCapacity.ToString("0.##") @item.Unit</td>
                                            <td><div class="td-actions">
                                                <form method="post" asp-controller="Admin" asp-action="SetInventoryItemArchived" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="isArchived" value="false" />
                                                    <button type="submit" class="btn btn-success btn-sm">Restore</button>
                                                </form>
                                                @if (!hasHistory) {
                                                    <form method="post" asp-controller="Admin" asp-action="DeleteInventoryItem" style="display:inline;" onsubmit="return confirm('Delete this item permanently?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                }
                                            </div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div id="inventory-tab-reports" style="display:none;">
                        <h3 style="margin:4px 0 12px;font-size:1rem;">Current Stock Overview</h3>
                        <table class="data-table" aria-label="Current stock overview">
                            <thead><tr><th>Item</th><th>Stock Level</th><th>% Full</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var item in activeInventoryItems) {
                                    var fillPct = item.MaxCapacity > 0 ? Math.Min(100m, Math.Max(0m, item.CurrentStock / item.MaxCapacity * 100m)) : 0m;
                                    var isOut = item.CurrentStock <= 0;
                                    var isLow = !isOut && item.CurrentStock <= item.LowStockThreshold;
                                    <tr>
                                        <td><div class="user-name">@item.Name</div><div class="user-email">@item.Unit</div></td>
                                        <td style="font-weight:600;">@item.CurrentStock.ToString("0.##") / @item.MaxCapacity.ToString("0.##")</td>
                                        <td>@fillPct.ToString("0")%</td>
                                        <td>
                                            @if (isOut) { <span class="ord-badge ord-awaiting-payment">Out of stock</span> }
                                            else if (isLow) { <span class="status-badge status-suspended">Low</span> }
                                            else { <span class="status-badge status-active">Good</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <h3 style="margin:28px 0 12px;font-size:1rem;">Usage History</h3>
                        <div class="card-header" style="flex-wrap:wrap;gap:12px;padding:0 0 12px;border:none;">
                            <div class="card-header-left" style="flex-wrap:wrap;gap:10px;">
                                <div class="filter-row">
                                    <span class="filter-label">Item:</span>
                                    <select class="filter-select" id="inventory-item-filter" onchange="applyInventoryHistoryFilters()">
                                        <option value="all">All items</option>
                                        @foreach (var item in Model.InventoryItems.OrderBy(i => i.Name)) {
                                            <option value="@item.Id">@item.Name@(item.IsArchived ? " (archived)" : "")</option>
                                        }
                                    </select>
                                    <span class="filter-label">Action:</span>
                                    <select class="filter-select" id="inventory-action-filter" onchange="applyInventoryHistoryFilters()">
                                        <option value="all">Add + Deduct</option>
                                        <option value="Add">Add</option>
                                        <option value="Deduct">Deduct</option>
                                    </select>
                                    <span class="filter-label">From:</span>
                                    <input type="date" class="filter-date" id="inventory-date-from" onchange="applyInventoryHistoryFilters()" />
                                    <span class="filter-label">To:</span>
                                    <input type="date" class="filter-date" id="inventory-date-to" onchange="applyInventoryHistoryFilters()" />
                                    <button class="btn btn-ghost btn-sm" onclick="clearInventoryHistoryFilters()" title="Clear usage history filters">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="search-wrap">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <input type="text" class="search-input" id="inventory-search" placeholder="Search item, staff, notes..." />
                            </div>
                        </div>
                        <table class="data-table" id="inventory-table" aria-label="Inventory usage history">
                            <thead><tr><th>Date / Time</th><th>Item</th><th>Action</th><th>Quantity</th><th>Previous → New</th><th>Staff</th><th>Notes</th></tr></thead>
                            <tbody id="inventory-table-body"></tbody>
                        </table>
                        <div id="inventory-empty" class="empty-state" style="display:none;">
