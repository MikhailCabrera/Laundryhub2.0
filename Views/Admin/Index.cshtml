function pdFormatTime(value){
    if(!value) return '—';
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? '—' : formatDT(d);
}

function togglePdTimeline(evt, listName, id){
    if(evt && evt.target && evt.target.closest && evt.target.closest('a')) return;
    const wrap = document.getElementById('pd-tl-' + listName + '-' + id);
    if(!wrap) return;
    const isOpen = wrap.style.display !== 'none';
    document.querySelectorAll('.lh-timeline-wrap').forEach(w => { w.style.display = 'none'; w.innerHTML = ''; });
    document.querySelectorAll('.pd-chevron').forEach(c => { c.textContent = '▸'; });
    if(isOpen) return;
    const item = pdLegById(listName === 'pickup' ? pickupLegs : (listName === 'delivery' ? deliveryLegs : (listName === 'tracking' ? trackingLegs : crmLegs)), id);
    if(!item) return;
    wrap.innerHTML = OrderTimeline.render(item, 'legs');
    wrap.style.display = '';
    const chev = document.getElementById('pd-ch-' + listName + '-' + id);
    if(chev) chev.textContent = '▾';
}

