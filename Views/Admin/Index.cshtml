function buildInventoryHistoryFilter() {
    const itemId = document.getElementById('inventory-item-filter')?.value || 'all';
    const action = document.getElementById('inventory-action-filter')?.value || 'all';
    const from = document.getElementById('inventory-date-from')?.value || '';
    const to = document.getElementById('inventory-date-to')?.value || '';
    return item => {
        if (itemId !== 'all' && String(item.itemId) !== itemId) return false;
        if (action !== 'all' && item.action !== action) return false;
        const day = (item.createdAt || '').substring(0, 10);
        if (from && day < from) return false;
        if (to && day > to) return false;
        return true;
    };
}

function applyInventoryHistoryFilters() {
    if (inventoryTableMgr) inventoryTableMgr.setCustomFilter(buildInventoryHistoryFilter());
}

function clearInventoryHistoryFilters() {
    document.getElementById('inventory-item-filter').value = 'all';
    document.getElementById('inventory-action-filter').value = 'all';
    document.getElementById('inventory-date-from').value = '';
    document.getElementById('inventory-date-to').value = '';
    applyInventoryHistoryFilters();
}

function buildOrderStages(o){
    const clean = v => (v === null || v === undefined || v === '') ? null : v;
    const stages = [
        { key:'placed', label:'Order placed', at:clean(o.createdAt) },
        { key:'pickup_assigned', label:'Pickup rider assigned', at:clean(o.riderAssignedAt) },
        { key:'picked_up', label:'Picked up', at:clean(o.pickedUpAt) },
        { key:'in_transit', label:'In transit to shop', at:null },
        { key:'weighed', label:'Weight confirmed', at:clean(o.weightConfirmedAt) },
        { key:'washing', label:'Washing', at:clean(o.washingStartedAt) },
        { key:'drying', label:'Drying', at:clean(o.dryingStartedAt) },
        { key:'ready', label:'Ready for delivery', at:clean(o.readyNotifiedAt) },
        { key:'out_for_delivery', label:'Out for delivery', at:clean(o.deliveryAssignedAt) },
        { key:'delivered', label:'Delivered', at:clean(o.deliveredAt) }
    ];
    const byStatus = { pending:'placed', riderassigned:'pickup_assigned', pickedup:'picked_up', intransittoshop:'in_transit', weighing:'in_transit', weightconfirmed:'weighed', washing:'washing', drying:'drying', awaitingpayment:'drying', paymentconfirmed:'ready', readyfordelivery:'ready', outfordelivery:'out_for_delivery', deliveryattemptfailed:'out_for_delivery', delivered:'delivered' };
    const statusIdx = stages.findIndex(s => s.key === byStatus[String(o.status || '').toLowerCase()]);
    stages.forEach((s, i) => {
        s.state = (s.at !== null || (statusIdx >= 0 && i < statusIdx)) ? 'done' : (i === statusIdx ? 'current' : 'todo');
    });
    return stages;
}

function renderOrderTimeline(stages){
    return '<ol class="pd-timeline">' + stages.map(s => {
        let time = '—';
        if(s.at){
            const d = new Date(s.at);
            time = Number.isNaN(d.getTime()) ? '—' : formatDT(d);
        }else if(s.state === 'current'){
            time = 'in progress';
        }
        return '<li class="pd-tl-' + s.state + '"><span class="pd-tl-dot"></span><span class="pd-tl-label">' + escapeHtml(s.label) + '</span><span class="pd-tl-time">' + escapeHtml(time) + '</span></li>';
    }).join('') + '</ol>';
}

let pickupTableMgr = null;
let deliveryTableMgr = null;
let pickupLegs = [];
let deliveryLegs = [];
let pickupStageFilter = 'all';
let deliveryStageFilter = 'all';
let pickupOverdueOnly = false;
let deliveryOverdueOnly = false;
const PD_PICKUP_OVERDUE_HOURS = 4;
const PD_DELIVERY_OVERDUE_HOURS = 6;

function pdOverdueInfo(item, nowMs){
    const now = nowMs || Date.now();
    const elapsedHours = start => {
        if(!start) return null;
        const ms = now - new Date(start).getTime();
        if(Number.isNaN(ms) || ms < 0) return null;
        return ms / 3600000;
    };
    if(item.status === 'OutForDelivery'){
        const h = elapsedHours(item.deliveryAssignedAt);
        if(h !== null && item.deliveredAt == null && h > PD_DELIVERY_OVERDUE_HOURS)
            return { overdue:true, hours:Math.floor(h) };
        return { overdue:false, hours:0 };
    }
    const h = elapsedHours(item.riderAssignedAt);
    if(h !== null && item.pickedUpAt == null && h > PD_PICKUP_OVERDUE_HOURS)
        return { overdue:true, hours:Math.floor(h) };
    return { overdue:false, hours:0 };
}

function pdOverdueBadge(item){
    const info = pdOverdueInfo(item);
    if(!info.overdue) return '';
    return '<div style="margin-top:4px;"><span class="ord-badge ord-awaiting-payment">Overdue ' + info.hours + 'h</span></div>';
}

function pdLegById(list, id){
    return list.find(x => x.id === id) || null;
