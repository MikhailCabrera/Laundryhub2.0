                                            <button class="btn btn-success btn-sm" data-id="@item.Id" data-name="@item.Name" data-current="@item.CurrentStock" data-unit="@item.Unit" data-direction="Add" onclick="openInventoryAdjustModal(this)">Add</button>
                                            <button class="btn btn-warning btn-sm" data-id="@item.Id" data-name="@item.Name" data-current="@item.CurrentStock" data-unit="@item.Unit" data-direction="Deduct" onclick="openInventoryAdjustModal(this)">Deduct</button>
                                            <button class="btn btn-ghost btn-sm" data-id="@item.Id" data-name="@item.Name" data-unit="@item.Unit" data-max="@item.MaxCapacity" data-threshold="@item.LowStockThreshold" onclick="openInventoryItemModal('edit', this)">Edit</button>
                                            <form method="post" asp-controller="Admin" asp-action="SetInventoryItemArchived" style="display:inline;" onsubmit="return confirm('Archive this item? It will be hidden from stock lists but its history is preserved.')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="isArchived" value="true" />
                                                <button type="submit" class="btn btn-ghost btn-sm">Archive</button>
                                            </form>
                                            @if (!hasHistory) {
                                                <form method="post" asp-controller="Admin" asp-action="DeleteInventoryItem" style="display:inline;" onsubmit="return confirm('Delete this item permanently?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            }
                                        </div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div id="inventory-stock-pagination" aria-label="Inventory stock pagination"></div>
                        @if (archivedInventoryItems.Any()) {
                            <h3 style="margin:28px 0 12px;font-size:1rem;">Archived Items</h3>
                                                        <div class="table-scroll">
<table class="data-table" id="inventory-archived-table" aria-label="Archived inventory items">
                                <thead><tr><th>Item</th><th>Stock</th><th>Actions</th></tr></thead>
                                <tbody id="inventory-archived-body">
                                    @foreach (var item in archivedInventoryItems) {
                                        var hasHistory = Model.InventoryTransactions.Any(t => t.InventoryItemId == item.Id);
                                        <tr>
                                            <td><div class="user-name">@item.Name</div><div class="user-email">Unit: @item.Unit</div></td>
                                            <td style="font-weight:600;">@item.CurrentStock.ToString("0.##") / @item.MaxCapacity.ToString("0.##") @item.Unit</td>
                                            <td><div class="td-actions">
                                                <form method="post" asp-controller="Admin" asp-action="SetInventoryItemArchived" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="isArchived" value="false" />
                                                    <button type="submit" class="btn btn-success btn-sm">Restore</button>
                                                </form>
                                                @if (!hasHistory) {
                                                    <form method="post" asp-controller="Admin" asp-action="DeleteInventoryItem" style="display:inline;" onsubmit="return confirm('Delete this item permanently?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                }
                                            </div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="inventory-archived-pagination" aria-label="Archived inventory pagination"></div>
                        }
                    </div>
                    <div id="inventory-tab-reports" style="display:none;">
                        <h3 style="margin:4px 0 12px;font-size:1rem;">Current Stock Overview</h3>
