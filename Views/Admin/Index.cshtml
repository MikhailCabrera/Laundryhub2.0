                    <label class="form-label">Business Justification / Reason</label>
                    <textarea name="WeightOverrideReason" class="form-input" rows="3" placeholder="Reason for override after expired extension & contact attempts..." required></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Supervisor Approval (Admin / Manager)</label>
                    <select name="SupervisorId" class="form-input" required>
                        <option value="">Select approving supervisor...</option>
                        @foreach (var sup in Model.AvailableSupervisors)
                        {
                            <option value="@sup.Id">@sup.FullName (@sup.Email)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modal-weight-override')">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background:#7C3AED;border-color:#7C3AED;">Apply Weight Override</button>
            </div>
        </form>
    </div>
</div>
@if (canViewDispatchMap) {
    <!-- MapLibre GL JS & SignalR Client for Phase 2F Live Dispatch Map -->
    <script src="~/lib/maplibre-gl/maplibre-gl.js"></script>
    <script src="~/lib/signalr.min.js"></script>
    <script>
        (function () {
            const DISPATCH_MAP_CONFIG = {
                tileUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapSettings.TileUrl)),
                attribution: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapSettings.Attribution)),
                initialLat: @mapSettings.InitialLatitude,
                initialLng: @mapSettings.InitialLongitude,
                initialZoom: @mapSettings.InitialZoom
            };

            let dispatchMap = null;
            let dispatchConnection = null;
            let riderMarkers = {};
            let orderMarkers = {};
            let staleCheckInterval = null;

            window.initDispatchMap = function () {
                const mapEl = document.getElementById('dispatchMap');
                if (!mapEl) return;

                if (!dispatchMap) {
                    try {
                        dispatchMap = new maplibregl.Map({
                            container: 'dispatchMap',
                            style: {
                                version: 8,
                                sources: {
                                    'osm': {
                                        type: 'raster',
                                        tiles: [DISPATCH_MAP_CONFIG.tileUrl],
                                        tileSize: 256,
                                        attribution: DISPATCH_MAP_CONFIG.attribution
                                    }
                                },
                                layers: [{
                                    id: 'osm-layer',
                                    type: 'raster',
                                    source: 'osm',
                                    minzoom: 0,
                                    maxzoom: 19
                                }]
                            },
                            center: [DISPATCH_MAP_CONFIG.initialLng, DISPATCH_MAP_CONFIG.initialLat],
                            zoom: DISPATCH_MAP_CONFIG.initialZoom
                        });

                        dispatchMap.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
                        dispatchMap.on('load', function () {
                            dispatchMap.resize();
                        });
                    } catch (err) {
                        console.error('[DispatchMap] Failed to initialize MapLibre map:', err);
                        setDispatchStatus('offline', 'Map load error');
                        return;
                    }
                } else {
                    setTimeout(function () {
                        if (dispatchMap) dispatchMap.resize();
                    }, 100);
                }

                if (!dispatchConnection) {
                    connectDispatchSignalR();
                } else {
                    fetchActiveDispatchData();
                }

                if (!staleCheckInterval) {
                    staleCheckInterval = setInterval(checkStaleMarkers, 15000);
                }
            };

            window.refreshDispatchMap = function () {
                fetchActiveDispatchData();
            };

            async function connectDispatchSignalR() {
                try {
                    setDispatchStatus('offline', 'Connecting SignalR...');
                    dispatchConnection = new signalR.HubConnectionBuilder()
                        .withUrl('/orderHub')
                        .withAutomaticReconnect([2000, 5000, 10000, 30000])
                        .configureLogging(signalR.LogLevel.Warning)
                        .build();

                    dispatchConnection.on('RiderLocationUpdated', function (payload) {
                        if (!payload || !payload.riderId || !payload.orderId) return;
                        handleLiveLocationUpdate(payload);
                    });

                    dispatchConnection.onreconnecting(function () {
                        setDispatchStatus('stale', 'Reconnecting...');
                    });

                    dispatchConnection.onreconnected(async function () {
                        setDispatchStatus('live', 'Reconnected');
                        try {
                            await dispatchConnection.invoke('JoinDispatchGroup');
                        } catch (e) {
                            console.error('[DispatchMap] Rejoin error:', e);
                        }
                        fetchActiveDispatchData();
                    });

                    dispatchConnection.onclose(function () {
                        setDispatchStatus('offline', 'Disconnected');
                    });

                    await dispatchConnection.start();
                    const joined = await dispatchConnection.invoke('JoinDispatchGroup');
                    if (joined) {
                        setDispatchStatus('live', 'Live Dispatch Online');
                    } else {
                        setDispatchStatus('offline', 'Unauthorized for dispatch');
                    }

                    await fetchActiveDispatchData();
                } catch (err) {
                    console.error('[DispatchMap] SignalR connection failed:', err);
                    setDispatchStatus('stale', 'SignalR offline · Polling');
                    await fetchActiveDispatchData();
                }
            }

            async function fetchActiveDispatchData() {
                try {
                    const res = await fetch('/Admin/GetActiveRiderLocations', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) {
                        if (res.status === 403 || res.status === 401) {
                            setDispatchStatus('offline', 'Access restricted');
                        }
                        return;
                    }
                    const json = await res.json();
                    if (json && json.success && Array.isArray(json.data)) {
                        syncActiveRiders(json.data);
                    }
                } catch (err) {
                    console.error('[DispatchMap] Error fetching active riders:', err);
                }
            }

            function syncActiveRiders(activeList) {
                const activeKeys = new Set();
                const activeOrderIds = new Set();

                activeList.forEach(function (item) {
                    const key = item.riderId + '_' + item.orderId;
                    activeKeys.add(key);
                    activeOrderIds.add(item.orderId);

                    const hasCoords = item.latitude != null && item.longitude != null;
                    const isStale = item.updatedAt ? ((Date.now() - new Date(item.updatedAt).getTime()) > 120000) : true;

                    if (riderMarkers[key]) {
                        const entry = riderMarkers[key];
                        entry.data = item;
                        if (hasCoords) {
                            entry.marker.setLngLat([item.longitude, item.latitude]);
                            updateRiderMarkerVisual(entry.riderEl, isStale);
                            entry.marker.setPopup(createRiderPopup(item, isStale));
                        }
                    } else if (hasCoords) {
                        const markerObj = createRiderMarker(item, isStale);
                        riderMarkers[key] = {
                            marker: markerObj.marker,
                            riderEl: markerObj.element,
                            data: item
                        };
                    }

                    if (item.orderLatitude != null && item.orderLongitude != null) {
                        if (!orderMarkers[item.orderId]) {
                            orderMarkers[item.orderId] = createOrderMarker(item);
                        }
                    }
                });

                Object.keys(riderMarkers).forEach(function (key) {
                    if (!activeKeys.has(key)) {
                        riderMarkers[key].marker.remove();
                        delete riderMarkers[key];
                    }
                });

                Object.keys(orderMarkers).forEach(function (orderId) {
                    if (!activeOrderIds.has(parseInt(orderId, 10))) {
                        orderMarkers[orderId].remove();
                        delete orderMarkers[orderId];
                    }
                });

                updateRiderCountDisplay(activeList.length);
                fitDispatchMapBounds();
            }

            function handleLiveLocationUpdate(payload) {
                const key = payload.riderId + '_' + payload.orderId;
                const isStale = payload.updatedAt ? ((Date.now() - new Date(payload.updatedAt).getTime()) > 120000) : false;

                if (riderMarkers[key]) {
                    const entry = riderMarkers[key];
                    entry.data.latitude = payload.latitude;
                    entry.data.longitude = payload.longitude;
                    entry.data.updatedAt = payload.updatedAt;
                    entry.marker.setLngLat([payload.longitude, payload.latitude]);
                    updateRiderMarkerVisual(entry.riderEl, isStale);
                    entry.marker.setPopup(createRiderPopup(entry.data, isStale));
                } else {
                    fetchActiveDispatchData();
                }
            }

            function createRiderMarker(item, isStale) {
                const el = document.createElement('div');
                el.className = 'dispatch-rider-marker ' + (isStale ? 'is-stale' : 'is-live');
                el.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5.5 21v-2a6.5 6.5 0 0 1 13 0v2"/></svg>';
                el.title = (item.riderName || 'Rider') + ' (' + (item.orderNumber || '') + ')';

                const marker = new maplibregl.Marker({ element: el })
                    .setLngLat([item.longitude, item.latitude])
                    .setPopup(createRiderPopup(item, isStale))
                    .addTo(dispatchMap);

                return { marker: marker, element: el };
            }

            function updateRiderMarkerVisual(el, isStale) {
                if (!el) return;
                el.classList.remove('is-live', 'is-stale', 'is-waiting');
                el.classList.add(isStale ? 'is-stale' : 'is-live');
            }

            function createRiderPopup(item, isStale) {
                const updatedText = item.updatedAt
                    ? new Date(item.updatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })
                    : 'Unknown';
                const legLabel = item.trackingType === 'delivery' ? 'Delivery Leg' : 'Pickup Leg';
                const statusBadge = isStale
                    ? '<span style="color:#B45309;font-weight:700;">STALE (>2m ago)</span>'
                    : '<span style="color:#059669;font-weight:700;">LIVE</span>';

                const html = `
                    <div class="dispatch-popup">
                        <div class="dispatch-popup-title">${escapeHtml(item.riderName || 'Rider')}</div>
                        <div class="dispatch-popup-row"><strong>Order:</strong> ${escapeHtml(item.orderNumber || '')}</div>
                        <div class="dispatch-popup-row"><strong>Leg:</strong> ${legLabel}</div>
                        <div class="dispatch-popup-row"><strong>Stage:</strong> ${escapeHtml(item.status || '')}</div>
                        <div class="dispatch-popup-row"><strong>Signal:</strong> ${statusBadge} (${updatedText})</div>
                    </div>`;

                return new maplibregl.Popup({ offset: 24 }).setHTML(html);
            }

            function createOrderMarker(item) {
                const el = document.createElement('div');
                const isDel = item.trackingType === 'delivery';
                el.className = 'dispatch-order-marker ' + (isDel ? 'is-delivery' : 'is-pickup');
                el.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
                el.title = (isDel ? 'Delivery Destination: ' : 'Pickup Location: ') + item.orderNumber;

                const popupHtml = `
                    <div class="dispatch-popup">
                        <div class="dispatch-popup-title">${isDel ? 'Delivery Address' : 'Pickup Location'}</div>
                        <div class="dispatch-popup-row"><strong>Order:</strong> ${escapeHtml(item.orderNumber)}</div>
                    </div>`;

                return new maplibregl.Marker({ element: el })
                    .setLngLat([item.orderLongitude, item.orderLatitude])
                    .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(popupHtml))
                    .addTo(dispatchMap);
            }

            function checkStaleMarkers() {
                const now = Date.now();
                Object.values(riderMarkers).forEach(function (entry) {
                    if (!entry.data || !entry.data.updatedAt) return;
                    const isStale = (now - new Date(entry.data.updatedAt).getTime()) > 120000;
                    updateRiderMarkerVisual(entry.riderEl, isStale);
                    entry.marker.setPopup(createRiderPopup(entry.data, isStale));
                });
            }

            function fitDispatchMapBounds() {
                if (!dispatchMap) return;
                const bounds = new maplibregl.LngLatBounds();
                let count = 0;

                Object.values(riderMarkers).forEach(function (entry) {
                    if (entry.data && entry.data.longitude != null && entry.data.latitude != null) {
                        bounds.extend([entry.data.longitude, entry.data.latitude]);
                        count++;
                    }
                });

                Object.values(orderMarkers).forEach(function (marker) {
                    bounds.extend(marker.getLngLat());
                    count++;
                });

                if (count > 0 && !bounds.isEmpty()) {
                    dispatchMap.fitBounds(bounds, { padding: 60, maxZoom: 16, duration: 800 });
                } else {
                    dispatchMap.flyTo({ center: [DISPATCH_MAP_CONFIG.initialLng, DISPATCH_MAP_CONFIG.initialLat], zoom: DISPATCH_MAP_CONFIG.initialZoom });
                }
            }

            function setDispatchStatus(state, label) {
                const dot = document.getElementById('dispatchDot');
                const text = document.getElementById('dispatchStatusText');
                if (!dot || !text) return;

                dot.className = 'dispatch-dot';
                if (state === 'live') dot.classList.add('dot-live');
                else if (state === 'stale') dot.classList.add('dot-stale');
                else dot.classList.add('dot-offline');

                text.textContent = label;
            }

            function updateRiderCountDisplay(count) {
                const pill = document.getElementById('dispatchRidersPill');
                const text = document.getElementById('dispatchRidersCount');
                if (!pill || !text) return;

                pill.style.display = 'inline-flex';
                if (count === 0) {
                    text.textContent = 'No active rider tracking';
                } else if (count === 1) {
                    text.textContent = '1 active rider tracked';
                } else {
                    text.textContent = count + ' active riders tracked';
                }
            }

            function cleanup() {
                if (staleCheckInterval) {
                    clearInterval(staleCheckInterval);
                    staleCheckInterval = null;
                }
                if (dispatchConnection) {
                    try {
                        dispatchConnection.invoke('LeaveDispatchGroup').catch(function () {});
                        dispatchConnection.stop().catch(function () {});
                    } catch (_) {}
                    dispatchConnection = null;
                }
            }

            window.addEventListener('beforeunload', cleanup);
        })();
    </script>
}
</body>
</html>
