<table class="data-table" aria-label="Current stock overview">
                            <thead><tr><th>Item</th><th>Stock Level</th><th>% Full</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var item in activeInventoryItems) {
                                    var fillPct = item.MaxCapacity > 0 ? Math.Min(100m, Math.Max(0m, item.CurrentStock / item.MaxCapacity * 100m)) : 0m;
                                    var isOut = item.CurrentStock <= 0;
