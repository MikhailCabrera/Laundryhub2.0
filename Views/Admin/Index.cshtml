    <!-- SIDEBAR SCRIM (<=1024px) -->
    <div class="sidebar-scrim" id="sidebarScrim" aria-hidden="true"></div>

    <!-- MAIN CONTENT -->
    <main class="admin-main" id="admin-main-content" aria-label="Admin main content">

        <!-- DASHBOARD PANEL -->
        <div class="panel active" id="panel-dashboard">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Dashboard</h1>
                    <p class="panel-subtitle">Overview of laundry operations — updated on load.</p>
                </div>
            </div>

            <!-- Stat cards -->
            <div class="dash-stat-grid" id="dash-stat-grid">
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#EEF2FF;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4338CA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
                    <div class="dash-stat-label">Pending Pickups</div>
                    <div class="dash-stat-value" id="dash-pending">—</div>
                    <div class="dash-stat-sub">Awaiting rider assignment</div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#FFF7ED;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                    <div class="dash-stat-label">Orders in Progress</div>
                    <div class="dash-stat-value" id="dash-ongoing">—</div>
                    <div class="dash-stat-sub">Pickup → weighing → washing</div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#FEF3C7;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
                    <div class="dash-stat-label">Awaiting Payment</div>
                    <div class="dash-stat-value" id="dash-payment">—</div>
                    <div class="dash-stat-sub">Laundry done — payment pending</div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#ECFDF5;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                    <div class="dash-stat-label">Completed This Month</div>
                    <div class="dash-stat-value" id="dash-completed">—</div>
                    <div class="dash-stat-sub">Delivered orders</div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#EFF6FF;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
                    <div class="dash-stat-label">Total Customers</div>
                    <div class="dash-stat-value" id="dash-customers">—</div>
                    <div class="dash-stat-sub">Registered accounts</div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background:#F0FDF4;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
                    <div class="dash-stat-label">Total Employees</div>
                    <div class="dash-stat-value" id="dash-employees">—</div>
                    <div class="dash-stat-sub">Staff, riders, admins</div>
                </div>
            </div>

            <!-- Recent Activity placeholder -->
            <div class="card">
                <div class="card-header">
                    <div class="card-header-left">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span style="font-size:0.875rem;font-weight:600;color:var(--lh-text-headings);">Recent Activity</span>
                    </div>
                </div>
                <div class="card-body" style="padding:0 24px;">
                    <div id="dash-activity" style="padding:12px 0;">
                        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 0;gap:8px;color:var(--lh-text-muted);">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                            <p style="margin:0;font-size:0.875rem;">Recent orders will appear here once bookings are made.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAUNDRY SERVICE ORDERS PANEL -->
        <script type="application/json" id="walkin-customers">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customers.Where(c => !c.IsArchived).Select(c => new {
    id = c.Id,
    email = c.Email,
    fullName = c.FullName,
    phoneNumber = c.PhoneNumber
})))
        </script>
        <div class="panel" id="panel-orders">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Laundry Service Orders</h1>
                    <p class="panel-subtitle">All customer orders — assign pickup riders, track progress, manage processing.</p>
                </div>
                <button class="btn btn-primary" onclick="openWalkInModal()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Walk-in Order
                </button>
            </div>

            @if (TempData["SuccessMessage"] != null && ViewData["ActiveTab"]?.ToString() == "orders") {
                <div class="admin-alert admin-alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null && ViewData["ActiveTab"]?.ToString() == "orders") {
                <div class="admin-alert admin-alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Summary stats -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-label">Pending</div>
                    <div class="stat-value" style="color:var(--lh-blue-600)">@Model.PendingOrdersCount</div>
                    <div class="stat-sub">Awaiting rider</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">In Progress</div>
                    <div class="stat-value" style="color:#D97706">@Model.OngoingOrdersCount</div>
                    <div class="stat-sub">Pickup → delivery</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Awaiting Payment</div>
                    <div class="stat-value" style="color:#DC2626">@Model.AwaitingPaymentCount</div>
                    <div class="stat-sub">Clean, unpaid</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Completed</div>
                    <div class="stat-value" style="color:#059669">@Model.CompletedOrdersCount</div>
                    <div class="stat-sub">Delivered orders</div>
                </div>
            </div>

            <!-- Orders table card -->
            <div class="card">
                <div class="card-header" style="flex-wrap:wrap;gap:12px;">
                    <div class="card-header-left" style="flex-direction:column;align-items:flex-start;gap:8px;">
                        <div class="filter-chips" id="orders-filter-chips">
                            <span class="chip active" data-filter="all" onclick="filterOrders('all')">All (@Model.Orders.Count)</span>
                            <span class="chip" data-filter="pending" onclick="filterOrders('pending')">Pending (@Model.PendingOrdersCount)</span>
                            <span class="chip" data-filter="ongoing" onclick="filterOrders('ongoing')">In Progress (@(Model.OngoingOrdersCount + Model.AwaitingPaymentCount))</span>
                            <span class="chip" data-filter="completed" onclick="filterOrders('completed')">Completed (@Model.CompletedOrdersCount)</span>
                        </div>
                        <div class="filter-chips" id="orders-stage-chips" aria-label="Laundry processing stages">
                            <span class="chip" data-stage="Weighing" onclick="filterOrderStage('Weighing')">Waiting for Weight (@Model.Orders.Count(o => o.Status == OrderStatus.Weighing))</span>
                            <span class="chip" data-stage="WeightConfirmed" onclick="filterOrderStage('WeightConfirmed')">Confirm Weight (@Model.Orders.Count(o => o.Status == OrderStatus.WeightConfirmed))</span>
                            <span class="chip" data-stage="AwaitingPayment" onclick="filterOrderStage('AwaitingPayment')">Waiting for Payment (@Model.AwaitingPaymentCount)</span>
                            <span class="chip" data-stage="PaymentConfirmed" onclick="filterOrderStage('PaymentConfirmed')">Ready for Processing (@Model.Orders.Count(o => o.Status == OrderStatus.PaymentConfirmed))</span>
                            <span class="chip" data-stage="Washing" onclick="filterOrderStage('Washing')">Washing (@Model.Orders.Count(o => o.Status == OrderStatus.Washing))</span>
                            <span class="chip" data-stage="Drying" onclick="filterOrderStage('Drying')">Drying (@Model.Orders.Count(o => o.Status == OrderStatus.Drying))</span>
                            <span class="chip" data-stage="ReadyForDelivery" onclick="filterOrderStage('ReadyForDelivery')">Processing Complete (@Model.Orders.Count(o => o.Status == OrderStatus.ReadyForDelivery))</span>
                        </div>
                    </div>
                    <div class="search-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="search-input" id="orders-search" placeholder="Search orders..." oninput="searchOrders(this.value)" />
                    </div>
                </div>
                <div class="card-body">
                    @if (!Model.Orders.Any()) {
                        <div class="empty-state">
                            <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            <p>No orders yet. Customer orders will appear here once bookings are placed.</p>
                        </div>
                    } else {
                                                <div class="table-scroll">
<table class="data-table" id="orders-table" aria-label="Laundry service orders">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Services</th>
                                    <th>Weight / Total</th>
                                    <th>Pickup Date / Time</th>
                                    <th>Status</th>
                                    <th>Riders</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="orders-table-body">
                                @foreach (var order in Model.Orders) {
                                    var svcList = string.Join(", ", order.OrderServices.Select(os => os.Service?.Name ?? "?"));
                                    if (svcList.Length > 45) svcList = svcList.Substring(0, 42) + "...";
                                    var searchKey = $"{order.OrderNumber} {order.Customer?.FullName} {svcList} {order.ContactNumber}";
                                    var needsWashRow = order.OrderServices.Any(os => os.Service == null || os.Service.RequiresWashing);
                                    var needsDryRow = order.OrderServices.Any(os => os.Service == null || os.Service.RequiresDrying);
                                    var stageHint = order.Status switch {
                                        OrderStatus.Weighing => "Waiting for weight",
                                        OrderStatus.WeightConfirmed => "Waiting for customer confirm",
                                        OrderStatus.AwaitingPayment => (order.IsPaymentConfirmed ? "Paid" : "Waiting for payment"),
                                        OrderStatus.PaymentConfirmed => (!order.ProcessingCompletedAt.HasValue ? (needsWashRow ? "Next: Washing" : needsDryRow ? "Next: Drying" : "Next: Ready") : "Ready for delivery"),
                                        OrderStatus.Washing => (needsDryRow ? "Now: Washing → next Drying" : "Now: Washing → next Ready"),
                                        OrderStatus.Drying => "Now: Drying → next Ready",
                                        OrderStatus.ReadyForDelivery => "Processing complete",
                                        _ => ""
                                    };
                                    <tr class="ord-row" data-status-group="@OrderStatusGroup(order.Status)" data-status="@order.Status.ToString()" data-search="@searchKey.ToLower()">
                                        <td>
                                            <span style="font-weight:700;color:var(--lh-blue-600);font-size:0.825rem;font-family:var(--lh-font-heading);">@order.OrderNumber</span>
                                            <div style="font-size:0.7rem;color:var(--lh-text-muted);margin-top:2px;">@order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="user-cell">
                                                <div class="user-avatar" style="background:var(--lh-blue-600);font-size:0.6rem;">@OrderInitials(order.Customer?.FullName)</div>
                                                <div>
                                                    <div class="user-name">@(order.Customer?.FullName ?? "Unknown")</div>
                                                    <div class="user-email">@order.ContactNumber</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="font-size:0.8125rem;max-width:180px;">
                                            <div>@(svcList.Length > 0 ? svcList : "—")</div>
                                            @if (!string.IsNullOrEmpty(stageHint)) {
                                                <div style="font-size:0.7rem;color:var(--lh-text-muted);margin-top:2px;">@stageHint</div>
                                            }
                                            @if (order.IsPaymentConfirmed) {
                                                <div style="font-size:0.7rem;color:#059669;font-weight:700;margin-top:2px;">Paid</div>
                                            } else if (order.TotalAmount.HasValue) {
                                                <div style="font-size:0.7rem;color:#DC2626;font-weight:700;margin-top:2px;">Unpaid</div>
                                            }
                                        </td>
                                        <td>
                                            <div style="font-size:0.8125rem;font-weight:600;color:var(--lh-text-headings);">@(order.WeightKg.HasValue ? $"{order.WeightKg.Value:N2} kg" : "—")</div>
                                            <div style="font-size:0.8125rem;font-weight:700;color:var(--lh-text-headings);">@(order.TotalAmount.HasValue ? $"₱{order.TotalAmount.Value:N2}" : "Pending")</div>
                                        </td>
                                        <td>
                                            <div style="font-size:0.8125rem;font-weight:600;color:var(--lh-text-headings);">@order.PreferredPickupDate.ToString("MMM d, yyyy")</div>
                                            <div style="font-size:0.75rem;color:var(--lh-text-muted);">@order.PreferredPickupTime</div>
                                        </td>
                                        <td><span class="@OrderStatusBadgeClass(order.Status)">@OrderStatusLabel(order.Status)</span></td>
                                        <td>
                                            @if (order.PickupRider != null || order.DeliveryRider != null || order.DeliveredAt.HasValue || !string.IsNullOrEmpty(order.DeliveryPhotoPath)) {
                                                <div style="display:flex;flex-direction:column;gap:8px;">
                                                    @if (order.PickupRider != null) {
                                                        <div class="rider-cell">
                                                            <div class="rider-avatar">@OrderInitials(order.PickupRider.FullName)</div>
                                                            <div>
                                                                <div class="user-name" style="font-size:0.8125rem;">Pickup: @order.PickupRider.FullName</div>
                                                                <div class="user-email">@(order.PickupRider.PhoneNumber ?? "")</div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (order.DeliveryRider != null) {
                                                        <div class="rider-cell">
                                                            <div class="rider-avatar" style="background:#F97316;">@OrderInitials(order.DeliveryRider.FullName)</div>
                                                            <div>
                                                                <div class="user-name" style="font-size:0.8125rem;">Delivery: @order.DeliveryRider.FullName</div>
                                                                <div class="user-email">
                                                                    @if (order.DeliveredAt.HasValue) {
                                                                        <span>Delivered @order.DeliveredAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                                                    } else if (order.DeliveryAssignedAt.HasValue) {
                                                                        <span>Dispatched @order.DeliveryAssignedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                                                    } else {
                                                                        <span>Assigned</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(order.DeliveryPhotoPath)) {
                                                        <a href="@order.DeliveryPhotoPath" target="_blank" rel="noopener" class="btn btn-ghost btn-sm" style="align-self:flex-start;">View delivery proof</a>
                                                    }
                                                </div>
                                            } else {
                                                <span style="color:var(--lh-text-muted);font-size:0.8125rem;">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="td-actions">
                                                @if (order.Status == OrderStatus.Pending) {
                                                    <button class="btn btn-primary btn-sm" onclick="openAssignRiderModal(@order.Id, '@order.OrderNumber')">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                                        Assign Rider
                                                    </button>
                                                } else if (order.Status == OrderStatus.Weighing) {
                                                     var rate = order.OrderServices.Sum(os => os.PricePerKgSnapshot);
                                                     <button class="btn btn-primary btn-sm" style="background:#7C3AED;border-color:#7C3AED;" onclick="openWeighModal(@order.Id, '@order.OrderNumber', @rate)">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                                        Enter Weight
                                                    </button>
                                                 } else if (order.Status == OrderStatus.WeightConfirmed) {
                                                     var nowUtc = DateTime.UtcNow;
                                                     var initDeadline = order.WeightConfirmationDeadline;
                                                     var extDeadline = order.WeightConfirmationExtensionDeadline;
                                                     var canOverride = initDeadline.HasValue && nowUtc > initDeadline.Value && extDeadline.HasValue && nowUtc > extDeadline.Value;
                                                     <div style="display:flex;flex-direction:column;gap:6px;">
                                                         <span class="role-badge" style="background:#FFFBEB;color:#B45309;border-color:#FDE68A;">Awaiting customer confirmation</span>
                                                         @if (initDeadline.HasValue) {
                                                             <span style="font-size:0.75rem;color:var(--lh-text-muted);">Initial deadline: @initDeadline.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                                         }
                                                         @if (extDeadline.HasValue) {
                                                             <span style="font-size:0.75rem;color:var(--lh-text-muted);">Extension deadline: @extDeadline.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                                         }
                                                         <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
                                                             <button type="button" class="btn btn-secondary btn-sm" onclick="openContactAttemptModal(@order.Id, '@order.OrderNumber')">Record Contact</button>
                                                             <button type="button" class="btn btn-warning btn-sm" onclick="openExtendDeadlineModal(@order.Id, '@order.OrderNumber')">Extend Deadline</button>
                                                             @if (canOverride) {
                                                                 <button type="button" class="btn btn-primary btn-sm" style="background:#7C3AED;border-color:#7C3AED;" onclick="openWeightOverrideModal(@order.Id, '@order.OrderNumber', @(order.WeightKg ?? 0))">Weight Override</button>
                                                             } else {
                                                                 <button type="button" class="btn btn-sm" style="background:#94A3B8;border-color:#94A3B8;color:#FFF;" disabled title="Override available only after initial & extension deadlines have passed.">Override locked</button>
                                                             }
                                                         </div>
                                                     </div>
                                                } else if (order.Status == OrderStatus.Washing) {
                                                    var needsDryW = order.OrderServices.Any(os => os.Service == null || os.Service.RequiresDrying);
                                                    if (needsDryW) {
                                                        <form method="post" asp-controller="Admin" asp-action="MarkDrying" asp-route-id="@order.Id" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-warning btn-sm" style="background:#D97706;border-color:#D97706;color:#FFF;" title="Washing done — advance this order to Drying.">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                                                                Mark Washing Complete
                                                            </button>
                                                        </form>
                                                    } else {
                                                        <form method="post" asp-controller="Admin" asp-action="ProcessingComplete" asp-route-id="@order.Id" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-success btn-sm" style="background:#059669;border-color:#059669;color:#FFF;" title="Washing done — no drying required.">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                                                Mark Washing Complete
                                                            </button>
                                                        </form>
                                                    }
                                                } else if (order.Status == OrderStatus.Drying) {
                                                    <form method="post" asp-controller="Admin" asp-action="ProcessingComplete" asp-route-id="@order.Id" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm" style="background:#059669;border-color:#059669;color:#FFF;" title="Drying done — mark processing complete.">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                                            Mark Drying Complete
                                                        </button>
                                                    </form>
                                                } else if (order.Status == OrderStatus.AwaitingPayment) {
                                                    <span class="role-badge" style="background:#FEF2F2;color:#DC2626;border-color:#FCA5A5;" title="Payment required before processing. Washing cannot start until payment is confirmed.">Awaiting Payment — payment required before processing</span>
                                                 } else if (order.Status == OrderStatus.PaymentConfirmed && !order.ProcessingCompletedAt.HasValue) {
                                                     var needsWashP = order.OrderServices.Any(os => os.Service == null || os.Service.RequiresWashing);
                                                     var needsDryP = order.OrderServices.Any(os => os.Service == null || os.Service.RequiresDrying);
                                                     <div style="display:flex;flex-direction:column;gap:6px;">
                                                         <span class="role-badge" style="background:#ECFDF5;color:#065F46;border-color:#A7F3D0;">Paid — ready for processing</span>
                                                         @if (needsWashP) {
                                                             <form method="post" asp-controller="Admin" asp-action="StartWashing" asp-route-id="@order.Id" style="display:inline;">
                                                                 @Html.AntiForgeryToken()
                                                                 <button type="submit" class="btn btn-primary btn-sm" title="Begin the washing stage for this paid order.">Start Washing</button>
                                                             </form>
                                                         } else if (needsDryP) {
                                                             <form method="post" asp-controller="Admin" asp-action="StartDrying" asp-route-id="@order.Id" style="display:inline;">
                                                                 @Html.AntiForgeryToken()
                                                                 <button type="submit" class="btn btn-warning btn-sm" style="background:#D97706;border-color:#D97706;color:#FFF;" title="Begin drying for this dry-only paid order.">Start Drying</button>
                                                             </form>
                                                         } else {
                                                             <form method="post" asp-controller="Admin" asp-action="ProcessingComplete" asp-route-id="@order.Id" style="display:inline;">
                                                                 @Html.AntiForgeryToken()
                                                                 <button type="submit" class="btn btn-success btn-sm" style="background:#059669;border-color:#059669;color:#FFF;" title="No wash/dry stage required — mark ready for delivery.">Mark Ready</button>
                                                             </form>
                                                         }
                                                     </div>
                                                 } else if (order.Status == OrderStatus.ReadyForDelivery || order.Status == OrderStatus.DeliveryAttemptFailed || (order.Status == OrderStatus.PaymentConfirmed && order.ProcessingCompletedAt.HasValue)) {
                                                    <button class="btn btn-primary btn-sm" style="background:#059669;border-color:#059669;" onclick="openAssignDeliveryModal(@order.Id, '@order.OrderNumber')">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                                        Assign Delivery Rider
                                                    </button>
                                                } else {
                                                    <span style="font-size:0.75rem;color:var(--lh-text-muted);">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div id="orders-empty-filtered" class="empty-state" style="display:none;">
                            <p>No orders match the current filter. Try a different stage or search.</p>
                        </div>
                        <div id="orders-pagination" aria-label="Laundry service orders pagination"></div>
                    }
                </div>
            </div>

            <div class="card" style="margin-top:16px;">
                <div class="card-header">
                    <div class="card-header-left">
                        <h3 class="card-service-title" style="margin:0;">Damage / Loss Claims</h3>
                    </div>
                </div>
                <div class="card-body">
                    <div class="filter-row" style="margin-bottom:12px;">
                        <span class="filter-label">Order #:</span>
                        <input type="text" class="form-control" id="claim-order-number" placeholder="e.g. LH-20260928-0001" style="max-width:220px;" />
                        <span class="filter-label">Type:</span>
                        <select class="filter-select" id="claim-type">
                            <option value="Damage">Damage</option>
                            <option value="Loss">Loss</option>
                            <option value="Other">Other</option>
                        </select>
                        <input type="text" class="form-control" id="claim-description" maxlength="1000" placeholder="What was damaged or lost..." style="flex:1;min-width:200px;" />
                        <button class="btn btn-primary btn-sm" onclick="submitClaim()">File Claim</button>
                    </div>
                    <span class="form-error" id="err-claim"></span>
                    <h4 style="margin:16px 0 8px;font-size:0.9rem;">Open Claims (@Model.Claims.Count(c => c.Status == "Open"))</h4>
                    @if (!Model.Claims.Any(c => c.Status == "Open")) {
                        <p style="font-size:0.85rem;color:var(--lh-text-muted);">No open claims.</p>
                    } else {
                                                <div class="table-scroll">
<table class="data-table" id="open-claims-table" aria-label="Open claims">
                            <thead><tr><th>Claim #</th><th>Order #</th><th>Type</th><th>Reported By</th><th>Description</th>@if (canClaimsResolve) {<th>Resolve</th>}</tr></thead>
                            <tbody id="open-claims-body">
                                @foreach (var claim in Model.Claims.Where(c => c.Status == "Open")) {
                                    <tr>
                                        <td style="font-weight:700;">@claim.Id</td>
                                        <td style="font-size:0.8125rem;">@(claim.Order?.OrderNumber ?? ("#" + claim.OrderId))</td>
                                        <td><span class="ord-badge ord-awaiting-payment">@claim.Type</span></td>
                                        <td style="font-size:0.8125rem;">@claim.ReporterName</td>
                                        <td style="font-size:0.8125rem;max-width:280px;">@claim.Description</td>
                                        @if (canClaimsResolve) {
                                        <td>
                                            <div class="filter-row">
                                                <select class="filter-select" id="claim-status-@claim.Id">
                                                    <option value="Resolved">Resolved</option>
                                                    <option value="Rejected">Rejected</option>
                                                </select>
                                                <input type="text" class="form-control" id="claim-note-@claim.Id" maxlength="500" placeholder="Resolution note (required)" style="min-width:180px;" />
                                                <button class="btn btn-success btn-sm" onclick="resolveClaim(@claim.Id)">Resolve</button>
                                            </div>
                                            <span class="form-error" id="err-claim-@claim.Id"></span>
                                        </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div id="open-claims-pagination" aria-label="Open claims pagination"></div>
                    }
                    <h4 style="margin:20px 0 8px;font-size:0.9rem;">Resolved History</h4>
                    @if (!Model.Claims.Any(c => c.Status != "Open")) {
                        <p style="font-size:0.85rem;color:var(--lh-text-muted);">No resolved claims yet.</p>
                    } else {
                                                <div class="table-scroll">
<table class="data-table" id="resolved-claims-table" aria-label="Resolved claims">
                            <thead><tr><th>Claim #</th><th>Order #</th><th>Type</th><th>Status</th><th>Resolution</th></tr></thead>
                            <tbody id="resolved-claims-body">
                                @foreach (var claim in Model.Claims.Where(c => c.Status != "Open")) {
                                    <tr>
                                        <td style="font-weight:700;">@claim.Id</td>
                                        <td style="font-size:0.8125rem;">@(claim.Order?.OrderNumber ?? ("#" + claim.OrderId))</td>
                                        <td style="font-size:0.8125rem;">@claim.Type</td>
                                        <td><span class="@(claim.Status == "Resolved" ? "status-badge status-active" : "status-badge status-archived")">@claim.Status</span></td>
                                        <td style="font-size:0.8125rem;max-width:320px;">@claim.ResolutionNote</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div id="resolved-claims-pagination" aria-label="Resolved claims pagination"></div>
                    }
                </div>
            </div>
        </div>

