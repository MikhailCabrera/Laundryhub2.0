            <td><div class="user-cell">
                <div class="user-avatar" style="background:${avatarColor(c.fullName || '?')}">${initials(c.fullName || '?')}</div>
                <div><div class="user-name">${escapeHtml(c.fullName)}</div><div class="user-email">${escapeHtml(c.email)}</div></div>
            </div></td>
            <td><div style="font-size:0.8125rem;">${escapeHtml(c.phoneNumber || '—')}</div><div class="user-email">${escapeHtml(c.district || '')}</div></td>
