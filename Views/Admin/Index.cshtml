        }
        @if (canUserManagement) {
        <script type="application/json" id="customer-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customers.Select(c => new {
    id = c.Id,
    fullName = c.FullName,
    email = c.Email,
    phoneNumber = c.PhoneNumber,
    district = c.District,
    role = c.Role,
    isSuspended = c.IsSuspended,
