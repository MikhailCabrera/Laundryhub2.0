        <script type="application/json" id="billing-data">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Orders.Where(o => o.WeightConfirmedAt.HasValue).OrderByDescending(o => o.WeightConfirmedAt).Select(o => new {
    id = o.Id,
    orderNumber = o.OrderNumber,
    customerName = o.Customer != null ? o.Customer.FullName : "Unknown",
    contactNumber = o.ContactNumber,
    weightKg = o.WeightKg,
    baseAmount = o.TotalAmount,
    penalty = o.AccruedPenaltyAmount ?? 0m,
    totalDue = (o.TotalAmount ?? 0m) + (o.AccruedPenaltyAmount ?? 0m),
    isPaid = o.IsPaymentConfirmed,
    weightConfirmedAt = JsonUtc(o.WeightConfirmedAt),
    paymentDeadline = JsonUtc(o.PaymentDeadlineAt ?? o.ReadyForDeliveryNotifiedAt?.AddHours(24)),
    gracePeriodEnd = JsonUtc(o.GracePeriodEndAt ?? (o.PaymentDeadlineAt?.AddHours(72) ?? o.ReadyForDeliveryNotifiedAt?.AddHours(96))),
    paymentConfirmedAt = JsonUtc(o.PaymentConfirmedAt),
    paymentReference = o.PayMongoPaymentId,
    checkoutUrl = o.PayMongoCheckoutUrl
})))
        </script>
        <div class="panel" id="panel-billing">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h1 class="panel-title">Billing</h1>
