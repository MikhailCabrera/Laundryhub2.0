var currentWeighRate = 0;
function openWeighModal(orderId, orderNumber, serviceRate) {
    document.getElementById('weigh-order-id').value = orderId;
    document.getElementById('weigh-order-display').value = orderNumber;
    currentWeighRate = Number(serviceRate) || 0;
    document.getElementById('weigh-input-kg').value = '';
    if (currentWeighRate > 0) {
        document.getElementById('weigh-rate-display').value = '₱' + currentWeighRate.toFixed(2) + ' / kg';
        document.getElementById('weigh-calculated-total').textContent = '₱0.00';
    } else {
        document.getElementById('weigh-rate-display').value = 'Rate unavailable';
        document.getElementById('weigh-calculated-total').textContent = '—';
    }
    openModal('modal-weigh-order');
}

function recalcWeightTotal() {
    if (!(currentWeighRate > 0)) {
        document.getElementById('weigh-calculated-total').textContent = '—';
        return;
    }
    const val = parseFloat(document.getElementById('weigh-input-kg').value) || 0;
    const total = val * currentWeighRate;
    document.getElementById('weigh-calculated-total').textContent = '₱' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function openAssignDeliveryModal(orderId, orderNumber) {
    document.getElementById('assign-delivery-order-id').value = orderId;
    document.getElementById('assign-delivery-order-display').value = orderNumber;
    const sel = document.getElementById('assign-delivery-select');
    if (sel) sel.value = '';
    openModal('modal-assign-delivery');
}

let billingTableMgr = null;
let billingPaymentFilter = 'all';

function escapeBillingText(value) {
    return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function formatBillingPeso(value) {
    return '₱' + Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function formatBillingWeight(value) {
    if (value === null || value === undefined || value === '') return '—';
    return Number(value).toFixed(2) + ' kg';
}

function formatBillingDateTime(value) {
    if (!value) return '—';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return '—';
    return formatDT(parsed);
}

function billingPaymentBadge(isPaid) {
    return isPaid ? '<span class="ord-badge ord-payment-confirmed">Paid</span>' : '<span class="ord-badge ord-awaiting-payment">Unpaid</span>';
}

function billingDeadlineCell(deadline) {
    if (!deadline) return '<span style="font-size:0.75rem;color:var(--lh-text-muted);">Awaiting ready notice</span>';
    return escapeBillingText(formatBillingDateTime(deadline));
}

function getBillingTransactions() {
    const dataElement = document.getElementById('billing-data');
    if (!dataElement) return [];
    try {
        const items = JSON.parse(dataElement.textContent || '[]');
        return Array.isArray(items) ? items : [];
    } catch (error) {
        return [];
    }
}

