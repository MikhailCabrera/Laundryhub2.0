    customerName = o.Customer != null ? o.Customer.FullName : "Unknown",
    contactNumber = o.ContactNumber,
    riderName = o.PickupRider != null ? o.PickupRider.FullName : "Unassigned",
    riderPhone = o.PickupRider != null ? o.PickupRider.PhoneNumber : null,
    status = o.Status.ToString(),
    createdAt = JsonUtc(o.CreatedAt),
    riderAssignedAt = JsonUtc(o.RiderAssignedAt),
    pickedUpAt = JsonUtc(o.PickedUpAt),
    pickupPhoto = o.PickupPhotoPath,
    weightConfirmedAt = JsonUtc(o.WeightConfirmedAt),
    washingStartedAt = JsonUtc(o.WashingStartedAt),
    dryingStartedAt = JsonUtc(o.DryingStartedAt),
