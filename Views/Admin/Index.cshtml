        crmTableMgr = new TableManager({
            tableBodyId: 'crm-table-body',
            paginationContainerId: 'crm-pagination',
            emptyStateId: 'crm-empty',
            searchInputId: 'crm-search',
            pageSize: 10,
            renderRow: renderCrmRow,
