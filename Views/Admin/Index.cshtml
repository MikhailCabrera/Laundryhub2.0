let crmTableMgr = null;
let crmCustomers = [];
let crmLegs = [];
let crmSegmentFilter = 'all';
let crmHighValueIds = null;
const CRM_NEW_DAYS = 30;
const CRM_DORMANT_DAYS = 60;
const CRM_HIGH_VALUE_FRACTION = 0.1;

function crmOrderDate(iso){
    if(!iso) return null;
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? null : d.getTime();
}

function crmComputeHighValueIds(items){
    const ranked = items.filter(c => (c.lifetimeSpend || 0) > 0).sort((a, b) => (b.lifetimeSpend || 0) - (a.lifetimeSpend || 0));
    const cutoff = Math.max(1, Math.ceil(ranked.length * CRM_HIGH_VALUE_FRACTION));
    return new Set(ranked.slice(0, cutoff).map(c => c.id));
}

function crmSegment(c){
    const now = Date.now();
    const dayMs = 86400000;
    if(crmHighValueIds !== null && crmHighValueIds.has(c.id)) return 'highvalue';
    const dates = (c.orders || []).map(o => crmOrderDate(o.createdAt)).filter(t => t !== null);
    if(dates.length && (now - Math.min.apply(null, dates)) < CRM_NEW_DAYS * dayMs) return 'new';
    if(!dates.filter(t => (now - t) <= CRM_DORMANT_DAYS * dayMs).length) return 'dormant';
    return 'active';
}

function crmSegmentBadge(segment){
    const map = { new:'ord-badge ord-washing', active:'ord-badge ord-payment-confirmed', dormant:'ord-badge ord-awaiting-payment', highvalue:'ord-badge ord-rider-assigned' };
    const labels = { new:'New', active:'Active', dormant:'Dormant', highvalue:'High-value' };
    return '<span class="' + (map[segment] || 'ord-badge ord-default') + '">' + escapeHtml(labels[segment] || segment) + '</span>';
}

function crmPeso(value){
    return '₱' + Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function crmDateText(iso){
    const t = crmOrderDate(iso);
    return t === null ? '—' : formatDT(new Date(t));
}

function renderCrmRow(c){
