            </div>
            <div class="stats-row" id="billing-stats"></div>
            <div class="card">
                <div class="card-header" style="flex-wrap:wrap;gap:12px;">
                    <div class="card-header-left" style="flex-wrap:wrap;gap:10px;">
                        <div class="filter-chips" id="billing-status-chips">
                            <span class="chip active" data-payment-status="all" onclick="filterBilling('all')">All (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue))</span>
                            <span class="chip" data-payment-status="paid" onclick="filterBilling('paid')">Paid (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue && o.IsPaymentConfirmed))</span>
                            <span class="chip" data-payment-status="unpaid" onclick="filterBilling('unpaid')">Unpaid (@Model.Orders.Count(o => o.WeightConfirmedAt.HasValue && !o.IsPaymentConfirmed))</span>
                        </div>
                    </div>
                    <div class="search-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="search-input" id="billing-search" placeholder="Search order # or customer..." />
                    </div>
                </div>
                <div class="card-body">
                                        <div class="table-scroll">
