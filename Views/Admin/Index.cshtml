@Html.Raw(System.Text.Json.JsonSerializer.Serialize(loyaltyMembers))
        </script>
        <script type="application/json" id="loyalty-totals">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(loyaltyTotals))
        </script>
