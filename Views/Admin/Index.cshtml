/* ============================================================
   ORDERS PANEL
   ============================================================ */
var currentOrderFilter = 'all';
var currentOrderStage = '';
var currentOrdersPage = 1;
var ordersPageSize = 10;

function filterOrders(filter) {
    currentOrderFilter = filter;
    currentOrderStage = '';
    currentOrdersPage = 1;
    document.querySelectorAll('#orders-filter-chips .chip').forEach(c => {
        c.classList.toggle('active', c.dataset.filter === filter);
    });
    document.querySelectorAll('#orders-stage-chips .chip').forEach(c => c.classList.remove('active'));
    applyOrderFilters();
}

function filterOrderStage(stage) {
    currentOrdersPage = 1;
    if (currentOrderStage === stage) {
        currentOrderStage = '';
        document.querySelectorAll('#orders-stage-chips .chip').forEach(c => c.classList.remove('active'));
    } else {
        currentOrderStage = stage;
        document.querySelectorAll('#orders-stage-chips .chip').forEach(c => {
            c.classList.toggle('active', c.dataset.stage === stage);
        });
    }
    applyOrderFilters();
}

function searchOrders(q) {
    currentOrdersPage = 1;
    applyOrderFilters(q);
}

function ordersGoToPage(page) {
    currentOrdersPage = page;
    applyOrderFilters();
}

function applyOrderFilters(q) {
    const term = (q !== undefined ? q : (document.getElementById('orders-search')?.value || '')).toLowerCase().trim();
    const rows = Array.from(document.querySelectorAll('#orders-table .ord-row'));
    const matched = rows.filter(row => {
        const grp = row.dataset.statusGroup || '';
        const st = row.dataset.status || '';
        const txt = row.dataset.search || '';
        const matchFilter = currentOrderFilter === 'all' || grp === currentOrderFilter;
        const matchStage = !currentOrderStage || st === currentOrderStage;
        const matchSearch = !term || txt.includes(term);
        return matchFilter && matchStage && matchSearch;
    });
    const totalPages = Math.max(1, Math.ceil(matched.length / ordersPageSize));
    if (currentOrdersPage > totalPages) currentOrdersPage = totalPages;
    const start = (currentOrdersPage - 1) * ordersPageSize;
    const end = Math.min(start + ordersPageSize, matched.length);
    const visible = new Set(matched.slice(start, end));
    rows.forEach(row => row.classList.toggle('hidden', !visible.has(row)));
    const emptyEl = document.getElementById('orders-empty-filtered');
    if (emptyEl) emptyEl.style.display = matched.length === 0 ? 'block' : 'none';
    renderOrdersPagination(matched.length, totalPages, start, end);
}

function renderOrdersPagination(total, totalPages, start, end) {
    const c = document.getElementById('orders-pagination');
    if (!c) return;
    if (total === 0) { c.innerHTML = ''; return; }
    let nums = '';
    const sPage = Math.max(1, Math.min(currentOrdersPage - 2, totalPages - 4));
    const ePage = Math.min(totalPages, sPage + 4);
    for (let p = Math.max(1, ePage - 4); p <= ePage; p++) {
        nums += `<button type="button" class="lh-page-btn ${p === currentOrdersPage ? 'active' : ''}" onclick="ordersGoToPage(${p})">${p}</button>`;
    }
    c.innerHTML = `<div class="lh-pagination-wrapper"><div class="lh-pagination-info">Showing <strong>${total === 0 ? 0 : start + 1}</strong> to <strong>${end}</strong> of <strong>${total}</strong> entries</div><div class="lh-pagination-nav"><button type="button" class="lh-page-btn lh-page-prev" ${currentOrdersPage <= 1 ? 'disabled' : ''} onclick="ordersGoToPage(${currentOrdersPage - 1})">Previous</button><div class="lh-page-numbers">${nums}</div><button type="button" class="lh-page-btn lh-page-next" ${currentOrdersPage >= totalPages ? 'disabled' : ''} onclick="ordersGoToPage(${currentOrdersPage + 1})">Next</button></div></div>`;
}

