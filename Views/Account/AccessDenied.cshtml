@{
    Layout = null;
    ViewData["Title"] = "Access Denied | Laundry Hub Davao City";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Page has no page-scoped vars; all tokens (--lh-*) load from the canonical wwwroot/css/site.css linked above. */
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--lh-blue-10);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }
        .card {
            background: var(--lh-white);
            border: 1px solid var(--lh-border-light);
            border-radius: var(--lh-radius-lg);
            padding: 40px;
            max-width: 440px;
            text-align: center;
            box-shadow: var(--lh-shadow-lg);
        }
        .icon {
            width: 64px;
            height: 64px;
            background: #FEE2E2;
            color: #DC2626;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }
        h1 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.5rem;
            color: var(--lh-text-headings);
            margin: 0 0 10px 0;
        }
        p {
            color: var(--lh-text-muted);
            font-size: 0.9rem;
            margin: 0 0 24px 0;
            line-height: 1.5;
        }
        .btn {
            display: inline-block;
            background: var(--lh-blue-500);
            color: #fff;
            padding: 10px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h1>Access Restricted</h1>
        <p>You do not have the required permissions to view this portal. Please contact your manager or system administrator.</p>
        <a href="/" class="btn">Return to Home</a>
    </div>
</body>
</html>
