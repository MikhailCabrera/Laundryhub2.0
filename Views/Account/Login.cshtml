@model LaundryHub2._0.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Log In | Laundry Hub Davao City";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Log in to your Laundry Hub account to schedule pickups, track orders, and manage laundry in Davao City." />

    <!-- Google Fonts: Plus Jakarta Sans for Headlines, Inter for Body -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Blue and White Theme */
            --brand-darkest: #071324;
            --brand-dark: #0B1E36;
            --brand-primary: #102A4C;
            --brand-medium: #163865;
            --brand-blue: #1D4ED8;
            --brand-royal: #2563EB;
            --brand-accent: #38BDF8;
            --brand-accent-glow: rgba(56, 189, 248, 0.28);
            --brand-sky-light: #EFF6FF;
            --brand-sky-border: #BFDBFE;

            /* Neutrals & UI */
            --bg-white: #FFFFFF;
            --bg-offwhite: #F8FAFC;
            --bg-subtle: #F1F5F9;
            --text-heading: #0F172A;
            --text-body: #334155;
            --text-muted: #64748B;
            --border-light: #E2E8F0;
            --border-hover: #CBD5E1;
            --border-focus: #2563EB;

            --c-danger: #EF4444;
            --c-danger-bg: #FEF2F2;
            --c-danger-border: #FECACA;

            --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --transition-smooth: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100vh;
            font-family: var(--font-body);
            color: var(--text-body);
            background-color: var(--bg-white);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .auth-split-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }

        /* LEFT BRAND PANEL (Deep Navy to Royal Blue Gradient) */
        .brand-panel {
            flex: 1 1 45%;
            max-width: 48%;
            background: radial-gradient(circle at 20% 20%, #163865 0%, var(--brand-dark) 55%, var(--brand-darkest) 100%);
            position: relative;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #FFFFFF;
            overflow: hidden;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.08);
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: 
                radial-gradient(circle at 80% 90%, rgba(37, 99, 235, 0.16) 0%, transparent 60%),
                linear-gradient(135deg, rgba(255,255,255,0.03) 25%, transparent 25%),
                linear-gradient(225deg, rgba(255,255,255,0.03) 25%, transparent 25%),
                linear-gradient(315deg, rgba(255,255,255,0.03) 25%, transparent 25%),
                linear-gradient(45deg, rgba(255,255,255,0.03) 25%, transparent 25%);
            background-size: 100% 100%, 60px 60px, 60px 60px, 60px 60px, 60px 60px;
            pointer-events: none;
            opacity: 0.7;
        }

        .ambient-glow-1 {
            position: absolute;
            width: 380px;
            height: 380px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.22) 0%, transparent 70%);
            top: -60px;
            right: -80px;
            pointer-events: none;
            filter: blur(40px);
        }

        .ambient-glow-2 {
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.16) 0%, transparent 70%);
            bottom: 40px;
            left: -60px;
            pointer-events: none;
            filter: blur(50px);
        }

        .brand-header-top {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo-link {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: #FFFFFF;
        }

        .brand-logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: var(--transition-smooth);
        }

        .brand-logo-link:hover .brand-logo-icon {
            transform: scale(1.05) rotate(2deg);
        }

        .brand-logo-text {
            display: flex;
            flex-direction: column;
        }

        .brand-name {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #FFFFFF;
        }

        .brand-city {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--brand-accent);
        }

        .brand-content {
            position: relative;
            z-index: 2;
            margin: 48px 0;
        }

        .brand-tagline-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            font-size: 0.8125rem;
            font-weight: 600;
            color: #BAE6FD;
            margin-bottom: 24px;
        }

        .brand-tagline-badge svg {
            color: var(--brand-accent);
        }

        .brand-headline {
            font-family: var(--font-heading);
            font-size: 2.35rem;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.03em;
            color: #FFFFFF;
            margin-bottom: 20px;
        }

        .accent-highlight {
            color: var(--brand-accent);
            text-shadow: 0 0 24px var(--brand-accent-glow);
            position: relative;
            display: inline;
        }

        .brand-subtext {
            font-size: 1rem;
            color: #94A3B8;
            line-height: 1.6;
            margin-bottom: 32px;
            max-width: 480px;
        }

        .value-props-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-width: 490px;
        }

        .value-prop-card {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 14px 18px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            transition: var(--transition-smooth);
        }

        .value-prop-card:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(56, 189, 248, 0.35);
            transform: translateX(4px);
        }

        .value-prop-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(56, 189, 248, 0.18);
            color: var(--brand-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .value-prop-text h4 {
            font-family: var(--font-heading);
            font-size: 0.9375rem;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 2px;
        }

        .value-prop-text p {
            font-size: 0.8125rem;
            color: #CBD5E1;
            line-height: 1.4;
        }

        .brand-footer {
            position: relative;
            z-index: 2;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8125rem;
            color: #94A3B8;
        }

        .proof-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #E2E8F0;
        }

        .stars-row {
            color: #FBBF24;
            display: inline-flex;
            gap: 2px;
        }

        /* RIGHT FORM PANEL (Crisp White and Clean Blue Accents) */
        .form-panel {
            flex: 1 1 55%;
            background-color: var(--bg-white);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px 56px;
            position: relative;
            overflow-y: auto;
        }

        .form-top-nav {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            width: 100%;
            max-width: 440px;
            margin: 0 auto 40px auto;
        }

        .back-to-home-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.84375rem;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            transition: var(--transition-smooth);
        }

        .back-to-home-link:hover {
            color: var(--brand-royal);
        }

        .form-container {
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .form-header {
            margin-bottom: 28px;
        }

        .form-title {
            font-family: var(--font-heading);
            font-size: 1.875rem;
            font-weight: 800;
            color: var(--text-heading);
            letter-spacing: -0.03em;
            margin-bottom: 8px;
        }

        .form-subtitle {
            font-size: 0.9375rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .validation-summary-box {
            background-color: var(--c-danger-bg);
            border: 1px solid var(--c-danger-border);
            color: var(--c-danger);
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 0.8125rem;
            margin-bottom: 22px;
        }

        .validation-summary-box ul {
            margin: 0;
            padding-left: 18px;
        }

        .success-summary-box {
            background-color: #ECFDF5;
            border: 1.5px solid #A7F3D0;
            color: #065F46;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 0.84375rem;
            font-weight: 500;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-label-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .form-label {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-heading);
        }

        .form-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 48px;
            padding: 10px 14px;
            font-family: var(--font-body);
            font-size: 0.90625rem;
            color: var(--text-heading);
            background-color: var(--bg-white);
            border: 1.5px solid var(--border-light);
            border-radius: var(--radius-md);
            outline: none;
            transition: var(--transition-smooth);
        }

        .form-input:hover {
            border-color: var(--border-hover);
        }

        .form-input:focus {
            border-color: var(--border-focus);
            background-color: #FFFFFF;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.14);
        }

        .form-input.input-validation-error {
            border-color: var(--c-danger);
            background-color: #FFFDFD;
        }

        .field-validation-error {
            font-size: 0.75rem;
            color: var(--c-danger);
            font-weight: 500;
        }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            transition: var(--transition-smooth);
            border-radius: 6px;
        }

        .toggle-password-btn:hover {
            color: var(--brand-royal);
            background-color: var(--bg-subtle);
        }

        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            user-select: none;
        }

        .checkbox-input {
            width: 17px;
            height: 17px;
            accent-color: var(--brand-royal);
            cursor: pointer;
        }

        .checkbox-label {
            font-size: 0.8125rem;
            color: var(--text-body);
            cursor: pointer;
        }

        .btn-submit-login {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand-blue) 50%, var(--brand-royal) 100%);
            color: #FFFFFF;
            border: none;
            border-radius: var(--radius-md);
            font-family: var(--font-body);
            font-size: 0.9375rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.28);
            transition: var(--transition-smooth);
        }

        .btn-submit-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(29, 78, 216, 0.38);
            background: linear-gradient(135deg, var(--brand-darkest) 0%, var(--brand-blue) 50%, #3B82F6 100%);
        }

        .btn-submit-login:active {
            transform: translateY(0);
        }

        /* "Don't have an account" switch placed at the bottom */
        .auth-switch-bottom {
            margin-top: 22px;
            text-align: center;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .auth-switch-bottom a {
            color: var(--brand-royal);
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
            transition: var(--transition-smooth);
        }

        .auth-switch-bottom a:hover {
            color: var(--brand-dark);
            text-decoration: underline;
        }

        .form-bottom-footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid var(--border-light);
            text-align: center;
            font-size: 0.8125rem;
            color: var(--text-muted);
            max-width: 440px;
            margin-left: auto;
            margin-right: auto;
            width: 100%;
        }

        @@media (max-width: 1024px) {
            .brand-panel { padding: 36px 32px; }
            .brand-headline { font-size: 1.95rem; }
            .form-panel { padding: 36px 32px; }
        }

        @@media (max-width: 860px) {
            .auth-split-wrapper { flex-direction: column; }
            .brand-panel { max-width: 100%; flex: none; padding: 36px 24px; }
            .brand-content { margin: 28px 0 20px 0; }
            .brand-headline { font-size: 1.75rem; }
            .value-props-list { display: none; }
            .form-panel { padding: 32px 20px; }
        }
    </style>
</head>
<body>

    <div class="auth-split-wrapper">
        <!-- LEFT BRAND PANEL -->
        <aside class="brand-panel">
            <div class="ambient-glow-1"></div>
            <div class="ambient-glow-2"></div>

            <div class="brand-header-top">
                <a href="/" class="brand-logo-link" aria-label="Laundry Hub Davao">
                    <div class="brand-logo-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2Z"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 6v2M12 16v2M6 12H4M20 12h-2"></path>
                        </svg>
                    </div>
                    <div class="brand-logo-text">
                        <span class="brand-name">Laundry Hub</span>
                        <span class="brand-city">Davao City</span>
                    </div>
                </a>
            </div>

            <div class="brand-content">
                <div class="brand-tagline-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>Smart Laundry Management Portal</span>
                </div>

                <h1 class="brand-headline">
                    Welcome back.<br />
                    <span class="accent-highlight">Your laundry orders and tracking in one place.</span>
                </h1>

                <p class="brand-subtext">
                    Sign in to book new pickups, view weight verification photos, track live wash stages, and manage cashless payments.
                </p>

                <div class="value-props-list">
                    <div class="value-prop-card">
                        <div class="value-prop-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div class="value-prop-text">
                            <h4>Real-Time Stage Timeline</h4>
                            <p>Watch your order progress from Pickup → Weighing → Washing → Ready for Delivery.</p>
                        </div>
                    </div>

                    <div class="value-prop-card">
                        <div class="value-prop-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                <line x1="2" y1="10" x2="22" y2="10"></line>
                            </svg>
                        </div>
                        <div class="value-prop-text">
                            <h4>Fast PayMongo Checkout</h4>
                            <p>Pay with GCash, Maya, or Debit/Credit card with instant confirmation.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="brand-footer">
                <div class="proof-badge">
                    <div class="stars-row">★★★★★</div>
                    <span>Davao's Trusted Service</span>
                </div>
                <span>© 2026 Laundry Hub</span>
            </div>
        </aside>

        <!-- RIGHT FORM PANEL -->
        <main class="form-panel">
            <!-- Top Navigation Link (Left only) -->
            <div class="form-top-nav">
                <a href="/" class="back-to-home-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    <span>Home</span>
                </a>
            </div>

            <div class="form-container">
                <div class="form-header">
                    <h2 class="form-title">Log in to Laundry Hub</h2>
                    <p class="form-subtitle">Enter your email and password to access your account dashboard.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-summary-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="validation-summary-box">
                        @Html.ValidationSummary(true)
                    </div>
                }

                <form asp-action="Login" method="post" novalidate id="loginPageForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Email Input -->
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="form-input-wrap">
                            <input asp-for="Email" class="form-input" placeholder="e.g. maria@gmail.com" autocomplete="email" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group">
                        <div class="form-label-row">
                            <label asp-for="Password" class="form-label">Password</label>
                            <a href="javascript:alert('Password reset instructions have been dispatched to your email.');" style="font-size: 0.75rem; color: var(--brand-royal); text-decoration: none; font-weight: 600;">Forgot password?</a>
                        </div>
                        <div class="form-input-wrap">
                            <input asp-for="Password" type="password" class="form-input" id="loginPagePassword" placeholder="Enter your password" autocomplete="current-password" required />
                            <button type="button" class="toggle-password-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">
                                <svg id="eyeShow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg id="eyeHide" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="checkbox-row">
                        <input asp-for="RememberMe" class="checkbox-input" id="rememberMeCheck" />
                        <label for="rememberMeCheck" class="checkbox-label">Keep me signed in</label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-submit-login">
                        <span>Log in</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                    <!-- Don't have an account link at the BOTTOM -->
                    <div class="auth-switch-bottom">
                        Don't have an account? <a href="/Account/Register">Sign up</a>
                    </div>
                </form>
            </div>

            <div class="form-bottom-footer">
                Need help? <a href="mailto:support@laundryhub.ph" style="color: var(--brand-royal); text-decoration: none; font-weight: 600;">Contact Support</a> • <a href="/Terms" target="_blank" style="color: var(--text-muted); text-decoration: none;">Terms & Conditions</a>
            </div>
        </main>
    </div>

    <script>
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passInput = document.getElementById('loginPagePassword');
        const eyeShow = document.getElementById('eyeShow');
        const eyeHide = document.getElementById('eyeHide');

        if (toggleBtn && passInput) {
            toggleBtn.addEventListener('click', () => {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    eyeShow.style.display = 'none';
                    eyeHide.style.display = 'block';
                } else {
                    passInput.type = 'password';
                    eyeShow.style.display = 'block';
                    eyeHide.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
