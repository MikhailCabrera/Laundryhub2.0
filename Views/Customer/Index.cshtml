@model LaundryHub2._0.Models.CustomerDashboardViewModel
@using Microsoft.Extensions.Options
@inject IOptions<LaundryHub2._0.Models.MapSettings> MapSettingsOptions
@{
    Layout = null;
    ViewData["Title"] = "Customer Portal | Laundry Hub Davao City";
    var activeTab = ViewData["ActiveTab"] as string ?? "dashboard";
    var mapSettings = MapSettingsOptions.Value;
}
@functions {
    private static readonly TimeZoneInfo ManilaTz = ResolveManilaTz();

    private static TimeZoneInfo ResolveManilaTz()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
        catch { try { return TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); } catch { return TimeZoneInfo.Utc; } }
    }

    /// <summary>All customer-facing times render in Asia/Manila regardless of server TZ.</summary>
    private static DateTime ManilaTime(DateTime value)
    {
        var utc = value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);
        return TimeZoneInfo.ConvertTimeFromUtc(utc, ManilaTz);
    }

    /// <summary>UTC round-trip stamp for the shared timeline payload.</summary>
    private static string? JsonUtc(DateTime? value) => value == null ? null : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToString("o");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Laundry Hub Customer Portal — Book pickups, track orders, view verified weights, and manage payments." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/maplibre-gl/maplibre-gl.css" asp-append-version="true" />

    <style>
        /* ── Customer Map Picker (Phase 2D) ── */
        .pickup-map-container {
            margin-bottom: 20px;
            border-radius: var(--lh-radius-md);
            overflow: hidden;
            border: 1.5px solid var(--lh-border-light);
            background: var(--lh-white);
        }
        .pickup-map-header {
            padding: 12px 16px;
            background: var(--lh-blue-25);
            border-bottom: 1px solid var(--lh-border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }
        .pickup-map-title-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pickup-map-title {
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--lh-text-headings);
            margin: 0;
        }
        .pickup-map-sub {
            font-size: 0.75rem;
            color: var(--lh-text-muted);
        }
        .btn-use-location {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--lh-white);
            border: 1px solid var(--lh-border-light);
            border-radius: var(--lh-radius-sm);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--lh-blue-600);
            cursor: pointer;
            transition: var(--lh-transition);
        }
        .btn-use-location:hover {
            background: var(--lh-blue-50);
            border-color: var(--lh-blue-300);
        }
        #pickupMap {
            width: 100%;
            height: 300px;
            min-height: 260px;
        }
        .pickup-map-footer {
            padding: 10px 16px;
            background: var(--lh-white);
            border-top: 1px solid var(--lh-border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            font-size: 0.75rem;
        }
        .map-coords-badge {
            color: #059669;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ── Customer Live Rider Tracking (Phase 2E) ── */
        .live-tracking-card {
            margin-bottom: 24px;
            border-radius: var(--lh-radius-lg, 16px);
            border: 1.5px solid var(--lh-border-light, #E2E8F0);
            background: var(--lh-white, #FFFFFF);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }
        .live-tracking-header {
            padding: 14px 20px;
            background: #F8FAFC;
            border-bottom: 1px solid var(--lh-border-subtle, #E2E8F0);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .live-tracking-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9375rem;
            font-weight: 700;
            color: var(--lh-text-headings, #0F172A);
        }
        .live-indicator-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #F1F5F9;
            color: #64748B;
            border: 1px solid #E2E8F0;
        }
        .live-indicator-pill.is-live {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }
        .live-indicator-pill.is-stale {
            background: #FFFBEB;
            color: #92400E;
            border-color: #FDE68A;
        }
        .live-indicator-pill.is-waiting {
            background: #EFF6FF;
            color: #1E40AF;
            border-color: #BFDBFE;
        }
        .live-indicator-pill.is-reconnecting {
            background: #FEF2F2;
            color: #991B1B;
            border-color: #FECACA;
        }
        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
            display: inline-block;
        }
        .live-indicator-pill.is-live .live-dot {
            animation: pulse-live 1.6s infinite cubic-bezier(0.4, 0, 0.6, 1);
        }
        @@keyframes pulse-live {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.25); }
        }
        #customerTrackingMap {
            width: 100%;
            height: 380px;
            min-height: 300px;
            background: #F1F5F9;
        }
        .live-tracking-footer {
            padding: 12px 20px;
            background: #FFFFFF;
            border-top: 1px solid var(--lh-border-subtle, #E2E8F0);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            font-size: 0.8125rem;
        }
        .tracking-status-text {
            color: var(--lh-text-body, #334155);
            font-weight: 500;
        }
        .tracking-legend {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .tracking-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: var(--lh-text-muted, #64748B);
            font-weight: 500;
        }
        .tracking-legend-pin {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }
        .tracking-legend-pin.customer-pin {
            background: #2563EB;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }
        .tracking-legend-pin.rider-pin {
            background: #10B981;
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
        }

        /* Custom MapLibre Marker for Rider */
        .rider-map-marker {
            width: 36px;
            height: 36px;
            background: #10B981;
            border: 2.5px solid #FFFFFF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        .rider-map-marker:hover {
            transform: scale(1.1);
        }
        .rider-map-marker svg {
            width: 20px;
            height: 20px;
            color: #FFFFFF;
        }
        .customer-map-marker {
            width: 32px;
            height: 32px;
            background: #2563EB;
            border: 2.5px solid #FFFFFF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }
        .customer-map-marker svg {
            width: 18px;
            height: 18px;
            color: #FFFFFF;
        }

        :root {
            /* --lh-* design tokens load from the canonical wwwroot/css/site.css (linked above); page-scoped vars stay here. */
            --c-active: #10B981;
            --c-active-bg: #ECFDF5;
            --c-active-border: #A7F3D0;
            --c-warning: #F59E0B;

            --c-warning-bg: #FFFBEB;
            --c-warning-border: #FDE68A;
            --c-danger: #EF4444;
            --c-danger-bg: #FEF2F2;
            --c-danger-border: #FECACA;

            --sidebar-width: 290px;

            /* Shared responsive contract: card radius (20-24px) + touch minimum token. */
            --lh-card-radius: 20px;
            --lh-touch-min: 0px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            font-size: 16px;
            scroll-behavior: smooth;
            background-color: var(--lh-blue-10);
        }

        body {
            font-family: var(--lh-font-body);
            color: var(--lh-text-body);
            background-color: var(--lh-blue-10);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .customer-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ==========================================================================
           SIDEBAR
           ========================================================================== */
        .customer-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--lh-navy-900);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 100;
            box-shadow: 4px 0 24px rgba(7, 19, 36, 0.18);
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 28px 22px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
        }

        .sidebar-logo-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--lh-blue-500) 0%, var(--lh-blue-400) 100%);
            border-radius: var(--lh-radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--lh-white);
            box-shadow: 0 4px 12px rgba(30, 96, 213, 0.35);
        }

        .sidebar-brand-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .sidebar-wordmark {
            font-family: var(--lh-font-heading);
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--lh-white);
            line-height: 1.2;
            letter-spacing: -0.02em;
        }

        .sidebar-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            background-color: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(96, 165, 250, 0.3);
            border-radius: 20px;
            font-size: 0.6875rem;
            font-weight: 700;
            color: var(--lh-blue-300);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            width: fit-content;
        }

        .sidebar-nav {
            flex: 1;
            padding: 20px 14px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-section-title {
            font-size: 0.6875rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.35);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 10px 14px 6px;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: var(--lh-radius-md);
            color: rgba(255, 255, 255, 0.68);
            font-size: 0.9375rem;
            font-weight: 600;
            transition: var(--lh-transition);
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            text-decoration: none;
        }

        .sidebar-nav-item svg {
            width: 20px;
            height: 20px;
            color: rgba(255, 255, 255, 0.45);
            transition: var(--lh-transition);
        }

        .sidebar-nav-item:hover {
            background-color: rgba(59, 130, 246, 0.12);
            color: var(--lh-white);
        }

        .sidebar-nav-item:hover svg {
            color: var(--lh-blue-300);
        }

        .sidebar-nav-item.active {
            background: linear-gradient(90deg, rgba(30, 96, 213, 0.28) 0%, rgba(59, 130, 246, 0.12) 100%);
            color: var(--lh-white);
            border-left: 3px solid var(--lh-blue-400);
        }

        .sidebar-nav-item.active svg {
            color: var(--lh-blue-300);
        }

        /* Sidebar Footer (Customer Info & Logout) */
        .sidebar-footer {
            padding: 18px 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            background-color: rgba(7, 19, 36, 0.4);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .user-profile-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            overflow: hidden;
        }

        .user-avatar-badge {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--lh-blue-600) 0%, var(--lh-blue-400) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--lh-white);
            font-weight: 700;
            font-size: 0.875rem;
            flex-shrink: 0;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .user-text-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .user-display-name {
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--lh-white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-email-text {
            font-size: 0.6875rem;
            color: rgba(255, 255, 255, 0.45);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .logout-form button {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.45);
            cursor: pointer;
            padding: 8px;
            border-radius: var(--lh-radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--lh-transition);
        }

        .logout-form button:hover {
            color: var(--c-danger);
            background-color: rgba(239, 68, 68, 0.15);
        }

        /* ==========================================================================
           MAIN CONTENT AREA
           ========================================================================== */
        .customer-main {
            margin-left: var(--sidebar-width);
            flex: 1;
            padding: 36px 44px;
            min-height: 100vh;
        }

        .content-panel {
            display: none;
            flex-direction: column;
            gap: 24px;
            animation: panelFade 0.22s ease;
        }

        .content-panel.active {
            display: flex;
        }

        @@keyframes panelFade {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Alerts */
        .alert-banner {
            padding: 14px 18px;
            border-radius: var(--lh-radius-md);
            font-size: 0.875rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--lh-shadow-sm);
        }

        .alert-success {
            background-color: var(--c-active-bg);
            border: 1px solid var(--c-active-border);
            color: #065F46;
        }

        .alert-danger {
            background-color: var(--c-danger-bg);
            border: 1px solid var(--c-danger-border);
            color: var(--c-danger);
        }

        /* Top Bar */
        .main-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .page-heading-group h1 {
            font-family: var(--lh-font-heading);
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--lh-text-headings);
            letter-spacing: -0.02em;
        }

        .page-heading-group p {
            font-size: 0.875rem;
            color: var(--lh-text-muted);
        }

        .quick-book-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            min-height: 44px;
            min-width: 44px;
            background: linear-gradient(135deg, var(--lh-blue-600) 0%, var(--lh-blue-400) 100%);
            color: var(--lh-white);
            border: none;
            border-radius: var(--lh-radius-md);
            font-size: 0.875rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(30, 96, 213, 0.28);
            transition: var(--lh-transition);
        }

        .quick-book-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(30, 96, 213, 0.38);
        }

        /* Stat Cards Grid */
        .stat-cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .stat-card {
            background: var(--lh-white);
            border: 1px solid var(--lh-border-subtle);
            border-radius: var(--lh-card-radius);
            padding: 22px 20px;
            box-shadow: var(--lh-shadow-sm);
            display: flex;
            align-items: center;
            gap: 16px;
            transition: var(--lh-transition);
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--lh-shadow-md);
            border-color: var(--lh-blue-100);
        }

        .stat-card-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--lh-radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .stat-card-icon.blue {
            background-color: var(--lh-blue-50);
            color: var(--lh-blue-600);
        }

        .stat-card-icon.yellow {
            background-color: var(--c-warning-bg);
            color: var(--c-warning);
        }

        .stat-card-icon.green {
            background-color: var(--c-active-bg);
            color: var(--c-active);
        }

        .stat-card-icon.purple {
            background-color: #F5F3FF;
            color: #7C3AED;
        }

        .stat-card-data {
            display: flex;
            flex-direction: column;
        }

        .stat-card-value {
            font-family: var(--lh-font-heading);
            font-size: 1.625rem;
            font-weight: 800;
            color: var(--lh-text-headings);
            line-height: 1.2;
        }

        .stat-card-label {
            font-size: 0.8125rem;
            color: var(--lh-text-muted);
            font-weight: 600;
        }

        /* Content Cards & Sections */
        .content-card {
            background: var(--lh-white);
            border: 1px solid var(--lh-border-subtle);
            border-radius: var(--lh-card-radius);
            box-shadow: var(--lh-shadow-sm);
            overflow: hidden;
        }

        .content-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--lh-border-subtle);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .content-card-title {
            font-family: var(--lh-font-heading);
            font-size: 1.125rem;
            font-weight: 800;
            color: var(--lh-text-headings);
        }

        .content-card-body {
            padding: 24px;
        }

        /* ==========================================================================
           BOOKING FORM & SERVICES CHECKBOXES
           ========================================================================== */
        .services-selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .service-select-label {
            position: relative;
            cursor: pointer;
            display: block;
        }

        .service-select-label input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

        .service-card {
            border: 2px solid var(--lh-border-light);
            border-radius: var(--lh-card-radius);
            padding: 18px;
            background-color: var(--lh-white);
            transition: var(--lh-transition);
            display: flex;
            flex-direction: column;
            gap: 8px;
            height: 100%;
        }

        .service-select-label input[type="checkbox"]:checked + .service-card {
            border-color: var(--lh-blue-500);
            background-color: var(--lh-blue-25);
            box-shadow: 0 0 0 3px rgba(30, 96, 213, 0.15);
        }

        .service-select-label:focus-within .service-card {
            border-color: var(--lh-blue-500);
            box-shadow: 0 0 0 3px rgba(30, 96, 213, 0.35);
            outline: none;
        }

        .service-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .service-card-name {
            font-family: var(--lh-font-heading);
            font-size: 1rem;
            font-weight: 800;
            color: var(--lh-text-headings);
        }

        .service-price-pill {
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--lh-blue-600);
            background-color: var(--lh-blue-50);
            padding: 3px 10px;
            border-radius: 20px;
        }

        .service-card-desc {
            font-size: 0.8125rem;
            color: var(--lh-text-muted);
            line-height: 1.4;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 18px;
        }

        .form-label {
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--lh-text-headings);
        }

        .form-error {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--c-danger);
        }

        .form-control {
            width: 100%;
            height: 46px;
            padding: 10px 14px;
            border: 1.5px solid var(--lh-border-light);
            border-radius: var(--lh-radius-md);
            font-family: var(--lh-font-body);
            font-size: 0.875rem;
            color: var(--lh-text-headings);
            outline: none;
            transition: var(--lh-transition);
            background-color: var(--lh-white);
        }

        .form-control:focus {
            border-color: var(--lh-blue-500);
            box-shadow: 0 0 0 3px rgba(30, 96, 213, 0.14);
        }

        textarea.form-control {
            height: auto;
            min-height: 80px;
            resize: vertical;
        }

        .terms-checkbox-wrap {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 20px 0 24px 0;
            user-select: none;
        }

        .terms-checkbox-wrap input[type="checkbox"] {
            margin-top: 3px;
            width: 22px;
            height: 22px;
            min-width: 22px;
            accent-color: var(--lh-blue-600);
            cursor: pointer;
        }

        .terms-text {
            font-size: 0.8125rem;
            color: var(--lh-text-muted);
            line-height: 1.4;
        }

        .terms-text a {
            color: var(--lh-blue-600);
            font-weight: 600;
            text-decoration: none;
        }

        .terms-text a:hover {
            text-decoration: underline;
        }

        .btn-submit-booking {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, var(--lh-blue-600) 0%, var(--lh-blue-500) 100%);
            color: var(--lh-white);
            border: none;
            border-radius: var(--lh-radius-md);
            font-family: var(--lh-font-body);
            font-size: 0.9375rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(30, 96, 213, 0.28);
            transition: var(--lh-transition);
        }

        .btn-submit-booking:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(30, 96, 213, 0.4);
        }

        /* ==========================================================================
           BOOKING HISTORY TABS & TABLES
           ========================================================================== */
        .history-tabs-nav {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid var(--lh-border-subtle);
            padding: 0 24px;
            background-color: var(--lh-white);
        }

        .history-tab-btn {
            padding: 14px 20px;
            border: none;
            background: none;
            font-family: var(--lh-font-heading);
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--lh-text-muted);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: var(--lh-transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .history-tab-btn.active {
            color: var(--lh-blue-600);
            border-bottom-color: var(--lh-blue-600);
        }

        .tab-badge {
            background-color: var(--lh-blue-50);
            color: var(--lh-blue-600);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 12px;
        }

        .tab-content-section {
            display: none;
            padding: 20px 24px;
        }

        .tab-content-section.active {
            display: block;
        }

        .order-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.875rem;
        }

        .order-table th {
            text-align: left;
            padding: 12px 16px;
            background-color: var(--lh-blue-25);
            color: var(--lh-text-headings);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1.5px solid var(--lh-border-light);
        }

        .order-table td {
            padding: 16px;
            border-bottom: 1px solid var(--lh-border-subtle);
            vertical-align: middle;
        }

        .order-table tr:hover td {
            background-color: var(--lh-blue-10);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .status-pending { background-color: var(--c-warning-bg); color: #B45309; border: 1px solid var(--c-warning-border); }
        .status-assigned { background-color: var(--lh-blue-50); color: var(--lh-blue-600); border: 1px solid var(--lh-blue-100); }
        .status-processing { background-color: #F5F3FF; color: #7C3AED; border: 1px solid #DDD6FE; }
        .status-payment { background-color: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
        .status-delivered { background-color: var(--c-active-bg); color: #065F46; border: 1px solid var(--c-active-border); }
        .status-riderassigned,
        .status-pickedup,
        .status-intransittoshop { background-color: var(--lh-blue-50); color: var(--lh-blue-600); border: 1px solid var(--lh-blue-100); }
        .status-weighing,
        .status-weightconfirmed,
        .status-washing,
        .status-drying { background-color: #F5F3FF; color: #7C3AED; border: 1px solid #DDD6FE; }
        .status-awaitingpayment,
        .status-paymentconfirmed { background-color: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
        .status-readyfordelivery { background-color: #DBEAFE; color: #1D4ED8; border: 1px solid #93C5FD; }
        .status-outfordelivery { background-color: #FFEDD5; color: #C2410C; border: 1px solid #FDBA74; }
        .status-cancelled { background-color: var(--c-danger-bg); color: var(--c-danger); border: 1px solid var(--c-danger-border); }

        .btn-cancel-order {
            padding: 6px 12px;
            min-height: 44px;
            min-width: 44px;
            background-color: var(--c-danger-bg);
            border: 1px solid var(--c-danger-border);
            color: var(--c-danger);
            border-radius: var(--lh-radius-sm);
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--lh-transition);
        }

        .btn-cancel-order:hover {
            background-color: var(--c-danger);
            color: var(--lh-white);
        }

        /* ==========================================================================
           SERVICE TRACKING TIMELINE
           Moved to the shared `.lh-timeline*` family in ~/css/site.css; the
           stage derivation and renderer now live in ~/js/order-timeline.js.
           ========================================================================== */

        /* ============ Shared responsive contract (breakpoints 1024px / 640px) ============ */

        /* Horizontal scroll lives on the table wrapper only — never on the page. */
        .table-scroll {
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table-scroll th:first-child,
        .table-scroll td:first-child {
            position: sticky;
            left: 0;
            z-index: 2;
            background: var(--lh-white);
        }

        .table-scroll thead th:first-child {
            background: var(--lh-blue-25);
            z-index: 3;
        }

        .table-scroll tbody tr:hover td:first-child {
            background: var(--lh-blue-25);
        }

        .table-scroll th:first-child::after,
        .table-scroll td:first-child::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 1px;
            background: var(--lh-border-subtle);
        }

        /* Condensed essential-column disclosure control (injected by the row-toggle script). */
        .row-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            min-width: var(--lh-touch-min);
            min-height: var(--lh-touch-min);
            margin-right: 8px;
            border: 1px solid var(--lh-border-light);
            border-radius: var(--lh-radius-sm);
            background: var(--lh-white);
            color: var(--lh-text-muted);
            cursor: pointer;
            vertical-align: middle;
        }

        .row-toggle[aria-expanded="true"] svg {
            transform: rotate(180deg);
        }

        /* 1024px and below: essential columns only; the rest return when a row is expanded. */
        @@media (max-width: 1024px) {
            .stat-cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .form-row {
                grid-template-columns: 1fr;
            }
            .customer-main {
                min-width: 0;
                padding: 28px 20px;
            }
            .table-scroll th:nth-child(n+4):not(:last-child),
            .table-scroll td:nth-child(n+4):not(:last-child) {
                display: none;
            }
            .table-scroll tr.row-expanded th:nth-child(n+4):not(:last-child),
            .table-scroll tr.row-expanded td:nth-child(n+4):not(:last-child) {
                display: table-cell;
            }
            .row-toggle {
                display: inline-flex;
            }
            .table-scroll .order-table th,
            .table-scroll .order-table td {
                padding: 12px;
            }
        }

        /* 640px and below: two essential columns plus the trailing action column. */
        @@media (max-width: 640px) {
            .customer-sidebar {
                position: static;
                width: 100%;
                height: auto;
            }
            .customer-shell {
                flex-direction: column;
            }
            .customer-main {
                margin-left: 0;
                padding: 20px 14px;
            }
            .stat-cards-grid {
                grid-template-columns: 1fr;
            }
            .form-row {
                grid-template-columns: 1fr;
            }
            .table-scroll th:nth-child(n+3):not(:last-child),
            .table-scroll td:nth-child(n+3):not(:last-child) {
                display: none;
            }
            .table-scroll tr.row-expanded th:nth-child(n+3):not(:last-child),
            .table-scroll tr.row-expanded td:nth-child(n+3):not(:last-child) {
                display: table-cell;
            }
        }

        /* Touch sizing: 44px minimums come from the token, never per-button overrides. */
        @@media (pointer: coarse) {
            :root {
                --lh-touch-min: 44px;
            }
            .btn,
            .btn-sm,
            .chip,
            .quick-book-btn,
            .page-btn,
            .modal-close,
            .tab-btn,
            .sidebar-nav-item {
                min-height: var(--lh-touch-min);
            }
            .btn,
            .btn-sm,
            .chip,
            .page-btn,
            .modal-close,
            .tab-btn {
                min-width: var(--lh-touch-min);
            }
            .row-toggle {
                min-width: var(--lh-touch-min);
                min-height: var(--lh-touch-min);
            }
        }
    </style>
</head>
<body>

    <div class="customer-shell">
        <!-- SIDEBAR -->
        <aside class="customer-sidebar">
            <div>
                <!-- Brand Header -->
                <a href="/Customer" class="sidebar-brand">
                    <div class="sidebar-logo-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2Z"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 6v2M12 16v2M6 12H4M20 12h-2"></path>
                        </svg>
                    </div>
                    <div class="sidebar-brand-text">
                        <span class="sidebar-wordmark">Laundry Hub</span>
                        <span class="sidebar-badge">Customer Portal</span>
                    </div>
                </a>

                <!-- Navigation List -->
                <nav class="sidebar-nav">
                    <span class="sidebar-section-title">Menu</span>

                    <button type="button" class="sidebar-nav-item @(activeTab == "dashboard" ? "active" : "")" onclick="switchTab('dashboard')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" class="sidebar-nav-item @(activeTab == "book" ? "active" : "")" onclick="switchTab('book')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        <span>Book a Pickup</span>
                    </button>

                    <button type="button" class="sidebar-nav-item @(activeTab == "history" ? "active" : "")" onclick="switchTab('history')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <span>Booking History</span>
                    </button>

                    <button type="button" class="sidebar-nav-item @(activeTab == "tracking" ? "active" : "")" onclick="switchTab('tracking')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                        <span>Service Tracking</span>
                    </button>

                    <button type="button" class="sidebar-nav-item @(activeTab == "payment" ? "active" : "")" onclick="switchTab('payment')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        <span>Payment</span>
                    </button>
                </nav>
            </div>

            <!-- Sidebar Footer with Customer Info & Logout -->
            <div class="sidebar-footer">
                <div class="user-profile-meta">
                    <div class="user-avatar-badge">
                        @(string.IsNullOrWhiteSpace(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div class="user-text-info">
                        <span class="user-display-name">@Model.User.FullName</span>
                        <span class="user-email-text">@Model.User.Email</span>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Log Out">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="customer-main">
            <!-- Alert Messages -->
            @if (TempData["CustomerSuccess"] != null)
            {
                <div class="alert-banner alert-success" style="margin-bottom: 20px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>@TempData["CustomerSuccess"]</span>
                </div>
            }
            @if (TempData["CustomerError"] != null)
            {
                <div class="alert-banner alert-danger" style="margin-bottom: 20px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@TempData["CustomerError"]</span>
                </div>
            }

            <!-- ==========================================================================
                 PANEL 1: DASHBOARD
                 ========================================================================== -->
            <div id="panel-dashboard" class="content-panel @(activeTab == "dashboard" ? "active" : "")">
                <div class="main-topbar">
                    <div class="page-heading-group">
                        <h1>Hello, @Model.User.FullName! 👋</h1>
                        <p>Welcome to your personal laundry dashboard. Manage pickups and track your clothes in real-time.</p>
                    </div>

                    <button type="button" class="quick-book-btn" onclick="switchTab('book')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        <span>Book a Pickup</span>
                    </button>

                    <a href="#notifications-card" class="notification-bell" aria-label="Notifications" style="position: relative; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--lh-blue-50); color: var(--lh-blue-600); text-decoration: none; margin-left: 12px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        @if (Model.UnreadNotificationsCount > 0)
                        {
                            <span class="tab-badge" style="position: absolute; top: -4px; right: -4px;">@Model.UnreadNotificationsCount</span>
                        }
                    </a>
                </div>

                <!-- 4 Stat Cards -->
                <div class="stat-cards-grid">
                    <div class="stat-card">
                        <div class="stat-card-icon blue">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        </div>
                        <div class="stat-card-data">
                            <span class="stat-card-value">@Model.ActiveOrdersCount</span>
                            <span class="stat-card-label">Active Orders</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-card-icon yellow">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                        <div class="stat-card-data">
                            <span class="stat-card-value">@Model.PendingPickupsCount</span>
                            <span class="stat-card-label">Pending Pickups</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-card-icon green">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                        <div class="stat-card-data">
                            <span class="stat-card-value">@Model.CompletedOrdersCount</span>
                            <span class="stat-card-label">Completed</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-card-icon purple">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        </div>
                        <div class="stat-card-data">
                            <span class="stat-card-value">₱@Model.TotalSpent.ToString("N2")</span>
                            <span class="stat-card-label">Total Spent</span>
                        </div>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="content-card" id="notifications-card">
                    <div class="content-card-header">
                        <h3 class="content-card-title">
                            Notifications
                            @if (Model.UnreadNotificationsCount > 0)
                            {
                                <span class="tab-badge">@Model.UnreadNotificationsCount unread</span>
                            }
                        </h3>
                        @if (Model.UnreadNotificationsCount > 0)
                        {
                            <form method="post" asp-controller="Customer" asp-action="MarkNotificationsRead" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="history-tab-btn">Mark all read</button>
                            </form>
                        }
                    </div>
                    <div class="content-card-body">
                        @if (Model.Notifications.Count == 0)
                        {
                            <p style="padding: 20px; color: var(--lh-text-muted); text-align: center;">No notifications yet. Updates about your orders will appear here.</p>
                        }
                        else
                        {
                            @foreach (var note in Model.Notifications)
                            {
                                <div style="padding: 14px 20px; border-bottom: 1px solid var(--lh-border-subtle); @(note.IsRead ? "" : "background: var(--lh-blue-25);")">
                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                                        <strong style="font-size: 0.9rem;">@note.Title</strong>
                                        <span style="font-size: 0.75rem; color: var(--lh-text-muted); white-space: nowrap;">@ManilaTime(note.CreatedAt).ToString("MMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    <p style="font-size: 0.85rem; color: var(--lh-text-body); margin: 4px 0 0;">@note.Body</p>
                                    @if (!note.IsRead)
                                    {
                                        <form method="post" asp-controller="Customer" asp-action="MarkNotificationsRead" style="margin-top: 8px;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@note.Id" />
                                            <button type="submit" class="history-tab-btn">Mark read</button>
                                        </form>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Recent Bookings Table -->
                <div class="content-card">
                    <div class="content-card-header">
                        <h3 class="content-card-title">Recent Laundry Orders</h3>
                        <button type="button" class="history-tab-btn" onclick="switchTab('history')">View All Orders →</button>
                    </div>
                    <div class="content-card-body" style="padding: 0;">
                        @if (Model.Orders.Count == 0)
                        {
                            <div style="padding: 40px; text-align: center; color: var(--lh-text-muted);">
                                <p style="font-size: 1rem; font-weight: 600; margin-bottom: 8px;">No laundry orders yet!</p>
                                <p style="font-size: 0.875rem; margin-bottom: 20px;">Book your first doorstep pickup in Davao City today.</p>
                                <button type="button" class="quick-book-btn" onclick="switchTab('book')">Book a Pickup Now</button>
                            </div>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Services</th>
                                        <th>Pickup Schedule</th>
                                        <th>Status</th>
                                        <th>Total Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ord in Model.Orders.Take(5))
                                    {
                                        <tr>
                                            <td style="font-family: var(--lh-font-heading); font-weight: 700;">@ord.OrderNumber</td>
                                            <td>
                                                @string.Join(", ", ord.OrderServices.Select(s => s.Service.Name))
                                            </td>
                                            <td>@ord.PreferredPickupDate.ToString("MMM dd, yyyy") (@ord.PreferredPickupTime)</td>
                                            <td>
                                                <span class="status-pill status-@ord.Status.ToString().ToLower()">
                                                    @ord.Status.ToString()
                                                </span>
                                            </td>
                                            <td style="font-weight: 700;">
                                                @(ord.TotalAmount.HasValue ? $"₱{ord.TotalAmount.Value:N2}" : "Pending Weight")
                                            </td>
                                            <td>
                                                <button type="button" class="quick-book-btn" style="padding: 4px 10px; font-size: 0.75rem;" onclick="trackOrder(@ord.Id)">Track</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ==========================================================================
                 PANEL 2: BOOK A PICKUP
                 ========================================================================== -->
            <div id="panel-book" class="content-panel @(activeTab == "book" ? "active" : "")">
                <div class="page-heading-group">
                    <h1>Book a Doorstep Pickup</h1>
                    <p>Select your laundry services and schedule a convenient pickup time in Davao City.</p>
                </div>

                <div class="content-card">
                    <div class="content-card-body">
                        <form asp-controller="Customer" asp-action="BookPickup" method="post" id="bookPickupForm" onsubmit="return validatePickupForm()">
                            @Html.AntiForgeryToken()

                            <!-- Step 1: Select Services -->
                            <div style="margin-bottom: 24px;">
                                <label class="form-label" style="font-size: 1rem; margin-bottom: 12px; display: block;">1. Select Laundry Services (Choose 1 or more)</label>
                                <div class="services-selection-grid">
                                    @foreach (var svc in Model.AvailableServices)
                                    {
                                        <label class="service-select-label">
                                            <input type="checkbox" name="SelectedServiceIds" value="@svc.Id" data-rate="@svc.PricePerKg" data-name="@svc.Name" @(svc.Name.Contains("Wash & Dry") ? "checked" : null) />
                                            <div class="service-card">
                                                <div class="service-card-top">
                                                    <span class="service-card-name">@svc.Name</span>
                                                    <span class="service-price-pill">₱@svc.PricePerKg/kg</span>
                                                </div>
                                                <p class="service-card-desc">@svc.Description</p>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>

                            <!-- Booking estimate (advisory only — final bill follows in-shop scale weighing) -->
                            <div style="margin-bottom: 24px;">
                                <label class="form-label" style="font-size: 1rem; margin-bottom: 12px; display: block;">Estimate before you book</label>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="form-label" for="estimateWeightKg">Estimated weight (kg)</label>
                                        <input type="number" id="estimateWeightKg" class="form-control" min="0" step="0.5" value="5" inputmode="decimal" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Live estimate</label>
                                        <div id="bookingEstimate" style="font-size: 0.875rem; color: var(--lh-text-body); background: var(--lh-blue-25); border: 1.5px solid var(--lh-border-light); border-radius: var(--lh-radius-md); padding: 10px 14px; min-height: 46px;">Select services to see an estimate.</div>
                                    </div>
                                </div>
                                <p style="font-size: 0.75rem; color: var(--lh-text-muted); margin: 0;">3 kg minimum per pickup · ₱50 delivery fee under 5 kg, FREE at 5 kg+. Final amount is weighed in-shop.</p>
                            </div>

                            <!-- Step 2: Pickup Schedule & Contact Details -->
                            <label class="form-label" style="font-size: 1rem; margin-bottom: 12px; display: block;">2. Pickup Details & Schedule</label>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label" for="pickupDateInput">Preferred Pickup Date (Mon–Sat, closed Sundays)</label>
                                    <input type="date" id="pickupDateInput" name="PreferredPickupDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                    <span class="form-error" id="err-pickup-date"></span>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Preferred Pickup Time Slot</label>
                                    <select name="PreferredPickupTime" class="form-control" required>
                                        <option value="8:00 AM - 10:00 AM">8:00 AM - 10:00 AM (Morning)</option>
                                        <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM (Midday)</option>
                                        <option value="1:00 PM - 3:00 PM">1:00 PM - 3:00 PM (Early Afternoon)</option>
                                        <option value="3:00 PM - 5:00 PM">3:00 PM - 5:00 PM (Late Afternoon)</option>
                                        <option value="5:00 PM - 7:00 PM">5:00 PM - 7:00 PM (Evening)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Pickup Location / Complete Address</label>
                                    <input type="text" name="PickupLocation" class="form-control" placeholder="House #, Street, Barangay, District, Davao City" required />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Contact Mobile Number</label>
                                    <input type="tel" name="ContactNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="e.g. 09171234567" required />
                                </div>
                            </div>

                            <!-- Map Picker for Exact Pickup Coordinates (Phase 2D) -->
                            <div class="pickup-map-container">
                                <div class="pickup-map-header">
                                    <div class="pickup-map-title-wrap">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--lh-blue-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        <div>
                                            <p class="pickup-map-title">Pin Exact Pickup Location</p>
                                            <span class="pickup-map-sub">Click map or drag the pin to your exact building / entrance</span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-use-location" id="btnUseCurrentLocation" onclick="useCurrentCustomerLocation()">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                                        </svg>
                                        Use My Current Location
                                    </button>
                                </div>
                                <div id="pickupMap" aria-label="Interactive map for selecting pickup pin"></div>
                                <div class="pickup-map-footer">
                                    <div class="map-coords-badge" id="mapCoordsDisplay">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        <span>Pin set: <span id="coordsDisplayValues">@(mapSettings.InitialLatitude.ToString("F5")), @(mapSettings.InitialLongitude.ToString("F5"))</span></span>
                                    </div>
                                    <div id="mapLocationMsg" style="color:var(--lh-text-muted);font-size:0.75rem;"></div>
                                </div>
                            </div>

                            <!-- Hidden inputs for exact pickup coordinates -->
                            <input type="hidden" id="pickupLatitude" name="PickupLatitude" value="@mapSettings.InitialLatitude" />
                            <input type="hidden" id="pickupLongitude" name="PickupLongitude" value="@mapSettings.InitialLongitude" />

                            <div class="form-group">
                                <label class="form-label">Special Instructions or Fabric Notes (Optional)</label>
                                <textarea name="SpecialInstructions" class="form-control" placeholder="e.g. Delicates in separate bag, handle white collared shirts carefully..."></textarea>
                            </div>

                            <!-- Terms & Conditions Acceptance -->
                            <div class="terms-checkbox-wrap">
                                <input type="checkbox" id="acceptTermsCheck" name="AcceptTerms" value="true" required />
                                <label for="acceptTermsCheck" class="terms-text">
                                    I agree to Laundry Hub's <a href="/Terms" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions (v@(LaundryHub2._0.Models.LaundryOrder.CurrentTermsVersion))</a> and understand that actual cost will be calculated after in-shop scale weighing. Orders not claimed or paid within 24 hours of completion notice are subject to a 3%/day late fee capped at 30%; orders may be marked abandoned after 15 days overdue.
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-submit-booking">
                                <span>Confirm & Book Pickup</span>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ==========================================================================
                 PANEL 3: BOOKING HISTORY
                 ========================================================================== -->
            <div id="panel-history" class="content-panel @(activeTab == "history" ? "active" : "")">
                <div class="page-heading-group">
                    <h1>Booking History</h1>
                    <p>View all your past and active orders, check rider assignments, and manage cancellations.</p>
                </div>

                <div class="content-card">
                    <!-- History Nav Tabs -->
                    <div class="history-tabs-nav">
                        <button type="button" class="history-tab-btn active" onclick="filterHistoryTab('pending', this)">
                            Pending Pickups <span class="tab-badge">@Model.Orders.Count(o => o.Status == LaundryHub2._0.Models.OrderStatus.Pending)</span>
                        </button>
                        <button type="button" class="history-tab-btn" onclick="filterHistoryTab('ongoing', this)">
                            Ongoing Orders <span class="tab-badge">@Model.Orders.Count(o => o.Status != LaundryHub2._0.Models.OrderStatus.Pending && o.Status != LaundryHub2._0.Models.OrderStatus.Delivered && o.Status != LaundryHub2._0.Models.OrderStatus.Cancelled && o.Status != LaundryHub2._0.Models.OrderStatus.Abandoned)</span>
                        </button>
                        <button type="button" class="history-tab-btn" onclick="filterHistoryTab('completed', this)">
                            Completed / Past <span class="tab-badge">@Model.Orders.Count(o => o.Status == LaundryHub2._0.Models.OrderStatus.Delivered || o.Status == LaundryHub2._0.Models.OrderStatus.Cancelled || o.Status == LaundryHub2._0.Models.OrderStatus.Abandoned)</span>
                        </button>
                    </div>

                    <!-- TAB 1: PENDING -->
                    <div id="history-tab-pending" class="tab-content-section active">
                        @{
                            var pendingOrders = Model.Orders.Where(o => o.Status == LaundryHub2._0.Models.OrderStatus.Pending).ToList();
                        }
                        @if (pendingOrders.Count == 0)
                        {
                            <p style="padding: 20px; color: var(--lh-text-muted); text-align: center;">No pending pickup requests at this time.</p>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="history-pending-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Selected Services</th>
                                        <th>Pickup Scheduled</th>
                                        <th>Pickup Address</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="history-pending-body">
                                    @foreach (var ord in pendingOrders)
                                    {
                                        <tr>
                                            <td style="font-weight: 700;">@ord.OrderNumber</td>
                                            <td>@string.Join(", ", ord.OrderServices.Select(s => s.Service.Name))</td>
                                            <td>@ord.PreferredPickupDate.ToString("MMM dd, yyyy") (@ord.PreferredPickupTime)</td>
                                            <td>@ord.PickupLocation</td>
                                            <td><span class="status-pill status-pending">Pending Rider</span></td>
                                            <td>
                                                <form asp-controller="Customer" asp-action="CancelOrder" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@ord.Id" />
                                                    <button type="submit" class="btn-cancel-order">Cancel</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="history-pending-pagination" aria-label="Pending orders pagination"></div>
                        }
                    </div>

                    <!-- TAB 2: ONGOING -->
                    <div id="history-tab-ongoing" class="tab-content-section">
                        @{
                            var ongoingOrders = Model.Orders.Where(o => 
                                o.Status != LaundryHub2._0.Models.OrderStatus.Pending && 
                                o.Status != LaundryHub2._0.Models.OrderStatus.Delivered && 
                                o.Status != LaundryHub2._0.Models.OrderStatus.Cancelled && 
                                o.Status != LaundryHub2._0.Models.OrderStatus.Abandoned).ToList();
                        }
                        @if (ongoingOrders.Count == 0)
                        {
                            <p style="padding: 20px; color: var(--lh-text-muted); text-align: center;">No ongoing laundry processing currently in progress.</p>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="history-ongoing-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Assigned Rider</th>
                                        <th>Current Stage</th>
                                        <th>Weight</th>
                                        <th>Total Cost</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="history-ongoing-body">
                                    @foreach (var ord in ongoingOrders)
                                    {
                                        <tr>
                                            <td style="font-weight: 700;">@ord.OrderNumber</td>
                                            <td>
                                                @if (ord.Status == LaundryHub2._0.Models.OrderStatus.OutForDelivery && ord.DeliveryRider != null)
                                                {
                                                    <div>Delivery: @ord.DeliveryRider.FullName</div>
                                                    <div style="font-size:0.75rem;color:var(--lh-text-muted);">@(ord.DeliveryRider.PhoneNumber ?? "")</div>
                                                }
                                                else
                                                {
                                                    @(ord.PickupRider != null ? $"{ord.PickupRider.FullName} ({ord.PickupRider.PhoneNumber})" : "Awaiting Rider")
                                                }
                                            </td>
                                            <td><span class="status-pill status-processing">@ord.Status.ToString()</span></td>
                                            <td>@(ord.WeightKg.HasValue ? $"{ord.WeightKg.Value:N2} kg" : "In Transit / Weighing")</td>
                                            <td style="font-weight: 700;">@(ord.TotalAmount.HasValue ? $"₱{ord.TotalAmount.Value:N2}" : "Pending Weight")</td>
                                            <td>
                                                <button type="button" class="quick-book-btn" style="padding: 5px 12px; font-size: 0.75rem;" onclick="trackOrder(@ord.Id)">Track Live</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="history-ongoing-pagination" aria-label="Ongoing orders pagination"></div>
                        }
                    </div>

                    <!-- TAB 3: COMPLETED -->
                    <div id="history-tab-completed" class="tab-content-section">
                        @{
                            var completedOrders = Model.Orders.Where(o => 
                                o.Status == LaundryHub2._0.Models.OrderStatus.Delivered || 
                                o.Status == LaundryHub2._0.Models.OrderStatus.Cancelled || 
                                o.Status == LaundryHub2._0.Models.OrderStatus.Abandoned).ToList();
                        }
                        @if (completedOrders.Count == 0)
                        {
                            <p style="padding: 20px; color: var(--lh-text-muted); text-align: center;">No completed orders recorded yet.</p>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="history-completed-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Services</th>
                                        <th>Total Paid</th>
                                        <th>Delivery</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="history-completed-body">
                                    @foreach (var ord in completedOrders)
                                    {
                                        <tr data-pager-group="ord-@ord.Id">
                                            <td style="font-weight: 700;">@ord.OrderNumber</td>
                                            <td>@ord.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>@string.Join(", ", ord.OrderServices.Select(s => s.Service.Name))</td>
                                            <td style="font-weight: 700;">@(ord.TotalAmount.HasValue ? $"₱{ord.TotalAmount.Value:N2}" : "—")</td>
                                            <td>
                                                @if (ord.Status == LaundryHub2._0.Models.OrderStatus.Delivered)
                                                {
                                                    <div>@(ord.DeliveryRider?.FullName ?? "—")</div>
                                                    @if (ord.DeliveredAt.HasValue)
                                                    {
                                                        <div style="font-size:0.75rem;color:var(--lh-text-muted);">@ManilaTime(ord.DeliveredAt.Value).ToString("MMM d, h:mm tt")</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ord.DeliveryPhotoPath))
                                                    {
                                                        <a href="@ord.DeliveryPhotoPath" target="_blank" rel="noopener noreferrer" style="color:var(--lh-blue-600);font-size:0.75rem;font-weight:600;">View proof</a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span style="color:var(--lh-text-muted);">—</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="status-pill status-@ord.Status.ToString().ToLower()">@ord.Status.ToString()</span>
                                            </td>
                                        </tr>
                                        @if (ord.Status == LaundryHub2._0.Models.OrderStatus.Delivered)
                                        {
                                            <tr data-pager-group="ord-@ord.Id">
                                                <td colspan="6">
                                                    <div class="content-card" style="margin:12px 0;">
                                                        <div class="content-card-header">
                                                            <h3 class="content-card-title">Report Damage or Loss</h3>
                                                        </div>
                                                        <div class="content-card-body">
                                                            <p style="font-size:0.85rem;color:var(--lh-text-muted);margin:0 0 12px;">Something wrong with order @ord.OrderNumber? Describe it below and our team will review it.</p>
                                                            <div id="selfclaim-form-@ord.Id">
                                                                @Html.AntiForgeryToken()
                                                                <div class="form-group">
                                                                    <label class="form-label" for="selfclaim-type-@ord.Id">Issue type</label>
                                                                    <select id="selfclaim-type-@ord.Id" class="form-control" style="max-width:280px;">
                                                                        <option value="Damage">Damage</option>
                                                                        <option value="Loss">Loss</option>
                                                                        <option value="Other">Other</option>
                                                                    </select>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="form-label" for="selfclaim-desc-@ord.Id">What happened</label>
                                                                    <textarea id="selfclaim-desc-@ord.Id" class="form-control" maxlength="1000" rows="3" placeholder="e.g. Blue shirt has a stain that was not there before..."></textarea>
                                                                </div>
                                                                <span id="err-selfclaim-@ord.Id" style="font-size:0.75rem;color:#DC2626;font-weight:600;"></span>
                                                                <div id="ok-selfclaim-@ord.Id" style="font-size:0.85rem;color:#065F46;font-weight:600;margin-top:6px;"></div>
                                                                <div style="margin-top:10px;">
                                                                    <button type="button" class="quick-book-btn" style="padding:7px 16px;font-size:0.8125rem;" onclick="submitSelfClaim(@ord.Id)">File Claim</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="history-completed-pagination" aria-label="Completed orders pagination"></div>
                        }
                    </div>
                </div>
            </div>

            <!-- ==========================================================================
                 PANEL 4: SERVICE TRACKING
                 ========================================================================== -->
            <div id="panel-tracking" class="content-panel @(activeTab == "tracking" ? "active" : "")">
                <div class="page-heading-group">
                    <h1>Service Tracking</h1>
                    <p>Follow the exact lifecycle of your laundry from rider pickup to doorstep delivery.</p>
                </div>

                @{
                    // Deep link (?tab=tracking&order=id) selects exactly that order when it
                    // belongs to the caller (validated server-side); otherwise the default
                    // below applies. The timeline below always renders this same object,
                    // so Track can never show order A's timeline for order B.
                    var requestedTrackingId = ViewData["TrackingOrderId"] as int?;
                    var activeOrder = (requestedTrackingId.HasValue
                        ? Model.Orders.FirstOrDefault(o => o.Id == requestedTrackingId.Value)
                        : null)
                        ?? Model.Orders.FirstOrDefault(o =>
                        o.Status != LaundryHub2._0.Models.OrderStatus.Delivered &&
                        o.Status != LaundryHub2._0.Models.OrderStatus.Cancelled &&
                        o.Status != LaundryHub2._0.Models.OrderStatus.Abandoned) ?? Model.Orders.FirstOrDefault();
                }

                <div class="content-card" style="margin-bottom: 20px;">
                    <div class="content-card-body" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <label class="form-label" for="trackingOrderSelect" style="margin: 0;">Tracked order</label>
                        <select id="trackingOrderSelect" class="form-control" style="max-width: 320px;" onchange="if (this.value) trackOrder(this.value)">
                            @foreach (var o in Model.Orders)
                            {
                                if (activeOrder != null && o.Id == activeOrder.Id)
                                {
                                    <option value="@o.Id" selected>@o.OrderNumber (@o.Status.ToString())</option>
                                }
                                else
                                {
                                    <option value="@o.Id">@o.OrderNumber (@o.Status.ToString())</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                @if (activeOrder == null)
                {
                    <div class="content-card" style="padding: 40px; text-align: center;">
                        <p style="font-size: 1rem; font-weight: 600; color: var(--lh-text-headings); margin-bottom: 8px;">No active orders to track</p>
                        <p style="font-size: 0.875rem; color: var(--lh-text-muted); margin-bottom: 16px;">Schedule a pickup to watch your clothes move through every washing stage.</p>
                        <button type="button" class="quick-book-btn" onclick="switchTab('book')">Book a Pickup</button>
                    </div>
                }
                else
                {
                    <div class="content-card">
                        <div class="content-card-header">
                            <div>
                                <h3 class="content-card-title">Tracking Order: @activeOrder.OrderNumber</h3>
                                <p style="font-size: 0.8125rem; color: var(--lh-text-muted);">Booked on @ManilaTime(activeOrder.CreatedAt).ToString("MMMM dd, yyyy hh:mm tt") (Asia/Manila)</p>
                            </div>
                            <span class="status-pill status-@activeOrder.Status.ToString().ToLower()">@activeOrder.Status.ToString()</span>
                        </div>
                        <div class="content-card-body">
                            @if (activeOrder.Status == LaundryHub2._0.Models.OrderStatus.AwaitingPayment)
                            {
                                <div class="alert-banner alert-success" style="margin-bottom: 20px; background: #ECFDF5; border: 1.5px solid #10B981; color: #065F46; justify-content: space-between; flex-wrap: wrap;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        <div>
                                            <div style="font-weight: 700; font-size: 0.9375rem;">Your laundry is clean and ready! 🎉</div>
                                            <div style="font-size: 0.8125rem;">Complete payment to dispatch for delivery to your doorstep. Total due: <strong>₱@(activeOrder.TotalAmount?.ToString("N2"))</strong></div>
                                        </div>
                                    </div>
                                    <button type="button" class="quick-book-btn" style="padding: 7px 16px; font-size: 0.8125rem;" onclick="switchTab('payment')">Pay Now</button>
                                </div>
                            }
                            @if (activeOrder.Status == LaundryHub2._0.Models.OrderStatus.WeightConfirmed && !activeOrder.WeightConfirmedByCustomerAt.HasValue)
                            {
                                <div class="alert-banner alert-success" style="margin-bottom: 20px; background: #EFF6FF; border: 1.5px solid #1D4ED8; color: #1E40AF; justify-content: space-between; flex-wrap: wrap;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                        <div>
                                            <div style="font-weight: 700; font-size: 0.9375rem;">Please confirm the weighed amount</div>
                                            <div style="font-size: 0.8125rem;">Shop scale: <strong>@activeOrder.WeightKg kg</strong> — Total: <strong>₱@(activeOrder.TotalAmount?.ToString("N2"))</strong>. Washing starts after your confirmation.</div>
                                        </div>
                                    </div>
                                    <form asp-controller="Customer" asp-action="ConfirmWeight" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@activeOrder.Id" />
                                        <button type="submit" class="quick-book-btn" style="padding: 7px 16px; font-size: 0.8125rem;">Confirm Weight</button>
                                    </form>
                                </div>
                            }

                            <!-- Phase 2E: Customer Live Rider Tracking Map -->
                            @{
                                var isPickupTracking = activeOrder.Status == LaundryHub2._0.Models.OrderStatus.RiderAssigned ||
                                                       activeOrder.Status == LaundryHub2._0.Models.OrderStatus.PickedUp ||
                                                       activeOrder.Status == LaundryHub2._0.Models.OrderStatus.InTransitToShop;
                                var isDeliveryTracking = activeOrder.Status == LaundryHub2._0.Models.OrderStatus.ReadyForDelivery ||
                                                         activeOrder.Status == LaundryHub2._0.Models.OrderStatus.OutForDelivery ||
                                                         activeOrder.Status == LaundryHub2._0.Models.OrderStatus.DeliveryAttemptFailed;
                                var isTrackingEligible = isPickupTracking || isDeliveryTracking;
                            }

                            <div class="live-tracking-card" id="trackingMapContainer"
                                 data-order-id="@activeOrder.Id"
                                 data-order-number="@activeOrder.OrderNumber"
                                 data-order-status="@activeOrder.Status"
                                 data-is-eligible="@(isTrackingEligible ? "true" : "false")"
                                 data-tracking-type="@(isPickupTracking ? "pickup" : (isDeliveryTracking ? "delivery" : "none"))"
                                 data-customer-lat="@(activeOrder.PickupLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                 data-customer-lng="@(activeOrder.PickupLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                 data-pickup-loc="@activeOrder.PickupLocation">
                                <div class="live-tracking-header">
                                    <div class="live-tracking-title">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                                        </svg>
                                        <span>Live Rider Tracking</span>
                                        @if (isPickupTracking)
                                        {
                                            <span style="font-size:0.75rem; font-weight:600; color:#2563EB; background:#EFF6FF; padding:2px 8px; border-radius:6px; border:1px solid #BFDBFE;">Pickup Leg</span>
                                        }
                                        else if (isDeliveryTracking)
                                        {
                                            <span style="font-size:0.75rem; font-weight:600; color:#059669; background:#ECFDF5; padding:2px 8px; border-radius:6px; border:1px solid #A7F3D0;">Delivery Leg</span>
                                        }
                                    </div>
                                    <div id="liveTrackingPill" class="live-indicator-pill is-waiting">
                                        <span class="live-dot"></span>
                                        <span id="liveTrackingPillText">Connecting...</span>
                                    </div>
                                </div>
                                <div id="customerTrackingMap"></div>
                                <div class="live-tracking-footer">
                                    <div class="tracking-status-text" id="liveTrackingStatusMsg">
                                        Initializing live tracking for order @activeOrder.OrderNumber...
                                    </div>
                                    <div class="tracking-legend">
                                        <div class="tracking-legend-item">
                                            <span class="tracking-legend-pin customer-pin"></span>
                                            <span>Your Location</span>
                                        </div>
                                        <div class="tracking-legend-item">
                                            <span class="tracking-legend-pin rider-pin"></span>
                                            <span>Assigned Rider</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <script type="application/json" id="customer-tracking-order">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    orderNumber = activeOrder.OrderNumber,
    status = activeOrder.Status.ToString(),
    preferredPickupDate = activeOrder.PreferredPickupDate.ToString("yyyy-MM-dd"),
    preferredPickupTime = activeOrder.PreferredPickupTime,
    pickupRider = activeOrder.PickupRider != null ? new { name = activeOrder.PickupRider.FullName, phone = activeOrder.PickupRider.PhoneNumber } : null,
    weightKg = activeOrder.WeightKg,
    totalAmount = activeOrder.TotalAmount,
    weightPhotoPath = activeOrder.WeightPhotoPath,
    requiresWashing = activeOrder.OrderServices.Any(os => os.Service == null || os.Service.RequiresWashing),
    requiresDrying = activeOrder.OrderServices.Any(os => os.Service == null || os.Service.RequiresDrying),
    selectedServices = activeOrder.OrderServices.Select(os => os.Service != null ? os.Service.Name : "?").ToList(),
    deliveryRider = activeOrder.DeliveryRider != null ? new { name = activeOrder.DeliveryRider.FullName, phone = activeOrder.DeliveryRider.PhoneNumber } : null,
    deliveredAt = JsonUtc(activeOrder.DeliveredAt),
    deliveryPhotoPath = activeOrder.DeliveryPhotoPath
}))
                            </script>
                            <div data-timeline-surface="journey" data-timeline-orders="customer-tracking-order" data-timeline-index="0" aria-label="Order tracking timeline"></div>
                        </div>
                    </div>
                }
            </div>

            <!-- ==========================================================================
                 PANEL 5: PAYMENT
                 ========================================================================== -->
            <div id="panel-payment" class="content-panel @(activeTab == "payment" ? "active" : "")">
                <div class="page-heading-group">
                    <h1>Payment Center</h1>
                    <p>Review invoices, pay securely via PayMongo (GCash, Maya, Debit/Credit Cards), and view receipts.</p>
                </div>

                <div class="stat-cards-grid" style="margin-bottom: 20px;">
                    <div class="stat-card">
                        <div class="stat-card-icon blue">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        </div>
                        <div class="stat-card-data">
                            <span class="stat-card-value">₱@Model.OutstandingBalance.ToString("N2")</span>
                            <span class="stat-card-label">Outstanding Balance</span>
                        </div>
                    </div>
                    @{
                        var awaitingWeighCount = Model.Orders.Count(o => !o.IsPaymentConfirmed && !o.TotalAmount.HasValue && o.Status != LaundryHub2._0.Models.OrderStatus.Cancelled && !o.IsAbandoned);
                    }
                    @if (awaitingWeighCount > 0)
                    {
                        <div class="stat-card">
                            <div class="stat-card-icon yellow">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            </div>
                            <div class="stat-card-data">
                                <span class="stat-card-value">@awaitingWeighCount awaiting</span>
                                <span class="stat-card-label">Orders awaiting shop weighing — amounts appear after weighing, nothing to pay yet</span>
                            </div>
                        </div>
                    }
                </div>

                @{
                    var unpaidOrders = Model.Orders.Where(o => !o.IsPaymentConfirmed && o.TotalAmount.HasValue && o.Status != LaundryHub2._0.Models.OrderStatus.Cancelled && !o.IsAbandoned).ToList();
                    var abandonedOrders = Model.Orders.Where(o => o.IsAbandoned).ToList();
                    var paidOrders = Model.Orders.Where(o => o.IsPaymentConfirmed).ToList();
                }

                @if (abandonedOrders.Any())
                {
                    <div class="alert-banner alert-danger" style="margin-bottom: 20px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        <div>
                            <strong>Notice: You have @abandonedOrders.Count abandoned order(s).</strong> Orders remaining unpaid after 15 days past completion are deemed abandoned per section 5 of our Terms & Conditions.
                        </div>
                    </div>
                }

                <div class="content-card" style="margin-bottom: 24px;">
                    <div class="content-card-header">
                        <h3 class="content-card-title">Loyalty Points</h3>
                        <span class="tab-badge">@Model.LoyaltyBalance pts</span>
                    </div>
                    <div class="content-card-body">
                        <p style="font-size: 0.85rem; color: var(--lh-text-muted); margin: 0 0 12px;">
                            Earn 1 point for every ₱10 paid. Redeem 100 points for ₱10 off a payable order. Earned points expire after 12 months.
                        </p>
                        @if (Model.LoyaltyLedger.Count == 0)
                        {
                            <p style="color: var(--lh-text-muted); font-size: 0.85rem; margin: 0;">No loyalty activity yet — points are earned when a delivery completes.</p>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="loyalty-ledger-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Points</th>
                                        <th>Reason</th>
                                        <th>Expires</th>
                                    </tr>
                                </thead>
                                <tbody id="loyalty-ledger-body">
                                    @foreach (var entry in Model.LoyaltyLedger)
                                    {
                                        <tr>
                                            <td style="font-size: 0.8125rem; white-space: nowrap;">@ManilaTime(entry.CreatedAt).ToString("MMM dd, yyyy")</td>
                                            <td style="font-size: 0.8125rem;">@entry.Type</td>
                                            <td style="font-weight: 700; color: @(entry.Points >= 0 ? "#059669" : "#DC2626");">@(entry.Points >= 0 ? "+" : "")@entry.Points</td>
                                            <td style="font-size: 0.8125rem;">@entry.Reason</td>
                                            <td style="font-size: 0.8125rem;">@(entry.ExpiresAt.HasValue ? ManilaTime(entry.ExpiresAt.Value).ToString("MMM dd, yyyy") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="loyalty-ledger-pagination" aria-label="Loyalty ledger pagination"></div>
                        }
                    </div>
                </div>

                <div class="content-card" style="margin-bottom: 24px;">
                    <div class="content-card-header">
                        <h3 class="content-card-title">Pending Payment</h3>
                        <span class="tab-badge">@unpaidOrders.Count Due</span>
                    </div>
                    <div class="content-card-body" style="padding: 0;">
                        @if (unpaidOrders.Count == 0)
                        {
                            @if (awaitingWeighCount > 0)
                            {
                                <p style="padding: 30px; text-align: center; color: var(--lh-text-muted);">
                                    No bills due right now — @awaitingWeighCount order(s) still awaiting shop weighing. Amounts appear here after weighing.
                                </p>
                            }
                            else
                            {
                                <p style="padding: 30px; text-align: center; color: var(--lh-text-muted);">
                                    All your laundry bills are paid in full! No balance due.
                                </p>
                            }
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="unpaid-orders-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Services</th>
                                        <th>Base Amount</th>
                                        <th>Payment Deadline / Status</th>
                                        <th>Late Penalty</th>
                                        <th>Total Due</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="unpaid-orders-body">
                                    @foreach (var ord in unpaidOrders)
                                    {
                                        var penalty = ord.AccruedPenaltyAmount ?? 0m;
                                        var totalDue = (ord.TotalAmount ?? 0m) + penalty;
                                        var loyaltyDiscount = Model.LoyaltyDiscounts.TryGetValue(ord.Id, out var disc) ? disc : 0m;
                                        var netDue = totalDue - loyaltyDiscount;
                                        var isOverdue = penalty > 0m;
                                        
                                        string deadlineText = "Awaiting shop notification";
                                        var deadline = ord.PaymentDeadlineAt ?? (ord.ReadyForDeliveryNotifiedAt.HasValue ? ord.ReadyForDeliveryNotifiedAt.Value.AddHours(24) : (DateTime?)null);
                                        if (deadline.HasValue)
                                        {
                                            var graceEnd = ord.GracePeriodEndAt ?? deadline.Value.AddHours(72);
                                            var now = DateTime.UtcNow;
                                            if (now > graceEnd)
                                            {
                                                var overdueDays = Math.Floor((now - graceEnd).TotalDays);
                                                deadlineText = $"Overdue by {(overdueDays > 0 ? (int)overdueDays + "d" : "hours")}";
                                            }
                                            else if (now > deadline.Value)
                                            {
                                                var graceHoursLeft = Math.Ceiling((graceEnd - now).TotalHours);
                                                deadlineText = $"Grace period (~{(int)graceHoursLeft}h left)";
                                            }
                                            else
                                            {
                                                var hoursLeft = Math.Ceiling((deadline.Value - now).TotalHours);
                                                deadlineText = $"Due in ~{(int)hoursLeft} hrs";
                                            }
                                        }

                                        <tr>
                                            <td style="font-weight: 700;">@ord.OrderNumber</td>
                                            <td>@string.Join(", ", ord.OrderServices.Select(s => s.Service.Name))</td>
                                            <td>₱@(ord.TotalAmount?.ToString("N2"))</td>
                                            <td>
                                                @if (isOverdue)
                                                {
                                                    <span class="status-pill" style="background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;">
                                                        ⚠️ @deadlineText
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill" style="background:#FEF3C7;color:#92400E;border:1px solid #FDE68A;">
                                                        ⏳ @deadlineText
                                                    </span>
                                                }
                                            </td>
                                            <td style="font-weight: 600; color: @(penalty > 0 ? "#DC2626" : "var(--lh-text-muted)");">
                                                @(penalty > 0 ? $"₱{penalty:N2} (3%/day)" : "₱0.00")
                                            </td>
                                            <td style="font-weight: 800; color: var(--lh-blue-600); font-size: 1rem;">
                                                ₱@netDue.ToString("N2")
                                                @if (loyaltyDiscount > 0m)
                                                {
                                                    <div style="font-size: 0.75rem; font-weight: 600; color: #059669;">includes −₱@loyaltyDiscount.ToString("N2") loyalty</div>
                                                }
                                            </td>
                                            <td>
                                                <form asp-controller="Customer" asp-action="PayOrder" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@ord.Id" />
                                                    <button type="submit" class="quick-book-btn" style="padding: 6px 14px; font-size: 0.8125rem;">
                                                        Pay with PayMongo
                                                    </button>
                                                </form>
                                                @if (loyaltyDiscount > 0m)
                                                {
                                                    <div style="font-size: 0.75rem; font-weight: 700; color: #059669; margin-top: 8px;">✓ ₱@loyaltyDiscount.ToString("N2") loyalty already applied</div>
                                                }
                                                else if (Model.LoyaltyBalance >= 100)
                                                {
                                                    <form asp-controller="Customer" asp-action="RedeemPoints" method="post" style="display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="OrderId" value="@ord.Id" />
                                                        <label class="form-label" for="redeem-@ord.Id" style="width: 100%;">Redeem points (100 pts = ₱10 off)</label>
                                                        <input type="number" id="redeem-@ord.Id" name="Points" class="form-control" style="width: 90px; min-height: 44px; padding: 6px 8px; font-size: 0.8125rem;" min="100" step="100" max="@Model.LoyaltyBalance" value="100" />
                                                        <button type="submit" class="history-tab-btn">Redeem</button>
                                                        <span style="font-size: 0.75rem; color: var(--lh-text-muted); width: 100%;">You have @Model.LoyaltyBalance pts · earn 1 pt per ₱10 paid · multiples of 100.</span>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div style="font-size: 0.75rem; color: var(--lh-text-muted); margin-top: 8px;">Earn 1 pt per ₱10 paid — 100 pts unlocks ₱10 off.</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="unpaid-orders-pagination" aria-label="Unpaid orders pagination"></div>
                        }
                    </div>
                </div>

                <!-- Payment History / Receipts -->
                <div class="content-card">
                    <div class="content-card-header">
                        <h3 class="content-card-title">Payment History & Receipts</h3>
                    </div>
                    <div class="content-card-body" style="padding: 0;">
                        @if (paidOrders.Count == 0)
                        {
                            <p style="padding: 30px; text-align: center; color: var(--lh-text-muted);">No payment history yet.</p>
                        }
                        else
                        {
                                                        <div class="table-scroll">
<table class="order-table" id="paid-orders-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Payment Reference</th>
                                        <th>Date Paid</th>
                                        <th>Base</th>
                                        <th>Penalty</th>
                                        <th>Discount</th>
                                        <th>Net Paid</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="paid-orders-body">
                                    @foreach (var ord in paidOrders)
                                    {
                                        var rBase = ord.TotalAmount ?? 0m;
                                        var rPenalty = ord.AccruedPenaltyAmount ?? 0m;
                                        var rDiscount = Model.LoyaltyDiscounts.TryGetValue(ord.Id, out var rd) ? rd : 0m;
                                        var rNet = Math.Max(0m, rBase + rPenalty - rDiscount);
                                        <tr>
                                            <td style="font-weight: 700;">@ord.OrderNumber</td>
                                            <td style="font-family: monospace; font-size: 0.8125rem; color: var(--lh-text-muted);">
                                                @(ord.PayMongoPaymentId ?? "Manual record: no gateway reference")
                                            </td>
                                            <td>@(ord.PaymentConfirmedAt.HasValue ? ManilaTime(ord.PaymentConfirmedAt.Value).ToString("MMM dd, yyyy hh:mm tt") : ManilaTime(ord.CreatedAt).ToString("MMM dd, yyyy"))</td>
                                            <td>₱@rBase.ToString("N2")</td>
                                            <td>₱@rPenalty.ToString("N2")</td>
                                            <td style="color: #059669;">−₱@rDiscount.ToString("N2")</td>
                                            <td style="font-weight: 700; color: #065F46;">₱@rNet.ToString("N2")</td>
                                            <td><span class="status-pill status-delivered">Paid (Confirmed)</span><div style="margin-top:6px;"><a href="@Url.Action("Receipt", "Customer", new { id = ord.Id })" style="color:var(--lh-blue-600);font-size:0.75rem;font-weight:700;">View Receipt</a></div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <div id="paid-orders-pagination" aria-label="Paid orders pagination"></div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Shared order timeline (stage derivation + renderer) -->
    <script src="~/js/order-timeline.js"></script>
    <script src="~/js/simple-pager.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.SimplePager) {
                SimplePager.paginate('history-pending-body', 'history-pending-pagination', 10);
                SimplePager.paginate('history-ongoing-body', 'history-ongoing-pagination', 10);
                SimplePager.paginate('history-completed-body', 'history-completed-pagination', 10);
                SimplePager.paginate('loyalty-ledger-body', 'loyalty-ledger-pagination', 10);
                SimplePager.paginate('unpaid-orders-body', 'unpaid-orders-pagination', 10);
                SimplePager.paginate('paid-orders-body', 'paid-orders-pagination', 10);
            }
        });
    </script>

    <!-- MapLibre GL JS for Customer Map Picker (Phase 2D) -->
    <script src="~/lib/maplibre-gl/maplibre-gl.js"></script>
    <script>
        // Map Settings injected from server configuration
        const MAP_CONFIG = {
            tileUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapSettings.TileUrl)),
            attribution: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapSettings.Attribution)),
            initialLat: @mapSettings.InitialLatitude,
            initialLng: @mapSettings.InitialLongitude,
            initialZoom: @mapSettings.InitialZoom
        };

        let pickupMap = null;
        let pickupMarker = null;

        function updateCoordinatesDisplay(lat, lng) {
            const latInput = document.getElementById('pickupLatitude');
            const lngInput = document.getElementById('pickupLongitude');
            const coordsText = document.getElementById('coordsDisplayValues');

            if (latInput) latInput.value = lat.toFixed(8);
            if (lngInput) lngInput.value = lng.toFixed(8);
            if (coordsText) coordsText.textContent = lat.toFixed(5) + ', ' + lng.toFixed(5);
        }

        function initCustomerPickupMap() {
            const mapContainer = document.getElementById('pickupMap');
            if (!mapContainer || pickupMap) return;

            const latInput = document.getElementById('pickupLatitude');
            const lngInput = document.getElementById('pickupLongitude');

            const initLat = latInput && latInput.value ? parseFloat(latInput.value) : MAP_CONFIG.initialLat;
            const initLng = lngInput && lngInput.value ? parseFloat(lngInput.value) : MAP_CONFIG.initialLng;

            try {
                pickupMap = new maplibregl.Map({
                    container: 'pickupMap',
                    style: {
                        version: 8,
                        sources: {
                            'osm-tiles': {
                                type: 'raster',
                                tiles: [MAP_CONFIG.tileUrl],
                                tileSize: 256,
                                attribution: MAP_CONFIG.attribution
                            }
                        },
                        layers: [
                            {
                                id: 'osm-tiles-layer',
                                type: 'raster',
                                source: 'osm-tiles',
                                minzoom: 0,
                                maxzoom: 19
                            }
                        ]
                    },
                    center: [initLng, initLat],
                    zoom: MAP_CONFIG.initialZoom
                });

                pickupMap.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

                // Add draggable pickup marker
                pickupMarker = new maplibregl.Marker({
                    draggable: true,
                    color: '#2563EB'
                })
                .setLngLat([initLng, initLat])
                .addTo(pickupMap);

                // Update coordinates when marker dragged
                pickupMarker.on('dragend', function() {
                    const lngLat = pickupMarker.getLngLat();
                    updateCoordinatesDisplay(lngLat.lat, lngLat.lng);
                    const msgEl = document.getElementById('mapLocationMsg');
                    if (msgEl) msgEl.textContent = 'Pin adjusted';
                });

                // Update coordinates when map clicked
                pickupMap.on('click', function(e) {
                    pickupMarker.setLngLat([e.lngLat.lng, e.lngLat.lat]);
                    updateCoordinatesDisplay(e.lngLat.lat, e.lngLat.lng);
                    const msgEl = document.getElementById('mapLocationMsg');
                    if (msgEl) msgEl.textContent = 'Pin adjusted';
                });

                updateCoordinatesDisplay(initLat, initLng);
            } catch (err) {
                console.error('Failed to initialize pickup map:', err);
                const msgEl = document.getElementById('mapLocationMsg');
                if (msgEl) msgEl.textContent = 'Map preview could not be loaded.';
            }
        }

        function useCurrentCustomerLocation() {
            const btn = document.getElementById('btnUseCurrentLocation');
            const msgEl = document.getElementById('mapLocationMsg');

            if (!navigator.geolocation) {
                if (msgEl) msgEl.textContent = 'Geolocation is not supported by your browser.';
                return;
            }

            if (btn) btn.disabled = true;
            if (msgEl) msgEl.textContent = 'Locating...';

            navigator.geolocation.getCurrentPosition(
                function(pos) {
                    if (btn) btn.disabled = false;
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;

                    if (pickupMap && pickupMarker) {
                        pickupMap.flyTo({ center: [lng, lat], zoom: 16 });
                        pickupMarker.setLngLat([lng, lat]);
                    }
                    updateCoordinatesDisplay(lat, lng);
                    if (msgEl) msgEl.textContent = 'Location detected ✓';
                },
                function(err) {
                    if (btn) btn.disabled = false;
                    let errText = 'Could not get device location.';
                    if (err.code === 1) errText = 'Location permission was denied. You can manually drag the pin.';
                    else if (err.code === 2) errText = 'Position unavailable. Please drag the pin manually.';
                    else if (err.code === 3) errText = 'Location request timed out. Please drag the pin manually.';
                    if (msgEl) msgEl.textContent = errText;
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 5000
                }
            );
        }
    </script>

    <!-- SignalR Client for Phase 2E Live Rider Tracking -->
    <script src="~/lib/signalr.min.js"></script>

    <!-- Tab Switching Script -->
    <script>
        function switchTab(tabId, orderId) {
            // Hide all panels
            document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('active'));
            // Remove active from nav items
            document.querySelectorAll('.sidebar-nav-item').forEach(b => b.classList.remove('active'));

            const targetPanel = document.getElementById('panel-' + tabId);
            if (targetPanel) {
                targetPanel.classList.add('active');
                if (tabId === 'book') {
                    if (!pickupMap) {
                        initCustomerPickupMap();
                    } else {
                        setTimeout(() => pickupMap && pickupMap.resize(), 100);
                    }
                }
                if (tabId === 'tracking') {
                    // Resize live tracking map if already initialized
                    setTimeout(() => customerTrackingMap && customerTrackingMap.resize(), 100);
                } else {
                    // Leaving tracking tab: stop live tracking
                    stopCustomerTracking();
                }
            }

            // Highlight corresponding sidebar item
            const navButtons = document.querySelectorAll('.sidebar-nav-item');
            navButtons.forEach(btn => {
                if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(tabId)) {
                    btn.classList.add('active');
                }
            });

            // Update URL without refresh — preserve book-tab intent and estimate params.
            const url = new URL(window.location);
            url.searchParams.set('tab', tabId);
            if (orderId) {
                url.searchParams.set('order', orderId);
            } else if (tabId !== 'tracking') {
                url.searchParams.delete('order');
            }
            window.history.pushState({}, '', url);
        }

        // Deep link to one order's timeline. Full reload so the server renders
        // exactly that order — Track never shows order A's timeline for order B.
        // Also stop any active tracking before navigating.
        function trackOrder(orderId) {
            stopCustomerTracking();
            const url = new URL(window.location);
            url.searchParams.set('tab', 'tracking');
            url.searchParams.set('order', orderId);
            window.location.href = url.toString();
        }

        function isSundayDate(value) {
            if (!value) return false;
            const parts = value.split('-');
            if (parts.length !== 3) return false;
            const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            return d.getDay() === 0;
        }

        function validatePickupForm() {
            const dateEl = document.getElementById('pickupDateInput');
            const errEl = document.getElementById('err-pickup-date');
            if (errEl) errEl.textContent = '';
            if (dateEl && isSundayDate(dateEl.value)) {
                if (errEl) errEl.textContent = 'Pickups run Monday to Saturday only — the shop is closed on Sundays. Please choose another date.';
                return false;
            }
            return true;
        }

        function updateBookingEstimate() {
            const box = document.getElementById('bookingEstimate');
            const weightEl = document.getElementById('estimateWeightKg');
            if (!box || !weightEl) return;
            const checked = Array.from(document.querySelectorAll('input[name="SelectedServiceIds"]:checked'));
            const weight = parseFloat(weightEl.value);
            if (!checked.length || isNaN(weight) || weight <= 0) {
                box.textContent = 'Select services and enter an estimated weight to see an estimate.';
                return;
            }
            const lines = [];
            let subtotal = 0;
            checked.forEach(cb => {
                const rate = parseFloat(cb.getAttribute('data-rate') || '0');
                const line = rate * weight;
                subtotal += line;
                lines.push((cb.getAttribute('data-name') || 'Service') + ': ₱' + rate.toFixed(2) + '/kg × ' + weight + ' kg = ₱' + line.toFixed(2));
            });
            const fee = weight < 5 ? 50 : 0;
            const total = subtotal + fee;
            let html = lines.map(l => '<div>' + l + '</div>').join('');
            html += '<div style="margin-top:6px;">Subtotal: <strong>₱' + subtotal.toFixed(2) + '</strong></div>';
            html += '<div>Delivery fee: <strong>' + (fee > 0 ? '₱50.00 (under 5 kg)' : 'FREE (5 kg+)') + '</strong></div>';
            html += '<div style="margin-top:4px;font-weight:800;color:var(--lh-text-headings);">Estimated total: ₱' + total.toFixed(2) + '</div>';
            if (weight < 3) html += '<div style="color:#DC2626;font-weight:600;">Below the 3 kg minimum per pickup.</div>';
            html += '<div style="font-size:0.75rem;color:var(--lh-text-muted);">Advisory only — final bill follows in-shop scale weighing.</div>';
            box.innerHTML = html;
        }

        function prefillBookingFromQuery() {
            try {
                const params = new URLSearchParams(window.location.search);
                const services = (params.get('services') || '').split(',').map(s => s.trim()).filter(Boolean);
                if (services.length) {
                    document.querySelectorAll('input[name="SelectedServiceIds"]').forEach(cb => {
                        cb.checked = services.includes(cb.value);
                    });
                }
                const weight = params.get('weight');
                const weightEl = document.getElementById('estimateWeightKg');
                if (weight && weightEl && !isNaN(parseFloat(weight))) weightEl.value = weight;
            } catch (e) { /* query prefill is best-effort */ }
            updateBookingEstimate();
        }

        document.addEventListener('DOMContentLoaded', function () {
            OrderTimeline.mountAll();
            document.querySelectorAll('input[name="SelectedServiceIds"]').forEach(cb => {
                cb.addEventListener('change', updateBookingEstimate);
            });
            const weightEl = document.getElementById('estimateWeightKg');
            if (weightEl) weightEl.addEventListener('input', updateBookingEstimate);
            const dateEl = document.getElementById('pickupDateInput');
            if (dateEl) dateEl.addEventListener('change', function () {
                const errEl = document.getElementById('err-pickup-date');
                if (errEl) errEl.textContent = isSundayDate(dateEl.value) ? 'Pickups run Monday to Saturday only — the shop is closed on Sundays.' : '';
            });
            prefillBookingFromQuery();

            // Initialize MapLibre pickup picker
            initCustomerPickupMap();

            // Phase 2E: Initialize live tracking if tracking tab is active
            if (document.getElementById('panel-tracking') && document.getElementById('panel-tracking').classList.contains('active')) {
                initCustomerLiveTracking();
            }
        });

        function filterHistoryTab(subtab, btn) {
            document.querySelectorAll('.history-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content-section').forEach(s => s.classList.remove('active'));

            btn.classList.add('active');
            const target = document.getElementById('history-tab-' + subtab);
            if (target) {
                target.classList.add('active');
            }
        }

        async function submitSelfClaim(orderId) {
            const errEl = document.getElementById('err-selfclaim-' + orderId);
            const okEl = document.getElementById('ok-selfclaim-' + orderId);
            const typeEl = document.getElementById('selfclaim-type-' + orderId);
            const descEl = document.getElementById('selfclaim-desc-' + orderId);
            const formEl = document.getElementById('selfclaim-form-' + orderId);
            if (!errEl || !typeEl || !descEl || !formEl) return;
            errEl.textContent = '';
            if (okEl) okEl.textContent = '';
            const desc = (descEl.value || '').trim();
            if (!desc) { errEl.textContent = 'Please describe what happened.'; return; }
            const tokenEl = formEl.querySelector('input[name="__RequestVerificationToken"]');
            const body = new URLSearchParams({ OrderId: String(orderId), Type: typeEl.value, Description: desc, __RequestVerificationToken: tokenEl ? tokenEl.value : '' });
            let data = null;
            try {
                const res = await fetch('/Customer/FileClaim', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: body.toString() });
                data = await res.json();
            } catch (e) { errEl.textContent = 'Could not file the claim. Please try again.'; return; }
            if (!data || !data.success) { errEl.textContent = (data && data.message) || 'Filing failed.'; return; }
            if (okEl) okEl.textContent = data.message;
            descEl.value = '';
        }
    </script>

    <!-- Phase 2E: Customer Live Rider Tracking Controller -->
    <script>
        (function () {
            // ── State ────────────────────────────────────────────────────────────
            let customerTrackingMap = null;
            let customerMarker = null;
            let riderMarker = null;
            let trackingConnection = null;
            let isTrackingActive = false;
            let trackingOrderId = 0;

            // Expose to outer scope for switchTab
            window.customerTrackingMap = null;
            window.stopCustomerTracking = stopTracking;
            window.initCustomerLiveTracking = initTracking;

            // ── Bootstrap ────────────────────────────────────────────────────────
            function initTracking() {
                const container = document.getElementById('trackingMapContainer');
                if (!container) return;

                const isEligible = container.dataset.isEligible === 'true';
                if (!isEligible) {
                    setStatus('none', 'Live tracking is not available for this order status.');
                    setStatusMsg('Live tracking is only active when a rider is en-route to you.');
                    return;
                }

                trackingOrderId = parseInt(container.dataset.orderId, 10);
                const customerLatStr = container.dataset.customerLat;
                const customerLngStr = container.dataset.customerLng;
                const customerLat = customerLatStr ? parseFloat(customerLatStr) : MAP_CONFIG.initialLat;
                const customerLng = customerLngStr ? parseFloat(customerLngStr) : MAP_CONFIG.initialLng;
                const trackingType = container.dataset.trackingType;

                buildMap(customerLat, customerLng, trackingType);
                connectSignalR(trackingOrderId, customerLat, customerLng);
            }

            // ── MapLibre Map ─────────────────────────────────────────────────────
            function buildMap(customerLat, customerLng, trackingType) {
                const mapEl = document.getElementById('customerTrackingMap');
                if (!mapEl || customerTrackingMap) return;

                customerTrackingMap = new maplibregl.Map({
                    container: 'customerTrackingMap',
                    style: {
                        version: 8,
                        sources: {
                            'osm': {
                                type: 'raster',
                                tiles: [MAP_CONFIG.tileUrl],
                                tileSize: 256,
                                attribution: MAP_CONFIG.attribution
                            }
                        },
                        layers: [{
                            id: 'osm-layer',
                            type: 'raster',
                            source: 'osm',
                            minzoom: 0,
                            maxzoom: 19
                        }]
                    },
                    center: [customerLng, customerLat],
                    zoom: 15
                });

                // Expose so switchTab can call .resize()
                window.customerTrackingMap = customerTrackingMap;

                customerTrackingMap.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

                // Customer (pickup location) marker — blue
                const customerEl = document.createElement('div');
                customerEl.className = 'customer-map-marker';
                customerEl.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
                customerEl.title = trackingType === 'delivery' ? 'Delivery Address' : 'Pickup Address';

                customerMarker = new maplibregl.Marker({ element: customerEl })
                    .setLngLat([customerLng, customerLat])
                    .setPopup(new maplibregl.Popup({ offset: 24 }).setText(
                        trackingType === 'delivery' ? 'Your delivery address' : 'Your pickup location'
                    ))
                    .addTo(customerTrackingMap);
            }

            // ── SignalR ──────────────────────────────────────────────────────────
            async function connectSignalR(orderId, customerLat, customerLng) {
                if (trackingConnection) return;

                try {
                    trackingConnection = new signalR.HubConnectionBuilder()
                        .withUrl('/orderHub')
                        .withAutomaticReconnect([2000, 5000, 10000, 30000])
                        .configureLogging(signalR.LogLevel.Warning)
                        .build();

                    trackingConnection.on('RiderLocationUpdated', function (payload) {
                        if (!payload || payload.orderId !== orderId) return;
                        updateRiderMarker(payload.latitude, payload.longitude, payload.updatedAt);
                    });

                    trackingConnection.onreconnecting(function () {
                        setStatus('reconnecting', 'Reconnecting...');
                        setStatusMsg('Connection lost — attempting to reconnect...');
                    });

                    trackingConnection.onreconnected(function () {
                        setStatus('waiting', 'Reconnected');
                        setStatusMsg('Reconnected — waiting for rider location...');
                        fetchInitialLocation(orderId, customerLat, customerLng);
                    });

                    trackingConnection.onclose(function () {
                        setStatus('reconnecting', 'Disconnected');
                        setStatusMsg('Connection closed. Reload the page to resume tracking.');
                    });

                    await trackingConnection.start();
                    isTrackingActive = true;

                    const joined = await trackingConnection.invoke('JoinOrderGroup', orderId);
                    if (!joined) {
                        setStatus('none', 'Not authorized');
                        setStatusMsg('Could not join tracking group for this order.');
                        return;
                    }

                    setStatus('waiting', 'Waiting for rider...');
                    setStatusMsg('Connected. Waiting for rider GPS signal...');

                    // Fetch initial location in case rider already has coordinates
                    await fetchInitialLocation(orderId, customerLat, customerLng);

                } catch (err) {
                    console.error('[LiveTracking] SignalR error:', err);
                    setStatus('reconnecting', 'Connection failed');
                    setStatusMsg('Could not connect to the tracking server. Please refresh.');
                }
            }

            async function fetchInitialLocation(orderId, customerLat, customerLng) {
                try {
                    const res = await fetch('/Customer/GetRiderLocation?orderId=' + orderId, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data && data.isTrackingActive && data.hasLocation) {
                        updateRiderMarker(data.latitude, data.longitude, data.updatedAt, data.isStale);
                    } else if (data && !data.isTrackingActive) {
                        setStatus('none', 'Tracking ended');
                        setStatusMsg(data.message || 'This order is no longer in an active tracking window.');
                    }
                } catch (err) {
                    // Best-effort; SignalR will push updates anyway
                }
            }

            // ── Rider Marker ─────────────────────────────────────────────────────
            function updateRiderMarker(lat, lng, updatedAtIso, forceStale) {
                if (!customerTrackingMap) return;

                const isStale = forceStale != null
                    ? forceStale
                    : (updatedAtIso ? (Date.now() - new Date(updatedAtIso).getTime()) > 120000 : false);

                if (!riderMarker) {
                    const riderEl = document.createElement('div');
                    riderEl.className = 'rider-map-marker';
                    riderEl.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v5"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="19" r="2"/><polyline points="17 12 13 12 13 8"/></svg>';
                    riderEl.title = 'Your assigned rider';

                    riderMarker = new maplibregl.Marker({ element: riderEl })
                        .setLngLat([lng, lat])
                        .setPopup(new maplibregl.Popup({ offset: 26 }).setText('Your rider'))
                        .addTo(customerTrackingMap);
                } else {
                    riderMarker.setLngLat([lng, lat]);
                }

                if (isStale) {
                    setStatus('stale', 'Signal stale');
                    setStatusMsg('Last known rider location (signal stale — over 2 minutes old).');
                } else {
                    setStatus('live', 'Live');
                    const d = updatedAtIso ? new Date(updatedAtIso) : new Date();
                    setStatusMsg('Rider location live · Updated ' + formatTime(d));
                }

                // Fit map bounds to show both markers
                const bounds = new maplibregl.LngLatBounds();
                if (customerMarker) bounds.extend(customerMarker.getLngLat());
                bounds.extend([lng, lat]);
                if (!bounds.isEmpty()) {
                    customerTrackingMap.fitBounds(bounds, { padding: 80, maxZoom: 17, duration: 600 });
                }
            }

            // ── Status helpers ────────────────────────────────────────────────────
            function setStatus(type, label) {
                const pill = document.getElementById('liveTrackingPill');
                const text = document.getElementById('liveTrackingPillText');
                if (!pill || !text) return;
                pill.className = 'live-indicator-pill';
                if (type === 'live') pill.classList.add('is-live');
                else if (type === 'stale') pill.classList.add('is-stale');
                else if (type === 'waiting') pill.classList.add('is-waiting');
                else if (type === 'reconnecting') pill.classList.add('is-reconnecting');
                text.textContent = label;
            }

            function setStatusMsg(msg) {
                const el = document.getElementById('liveTrackingStatusMsg');
                if (el) el.textContent = msg;
            }

            function formatTime(d) {
                if (!d || !(d instanceof Date) || isNaN(d.getTime())) return '';
                return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }

            // ── Cleanup ───────────────────────────────────────────────────────────
            function stopTracking() {
                if (trackingConnection) {
                    try {
                        trackingConnection.invoke('LeaveOrderGroup', trackingOrderId).catch(() => {});
                        trackingConnection.stop().catch(() => {});
                    } catch (_) {}
                    trackingConnection = null;
                }
                isTrackingActive = false;
            }

            window.addEventListener('beforeunload', stopTracking);
        })();
    </script>

    <script>
        /* Shared responsive contract: reveals condensed columns (<=1024px / <=640px) per row. */
        (function () {
            var CHEVRON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>';

            function enhanceTable(table) {
                if (!table.tHead || !table.tHead.rows[0] || !table.tBodies[0]) return;
                if (table.tHead.rows[0].cells.length < 4) return;
                var rows = Array.prototype.slice.call(table.tBodies[0].rows);
                rows.forEach(function (row) {
                    if (row.querySelector('.row-toggle')) return;
                    var cell = row.cells[0];
                    if (!cell) return;
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'row-toggle';
                    btn.setAttribute('aria-expanded', 'false');
                    btn.setAttribute('aria-label', 'Show all columns for this row');
                    btn.innerHTML = CHEVRON;
                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        var open = row.classList.toggle('row-expanded');
                        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    });
                    cell.insertBefore(btn, cell.firstChild);
                });
            }

            function enhance() {
                var tables = document.querySelectorAll('.table-scroll table');
                Array.prototype.forEach.call(tables, enhanceTable);
            }

            window.lhEnhanceResponsiveTables = enhance;

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', enhance);
            } else {
                enhance();
            }

            /* Covers server- and JS-rendered rows (tabs, modals, async panels). */
            if (window.MutationObserver) {
                new MutationObserver(function () { enhance(); }).observe(document.body, { childList: true, subtree: true });
            }
        })();
    </script>
