{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PayMongo": {
    // No keys are stored here. Configure them per-machine via user-secrets
    // ('dotnet user-secrets set "PayMongo:SecretKey" "<key>"') or via the
    // PayMongo__SecretKey environment variable. The PayMongo public key is
    // intentionally not used anywhere: checkout sessions are server-side only.
  }
}
